;; T(name, src, exp) loads 'src' (an Atmos chunk), runs it as the body
;; of 'atmos.loop' with 'print' captured, and compares the output with
;; 'exp': a string (exact), TX (trimmed), P/TP (Lua pattern), F
;; (substring), E(pre, msg)/EP(pre, pattern) (an error must be raised
;; with that message after printing 'pre').

;; Harness for the tests converted from the reference implementation
;; (testes/ref/*.atm, generated by tools/tst2atm.py).

set R = []  ;; namespace of the harness (no other globals)

var total = 0
var fails = 0
var current = nil
var globals = nil  ;; the globals that exist before the cases run

;; the cases run with the global environment (as the reference's
;; 'atm_test'): new globals (a case's 'task T' is 'set T = ...') are
;; removed after each case, not to leak into other test files
val func cleanup () {
  loop k in pairs(_G) {
    if !globals@(k) { set _G@(k) = nil }
  }
}

func R.begin (name) {
  set X = atmos.X  ;; other test files clobber the global 'X'
  set current = name
  set total = 0
  set fails = 0
  set globals = []
  loop k in pairs(_G) { set globals@(k) = true }
  print("testing " ++ name)
}

func R.finish () {
  print(string.format("%d cases, %d failures", total, fails))
  assert(fails == 0, current ++ ": reference tests failed")
}

;; (global: reference sources call it)
func trim (s) {
  val a = string.gsub(s, "^%s*", "")
  val b = string.gsub(a, "\n%s*", "\n")
  val c = string.gsub(b, "%s*$", "")
  c
}

;; remove a 'chunk:line: ' position prefix from an error message
val func strip (m) {
  val s = tostring(m)
  val r = string.gsub(s, "^%[string \"[^\"]*\"%]:%d+: ", "")
  val r2 = string.gsub(r, "^[%w_%.%-]+:%d+: ", "")
  r2
}

func R.P (p) { :P [p] }
func R.TP (p) { :TP [p] }
func R.TX (s) { :TX [s] }
func R.F (s) { :F [s] }
func R.E (pre, msg) { :E [pre, msg] }
func R.EP (pre, pat) { :EP [pre, pat] }

func R.T (name, src, exp) {
  set total = total + 1
  var out = ""
  val realprint = print
  set print = \(...){
    val t = table.pack(...)
    loop i in (1, t.n) { set t@i = tostring(t@i) }
    set out = out ++ table.concat(t, "\t") ++ "\n"
  }
  var err = nil
  val f, m = load(src, name)
  if f {
    val ok, e = pcall(atmos.loop, f)  ;; a fresh root task, as the reference
    if !ok { set err = e }
  } else {
    set err = m
  }
  set print = realprint
  cleanup()
  var ok = false
  var want = exp
  ;; as the reference harness, an error is appended to the output
  val full = if err { out ++ "==> ERROR:\n==> " ++ strip(err) } else { out }
  ifs {
    type(exp) == "string" => { set ok = (full == exp) }
    exp ?? :TX => { set ok = (trim(full) == exp@1) }
    exp ?? :P => { set ok = (string.find(full, exp@1) != nil) }
    exp ?? :TP => { set ok = (string.find(trim(full), exp@1) != nil) }
    exp ?? :F => { set ok = (string.find(full, exp@1, 1, true) != nil) }
    exp ?? :E => {
      set ok = (err != nil) && (trim(out) == exp@1) && (strip(err) == exp@2)
      set want = exp@1 ++ " ==> " ++ exp@2
    }
    exp ?? :EP => {
      set ok = (err != nil) && (trim(out) == exp@1) && (string.find(strip(err), exp@2) != nil)
      set want = exp@1 ++ " ==> " ++ exp@2
    }
  }
  if !ok {
    set fails = fails + 1
    realprint("FAIL: " ++ name)
    realprint("  got: " ++ string.gsub(out, "\n", "\\n") ++ (if err { " ==> " ++ tostring(err) } else { "" }))
    val w = if want ?? :table { want@1 } else { want }
    realprint("  exp: " ++ string.gsub(tostring(w), "\n", "\\n"))
  }
}

