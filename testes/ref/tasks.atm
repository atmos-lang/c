R.T("tasks.lua:3514 tasks 21: pool limit: fail then pass", """
        var T = task (n) {
            set pub = n
            await((tostring(n)))
        }
        pin ts = tasks(2)
        spawn @ts T(1)
        spawn @ts T(2)
        loop _,t in ts {
            print(:t, t.pub)
            val ok1 = spawn @ts T(99)  ;; full: fails
            emit(:2)                    ;; kills T(2), not removed yet
            val ok2 = spawn @ts T(99)  ;; dead slot is free: passes
            print(ok1 != nil, ok2 != nil)
            break()                     ;; T(99) would be visited
        }
        loop _,t in ts {                ;; dead T(2) still in ts
            print(:t, t.pub)
        }
        atmos.gc()                      ;; removes dead T(2)
        loop _,t in ts {
            print(:t, t.pub)
        }
    """,
  """
t	1
false	true
t	1
t	2
t	99
t	1
t	99
""")
R.T("tasks.lua:3542 tasks 22: pool limit: pass then fail", """
        task T () {
            await(true)
        }
        pin ts = tasks(1)
        spawn @ts T()
        spawn {
            loop _ in ts {
                break()
            }
        }
        emit(:X)                    ;; kills T
        val ok1 = spawn @ts T()    ;; dead slot is free: passes
        val ok2 = spawn @ts T()    ;; full: fails
        print(ok1 != nil, ok2 != nil)
    """,
  """
true	false
""")
