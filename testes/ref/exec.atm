        spawn {
            val x = toggle on :Show {
                10
            }
            print(x)
        }
        print(:ok)
    """,
  """
10
ok
""")
R.T("exec.lua:2606 toggle filter", """
        val T = task () {
            spawn (task () {
                loop on :Draw { print(:draw) }
            }) ()
            loop on :Tick { print(:tick) }
        }
        pin t = spawn T()
        emit(:Draw)                 ;; on  -> draw
        emit(:Tick)                 ;; on  -> tick
        toggle t (false) with :Draw ;; off, but :Draw passes
        emit(:Draw)                 ;; passes filter -> draw
        emit(:Tick)                 ;; gated -> frozen
        toggle t (true)
        emit(:Tick)                 ;; on  -> tick
    """,
  """
draw
tick
draw
tick
""")
R.T("exec.lua:2627 toggle filter block", """
        spawn {
            toggle on :Show with :Draw {
                par {
                    loop on :Draw { print(:draw) }
                } with {
                    loop on :Tick { print(:tick) }
                }
            }
        }
        emit(:Draw)             ;; on  -> draw
        emit(:Tick)             ;; on  -> tick
        emit :Show [false]     ;; toggle off, filter :Draw
        emit(:Draw)             ;; passes filter -> draw
        emit(:Tick)             ;; gated -> frozen
        emit :Show [true]      ;; toggle on
        emit(:Tick)             ;; on  -> tick
    """,
  """
draw
tick
draw
tick
""")

;; ---- CALL / METHOD / PIPE

;; R.T("exec.lua:2653 is 1", "print(10 -> 10)",
;;   """
;; anon.atm : line 1 : ')' expected near '('
;; """)
R.T("exec.lua:2658 is 1", "print(10 -> (10))",
  R.E("", "attempt to call a number value"))
R.T("exec.lua:2668 method 1", """
        func f (v) { return(v) }
        val v = 10->f()
        print(v)
    """,
  """
10
""")
R.T("exec.lua:2677 method 2", """
        func f (v) { return(10) }
        func g (v) { return(v) }
        val v = 99->f()->g()
        print(v)
    """,
  """
10
""")
R.T("exec.lua:2687 method 3", """
        func f (v) { return(10) }
        func g (v) { return(v) }
        val v = 99->f->g
        print(v)
    """,
  """
10
""")
R.T("exec.lua:2697 method 4", """
        func f (v,x) { return(v - x) }
        val v = 10->f(20)
        print(v)
    """,
  """
-10
""")
R.T("exec.lua:2706 method 5", """
        func f (v) { return(v) }
        val v = f<-20
        print(v)
    """,
  """
20
""")
R.T("exec.lua:2715 method 6", """
        func f (v,x) { return(v - x) }
        val v = f(10)<-20
        print(v)
    """,
  """
-10
""")
R.T("exec.lua:2724 method 6", """
        func f (self,v) { self.v+v }
        val o = [v=10,f=f]
        print(o::f(20))
    """,
  """
30
""")
R.T("exec.lua:2733 call-call: 1", """
        func f (...) { print(...) ; f }
        f 'a' 'b'
    """,
  """
a
b
""")
R.T("exec.lua:2741 method 7", """
        func f (self, v) {
            print(v)
            self
        }
        val o = [f=f]
        print(o::f'v'::f\{})
    """,
  R.P("""
v
function: 0x.-
table: 0x.-"""))
R.T("exec.lua:2753 method 8", """
        func f (...) { print(...) }
        (10,20) --> f(30,40)
    """,
  """
10	20	30	40
""")

