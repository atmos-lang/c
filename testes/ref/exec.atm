;; ---- ESCAPE TCO

R.T("exec.lua:2871 escape TCO", """
        spawn {
            par :any {
                await (false)
            } with {
                do :X {
                    par :any {
                        await (false)
                    } with {
                        await :A
                        escape :X
                    }
                }
                print :1
            }
            print :2
        }
        emit :A
    """,
  """
1
2
""")

R.finish()
