;; ---- CALL / METHOD / PIPE

;; T("0:2653 is 1", "print(10 -> 10)",
;;   """
;; anon.atm : line 1 : ')' expected near '('
;; """)
T("0:2658 is 1", "print(10 -> (10))",
  E("", "attempt to call a number value"))
T("0:2668 method 1", """
        func f (v) { return(v) }
        val v = 10->f()
        print(v)
    """,
  """
10
""")
T("0:2677 method 2", """
        func f (v) { return(10) }
        func g (v) { return(v) }
        val v = 99->f()->g()
        print(v)
    """,
  """
10
""")
T("0:2687 method 3", """
        func f (v) { return(10) }
        func g (v) { return(v) }
        val v = 99->f->g
        print(v)
    """,
  """
10
""")
T("0:2697 method 4", """
        func f (v,x) { return(v - x) }
        val v = 10->f(20)
        print(v)
    """,
  """
-10
""")
T("0:2706 method 5", """
        func f (v) { return(v) }
        val v = f<-20
        print(v)
    """,
  """
20
""")
T("0:2715 method 6", """
        func f (v,x) { return(v - x) }
        val v = f(10)<-20
        print(v)
    """,
  """
-10
""")
T("0:2724 method 6", """
        func f (self,v) { self.v+v }
        val o = [v=10,f=f]
        print(o::f(20))
    """,
  """
30
""")
T("0:2733 call-call: 1", """
        func f (...) { print(...) ; f }
        f 'a' 'b'
    """,
  """
a
b
""")
T("0:2741 method 7", """
        func f (self, v) {
            print(v)
            self
        }
        val o = [f=f]
        print(o::f'v'::f\{})
    """,
  P("""
v
function: 0x.-
table: 0x.-"""))
T("0:2753 method 8", """
        func f (...) { print(...) }
        (10,20) --> f(30,40)
    """,
  """
10	20	30	40
""")

