do {
  print("testing floats in numeric for")
  var a
  ;; integer count
  set a = 0
  loop i in (1, 1, 1) {
    set a = a + 1
  }
  assert(a == 1)
  set a = 0
  loop i in (10000, 1e4, -1) {
    set a = a + 1
  }
  assert(a == 1)
  set a = 0
  loop i in (1, 0.99999, 1) {
    set a = a + 1
  }
  assert(a == 0)
  set a = 0
  loop i in (9999, 1e4, -1) {
    set a = a + 1
  }
  assert(a == 0)
  set a = 0
  loop i in (1, 0.99999, -1) {
    set a = a + 1
  }
  assert(a == 1)

  ;; float count
  set a = 0
  loop i in (0, 0.999999999, 0.1) {
    set a = a + 1
  }
  assert(a == 10)
  set a = 0
  loop i in (1.0, 1, 1) {
    set a = a + 1
  }
  assert(a == 1)
  set a = 0
  loop i in (-1.5, -1.5, 1) {
    set a = a + 1
  }
  assert(a == 1)
  set a = 0
  loop i in (1e6, 1e6, -1) {
    set a = a + 1
  }
  assert(a == 1)
  set a = 0
  loop i in (1.0, 0.99999, 1) {
    set a = a + 1
  }
  assert(a == 0)
  set a = 0
  loop i in (99999, 1e5, -1.0) {
    set a = a + 1
  }
  assert(a == 0)
  set a = 0
  loop i in (1.0, 0.99999, -1) {
    set a = a + 1
  }
  assert(a == 1)
}

do {
  print("testing NaN in numeric for")
  val NaN = 0 / 0

  loop i in (1, NaN, 1) {
    error("should not run the loop")
  }
  loop i in (1, NaN, -1) {
    error("should not run the loop")
  }
  loop i in (1.0, NaN) {
    error("should not run the loop")
  }
  loop i in (1.0, NaN, -1) {
    error("should not run the loop")
  }
  loop i in (NaN, 1) {
    error("should not run the loop")
  }
  loop i in (NaN, 1, -1) {
    error("should not run the loop")
  }

  ;; NaN is not negative, so the loop must be ascending
  ;; (that's somewhat arbitrary)
  loop i in (2, 1, NaN) {
    error("should not run the loop")
  }
  var s = 0
  loop i in (1, 5, NaN) {
    set s = s + 1
  }
  assert(s == 1)
}

do {  ;; attempt to change the control variable
  val st, msg = load("loop i in (1, 10) { set i = 10 }")
  assert(!st && string.find(msg, "assign to const variable 'i'"))

  val st, msg = load("loop v, k in [] { set v = 10 }")
  assert(!st && string.find(msg, "assign to const variable 'v'"))

}

;; conversion
set a = 0
loop i in ("10", "1", "-2") {
  set a = a + 1
}
assert(a == 5)

do {  ;; checking types
  var c
  val func checkfloat (i) {
    assert(math.type(i) == "float")
    set c = c + 1
  }

  set c = 0
  loop i in (1.0, 10) {
    checkfloat(i)
  }
  assert(c == 10)

  set c = 0
  loop i in (-1, -10, -1.0) {
    checkfloat(i)
  }
  assert(c == 10)

  val func checkint (i) {
    assert(math.type(i) == "integer")
    set c = c + 1
  }

  val m = math.maxinteger
  set c = 0
  loop i in (m, m - 10, -1) {
    checkint(i)
  }
  assert(c == 11)

  set c = 0
  loop i in (1, 10.9) {
    checkint(i)
  }
  assert(c == 10)

  set c = 0
  loop i in (10, 0.001, -1) {
    checkint(i)
  }
  assert(c == 10)

  set c = 0
  loop i in (1, "10.8") {
    checkint(i)
  }
  assert(c == 10)

  set c = 0
  loop i in (9, "3.4", -1) {
    checkint(i)
  }
  assert(c == 6)

  set c = 0
  loop i in (0, " -3.4  ", -1) {
    checkint(i)
  }
  assert(c == 4)

  set c = 0
  loop i in (100, "96.3", -2) {
    checkint(i)
  }
  assert(c == 2)

  set c = 0
  loop i in (1, math.huge) {
    if i > 10 {
      break()
    }
    checkint(i)
  }
  assert(c == 10)

  set c = 0
  loop i in (-1, -math.huge, -1) {
    if i < -10 {
      break()
    }
    checkint(i)
  }
  assert(c == 10)

  loop i in (math.mininteger, -10e100) {
    assert(false)
  }
  loop i in (math.maxinteger, 10e100, -1) {
    assert(false)
  }
}

do {  ;; testing other strange cases for numeric 'for'

  val func checkfor (from, to, step, t) {
    var c = 0
    loop i in (from, to, step) {
      set c = c + 1
      assert(i == t@(c))
    }
    assert(c == #t)
  }

  val maxi = math.maxinteger
  val mini = math.mininteger

  checkfor(mini, maxi, maxi, [mini, -1, maxi - 1])

  checkfor(mini, math.huge, maxi, [mini, -1, maxi - 1])

  checkfor(maxi, mini, mini, [maxi, -1])

  checkfor(maxi, mini, -maxi, [maxi, 0, -maxi])

  checkfor(maxi, -math.huge, mini, [maxi, -1])

  checkfor(maxi, mini, 1, [])
  checkfor(mini, maxi, -1, [])

  checkfor(maxi - 6, maxi, 3, [maxi - 6, maxi - 3, maxi])
  checkfor(mini + 4, mini, -2, [mini + 4, mini + 2, mini])

  val step = maxi // 10
  var c = mini
  loop i in (mini, maxi, step) {
    assert(i == c)
    set c = c + step
  }

  set c = maxi
  loop i in (maxi, mini, -step) {
    assert(i == c)
    set c = c - step
  }

  checkfor(maxi, maxi, maxi, [maxi])
  checkfor(maxi, maxi, mini, [maxi])
  checkfor(mini, mini, maxi, [mini])
  checkfor(mini, mini, mini, [mini])
}

checkerror("'for' step is zero", func () {
  loop i in (1, 10, 0) {
  }
})

checkerror("'for' step is zero", func () {
  loop i in (1, -10, 0) {
  }
})

checkerror("'for' step is zero", func () {
  loop i in (1.0, -10, 0.0) {
  }
})

collectgarbage()

;; testing generic 'for'

val func f (n, p) {
  val t = []
  loop i in (1, p) {
    set t@(i) = i * 10
  }
  return(func (_, n, ...) {
    assert(select("#", ...) == 0)  ;; no extra arguments
    if n > 0 {
      set n = n - 1
      return(n, table.unpack(t))
    }
  }, nil, n)
}

var x = 0
loop n, a, b, c, d in f(5, 3) {
  set x = x + 1
  assert((a == 10) && (b == 20) && (c == 30) && (d == nil))
}
assert(x == 5)

;; testing __pairs and __ipairs metamethod
set a = []
do {
  val x, y, z = pairs(a)
  assert((type(x) == 'function') && (y == a) && (z == nil))
}

val func foo (e, i) {
  assert(e == a)
  if i <= 10 {
    return(i + 1, i + 2)
  }
}

val func foo1 (e, i) {
  set i = i + 1
  assert(e == a)
  if i <= e.n {
    return(i, a@(i))
  }
}

var closed = false
setmetatable(a, [__pairs=func (x) {
  val tbc = setmetatable([], [__close=func () {
    set closed = true
  }])
  return(foo, x, 0, tbc)
}])

var i = 0
loop k, v in pairs(a) {
  set i = i + 1
  assert((k == i) && (v == (k + 1)))
}
assert(closed)  ;; 'tbc' has been closed

set a.n = 5
set a@(3) = 30

;; testing ipairs with metamethods
set a = [n=10]
setmetatable(a, [__index=func (t, k) {
  if k <= t.n {
    return(k * 10)
  }
}])
set i = 0
loop k, v in ipairs(a) {
  set i = i + 1
  assert((k == i) && (v == (i * 10)))
}
assert(i == a.n)

;; testing yield inside __pairs
do {
  val t = setmetatable([10, 20, 30], [__pairs=func (t) {
    val inc = coroutine.yield()
    return(func (t, i) {
      if i > 1 {
        return(i - inc, t@(i - inc))
      } else {
        return(nil)
      }
    }, t, #t + 1)
  }])

  val res = []
  val co = coroutine.wrap(func () {
    loop i, p in pairs(t) {
      set res@(#res + 1) = p
    }
  })

  co()  ;; start coroutine
  co(1)  ;; continue after yield
  assert((res@(1) == 30) && (res@(2) == 20) && (res@(3) == 10) && (#res == 3))
}

print("OK")
