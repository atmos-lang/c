;; testing syntax limits

val func testrep (init, rep, close, repc, finalresult) {
  val func gencode (n) {
    return(init ++ (string.rep(rep, n) ++ (close ++ string.rep(repc, n))))
  }
  val res, msg = load(gencode(100))  ;; 100 levels is OK
  assert(res)
  if (finalresult) {
    assert(res() == finalresult)
  }
  val res, msg = load(gencode(500))  ;; 500 levels not ok
  assert(!res && (string.find(msg, "too many") || string.find(msg, "overflow")))
}

testrep("val a", ",a", ";", "")  ;; local variables
testrep("val a", ",a", "= 1", "")  ;; local variables initialized
testrep("val a", ",a", "= f()", "")  ;; local variables initialized
testrep("var a; set a", ",a", "= 1", "")  ;; multiple assignment
testrep("var a; set a =", "[", "0", "]")  ;; constructors
testrep("", "(", "2", ")", 2)  ;; parentheses
;; nested calls  (a(a(a(a(...)))))
testrep("val func a (x) { x }; ", "a(", "2.2", ")", 2.2)
testrep("", "do { ", "", " }")
testrep("", "loop { while(a); ", "", " }")
testrep("val a; ", "if a {} else { ", "", " }")
testrep("", "func foo () { ", "", " }")
;; (Lua: 'a .. a .. ...' and 'a ^ a ^ ...' nest to the right and hit the
;;  C stack limit; Atmos operators are left associative and iterative)

checkmessage("set a = f(x" ++ (string.rep(",x", 260) ++ ")"), "too many registers")

;; testing other limits

;; upvalues
val lim = 127
var s = "val func fooA () {\n  var "
loop j in (1, lim) {
  set s = s ++ ("a" ++ (j ++ ", "))
}
set s = s ++ "b, c\n"
set s = s ++ "val func fooB () {\n  var "
loop j in (1, lim) {
  set s = s ++ ("b" ++ (j ++ ", "))
}
set s = s ++ "b\n"
set s = s ++ "func fooC () { b + c"
var c = 1 + 2
loop j in (1, lim) {
  set s = s ++ (" + a" ++ (j ++ (" + b" ++ j)))
  set c = c + 2
}
set s = s ++ "\n}  } }"
val a, b = load(s)
assert((c > 255) && string.find(b, "too many upvalues") && string.find(b, "line 5"))

;; local variables
set s = "\nfunc foo () {\n  var "
loop j in (1, 200) {
  set s = s ++ ("a" ++ (j ++ ", "))
}
set s = s ++ "b\n"
val a, b = load(s)
assert(string.find(b, "line 2") && string.find(b, "too many local variables"))

set mt.__index = oldmm

print('OK')
