checksyntax("x 1.000", "", "1.000", 1)
checksyntax("1 'aa'", "", "'aa'", 1)
checksyntax("loop { while(**) }", "", "**", 1)
checksyntax("loop i in => {}", "", "=>", 1)

;; test invalid non-printable char in a chunk
checksyntax("a\1a = 1", "", "<\\1>", 1)

;; test 255 as first char in a chunk
checksyntax("\255a = 1", "", "<\\255>", 1)

doit('set I = load("set a = 9 +"); set aaa = 3')
