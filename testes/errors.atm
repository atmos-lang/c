;; $Id: testes/errors.lua $
;; See Copyright Notice in file lua.h

print("testing errors")

val debug = require("debug")

;; avoid problems with 'strict' module (which may generate other error messages)
val mt = getmetatable(_G) || []
val oldmm = mt.__index
set mt.__index = nil

val func checkerr (msg, f, ...) {
  val st, err = pcall(f, ...)
  assert(!st && string.find(err, msg))
}

val func doit (s) {
  val f, msg = load(s)
  if !f {
    return(msg)
  }
  val cond, msg = pcall(f)
  return((!cond) && msg)
}

val func checkmessage (prog, msg, debug) {
  val m = doit(prog)
  if debug {
    print(m, msg)
  }
  assert(string.find(m, msg, 1, true))
}

val func checksyntax (prog, extra, token, line) {
  val msg = doit(prog)
  if !string.find(token, "^<%a") && !string.find(token, "^char%(") {
    set token = "'" ++ (token ++ "'")
  }
  set token = string.gsub(token, "(%p)", "%%%1")
  val pt = string.format("""^%%[string ".*"%%]:%d: .- near %s$""", line, token)
  assert(string.find(msg, pt))
  assert(string.find(msg, msg, 1, true))
}

;; test error message with no extra info
assert(doit("error('hi', 0)") == 'hi')

;; test nil error message
assert(doit("error()") == "<no error object>")

;; test common errors/errors that crashed in the past
assert(doit("table.unpack([], 1, n=2**30)"))
assert(doit("set a = math.sin()"))
assert(!doit("tostring(1)") && doit("tostring()"))
assert(doit("tonumber()"))
assert(doit("loop { until(1) }; = a"))
assert(doit("assert(false)"))
assert(doit("assert(nil)"))
assert(doit("func a (..., ...) {}"))
assert(doit("func a (, ...) {}"))
assert(doit("var t = []; set t = t@(#t) + 1"))

checksyntax("""  val a = [4

""", "']' expected (to close '[' at line 1)", "<eof>", 3)

if !T {
  (Message || print)('\n >>> testC not active: skipping tests for messages in C <<<\n')
} else {
  print("testing memory error message")
  val a = []
  loop i in (1, 10000) {  ;; preallocate array
    set a@(i) = true
  }
  collectgarbage()
  T.totalmem(T.totalmem() + 10000)
  ;; force a memory error (by a small margin)
  val st, msg = pcall(func () {
    loop i in (1, 100000) {
      set a@(i) = tostring(i)
    }
  })
  T.totalmem(0)
  assert(!st && (msg == ("not enough" ++ " memory")))

  ;; stack space for luaL_traceback (bug in 5.4.6)
  val res = T.testC("""    # push 16 elements on the stack
    pushnum 1; pushnum 1; pushnum 1; pushnum 1; pushnum 1;
    pushnum 1; pushnum 1; pushnum 1; pushnum 1; pushnum 1;
    pushnum 1; pushnum 1; pushnum 1; pushnum 1; pushnum 1;
    pushnum 1;
    # traceback should work with 4 remaining slots
    traceback xuxu 1;
    return 1
  """)

  assert(string.find(res, "xuxu.-main chunk"))

  do {  ;; tests for error messages about extra arguments from __call
    val func createobj (n) {
      ;; function that raises an error on its n-th argument
      val code = string.format("argerror %d 'msg'", n)
      val func_ = T.makeCfunc(code)
      ;; create a chain of 2 __call objects
      var M = setmetatable([], [__call=func_])
      set M = setmetatable([], [__call=M])
      ;; put it as a method for a new object
      return([foo=M])
    }

    set _G.a = createobj(1)  ;; error in first (extra) argument
    checkmessage("a::foo()", "bad extra argument #1")

    set _G.a = createobj(2)  ;; error in second (extra) argument
    checkmessage("a::foo()", "bad extra argument #2")

    set _G.a = createobj(3)  ;; error in self (after two extra arguments)
    checkmessage("a::foo()", "bad self")

    set _G.a = createobj(4)  ;; error in first regular argument (after self)
    checkmessage("a::foo()", "bad argument #1")
  }
}

;; tests for better error messages

checkmessage("set a = [] + 1", "arithmetic")
checkmessage("set a = [] < 1", "attempt to compare")
checkmessage("set a = [] <= 1", "attempt to compare")

checkmessage("set aaa = 1; set bbbb = 2; set aaa = math.sin(3) + bbbb(3)", "global 'bbbb'")
checkmessage("set aaa = []; do { val aaa = 1 }; aaa::bbbb(3)", "method 'bbbb'")
checkmessage("val a = []; a.bbbb(3)", "field 'bbbb'")
assert(!string.find(doit("set aaa = [13]; val bbbb = 1; aaa@(bbbb)(3)"), "'bbbb'"))
checkmessage("set aaa = [13]; val bbbb = 1; aaa@(bbbb)(3)", "number")
checkmessage("set aaa = (1) ++ []", "a table value")

checkmessage("val func foo (...) { val t = table.pack(...); t.xx + 1 }; foo()", "field 'xx'")

;; bug in 5.4.6
checkmessage("set a = [_ENV = []]; print(a._ENV.x + 1)", "field 'x'")

;; a similar bug, since 5.4.0
checkmessage("print(('_ENV').x + 1)", "field 'x'")

set _G.aaa, _G.bbbb = nil

;; calls
checkmessage("val a; a(13)", "local 'a'")
checkmessage("""  var a = setmetatable([], [__add = 34])
  set a = a + 1
""", "metamethod 'add'")
checkmessage("""  var a = setmetatable([], [__lt = []])
  set a = a > a
""", "metamethod 'lt'")

;; tail calls
checkmessage("val a = []; return(a.bbbb(3))", "field 'bbbb'")
checkmessage("set aaa = []; do { val aaa = 1 }; return(aaa::bbbb(3))", "method 'bbbb'")

checkmessage("set aaa = #print", "length of a function value")
checkmessage("set aaa = #3", "length of a number value")

set _G.aaa = nil

checkmessage("aaa.bbb::ddd(9)", "global 'aaa'")
checkmessage("val aaa = [bbb=1]; aaa.bbb::ddd(9)", "field 'bbb'")
checkmessage("val aaa = [bbb=[]]; aaa.bbb::ddd(9)", "method 'ddd'")
checkmessage("var a, b, c; (func () { set a = b + 1.1 })()", "upvalue 'b'")
assert(!doit("val aaa = [bbb=[ddd=next]]; aaa.bbb::ddd(nil)"))

;; upvalues being indexed do not go to the stack
checkmessage("var a, b, cc; (func () { set a = cc@(1) })()", "upvalue 'cc'")
checkmessage("var a, b, cc; (func () { set a.x = 1 })()", "upvalue 'a'")

checkmessage("val _ENV = [x=[]]; set a = a + 1", "global 'a'")

checkmessage("set BB = 1; val aaa = []; set x = aaa + BB", "local 'aaa'")
checkmessage("set aaa = []; set x = 3.3 / aaa", "global 'aaa'")
checkmessage("set aaa = 2; set BB = nil; set x = aaa * BB", "global 'BB'")
checkmessage("set aaa = []; set x = -aaa", "global 'aaa'")

;; short circuit
checkmessage("set aaa = 1; var aaa, bbbb = (2, 3); set aaa = math.sin(1) && bbbb(3)", "local 'bbbb'")
checkmessage("set aaa = 1; var aaa, bbbb = (2, 3); set aaa = bbbb(1) || aaa(3)", "local 'bbbb'")
checkmessage("val a, b, c, f = (1, 1, 1); f((a && b) || c)", "local 'f'")
checkmessage("val a, b, c = (1, 1, 1); ((a && b) || c)()", "call a number value")
assert(!string.find(doit("set aaa = []; set x = (aaa || aaa) + (aaa && aaa)"), "'aaa'"))
assert(!string.find(doit("set aaa = []; (aaa || aaa)()"), "'aaa'"))

checkmessage("print(print < 10)", "function with number")
checkmessage("print(print < print)", "two function values")
checkmessage("print('10' < 10)", "string with number")
checkmessage("print(10 < '23')", "number with string")

;; float->integer conversions
checkmessage("string.sub('a', 2.0 ** 100)", "has no integer representation")
checkmessage("string.rep('a', 3.3)", "has no integer representation")
checkmessage("set aaa = 24 // 0", "divide by zero")
checkmessage("set aaa = 1 % 0", "'n%0'")

;; type error for an object which is neither in an upvalue nor a register.
;; The following code will try to index the value 10 that is stored in
;; the metatable, without moving it to a register.
checkmessage("val a = setmetatable([], [__index = 10]).x", "attempt to index a number value")

;; numeric for loops
checkmessage("loop i in ([], 10) {}", "table")
checkmessage("loop i in (io.stdin, 10) {}", "FILE")
checkmessage("loop i in ([], 10) {}", "initial value")
checkmessage("loop i in (1, 'x', 10) {}", "string")
checkmessage("loop i in (1, [], 10) {}", "limit")
checkmessage("loop i in (1, []) {}", "limit")
checkmessage("loop i in (1, 10, print) {}", "step")
checkmessage("loop i in (1, 10, print) {}", "function")

;; passing light userdata instead of full userdata
set _G.D = debug
checkmessage("""  ;; create light udata
  val x = D.upvalueid(func () { debug }, 1)
  D.setuservalue(x, [])
""", "light userdata")
set _G.D = nil

do {  ;; named objects (field '__name')
  checkmessage("math.sin(io.input())", "(number expected, got FILE*)")
  set _G.XX = setmetatable([], [__name="My Type"])
  assert(string.find(tostring(XX), "^My Type"))
  checkmessage("io.input(XX)", "(FILE* expected, got My Type)")
  checkmessage("XX + 1", "on a My Type value")
  checkmessage("XX < XX", "two My Type values")
  checkmessage("[] < XX", "table with My Type")
  checkmessage("XX < io.stdin", "My Type with FILE*")
  set _G.XX = nil

  if T {  ;; extra tests for 'luaL_tolstring'
    ;; bug in 5.4.3; 'luaL_tolstring' with negative indices
    val x = setmetatable([], [__name="TABLE"])
    assert(T.testC("Ltolstring -1; return 1", x) == tostring(x))

    val a, b = T.testC("pushint 10; Ltolstring -2; return 2", x)
    assert((a == 10) && (b == tostring(x)))

    setmetatable(x, [__tostring=func (o) {
      assert(o == x)
      return("ABC")
    }])
    val a, b, c = T.testC("pushint 10; Ltolstring -2; return 3", x)
    assert((a == x) && (b == 10) && (c == "ABC"))
  }
}

;; global functions
checkmessage("(io.write || print)([])", "io.write")
checkmessage("(collectgarbage || print)([])", "collectgarbage")

;; errors in functions without debug info
do {
  var f
  set f = func (a) {
    return(a + 1)
  }
  set f = assert(load(string.dump(f, true)))
  assert(f(3) == 4)
  checkerr("^%?:%?:", f, [])

  ;; code with a move to a local var ('OP_MOV A B' with A<B)
  set f = func () {
    var a
    set a = []
    return(a + 2)
  }
  ;; no debug info (so that 'a' is unknown)
  set f = assert(load(string.dump(f, true)))
  ;; symbolic execution should not get lost
  checkerr("^%?:%?:.*table value", f)
}

