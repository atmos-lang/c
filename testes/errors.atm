;; tests for errors in coroutines

var f
set f = func (n) {
  val c = coroutine.create(f)
  val a, b = coroutine.resume(c)
  return(b)
}
assert(string.find(f(), "C stack overflow"))

;; (no "yield outside a coroutine" here: the chunk runs as a task, so a
;; raw 'coroutine.yield()' is an 'await' that nothing wakes)

set f = coroutine.wrap(func () {
  table.sort([1, 2, 3], coroutine.yield)
})
checkerr("yield across", f)

;; testing size of 'source' info; size of buffer for that info is
;; LUA_IDSIZE, declared as 60 in luaconf. Get one position for '\0'.
val idsize = 60 - 1
val func checksize (source) {
  ;; syntax error
  var _, msg = load("= x", source)
  set msg = string.match(msg, "^([^:]*):")  ;; get source (1st part before ':')
  assert(msg::len() <= idsize)
}

loop i in (60 - 10, 60 + 10) {  ;; check border cases around 60
  checksize("@" ++ string.rep("x", i))  ;; file names
  checksize(string.rep("x", i - 10))  ;; string sources
  checksize("=" ++ string.rep("x", i))  ;; exact sources
}

;; testing line error

val func lineerror (s, l, w) {
  val err, msg = pcall(load(s))
  val line = tonumber(string.match(msg, ":(%d+):"))
  assert(((line == l) || (!line && !l)) && string.find(msg, w))
}

lineerror("val a\n loop i in (1, 'a') { \n print(i) \n }", 2, "limit")
lineerror("\n val a \n loop k, v in true \n { \n print(k) \n }", 3, "iterate")
lineerror("\n\n loop k, v in \n true \n { \n print(k) \n }", 4, "iterate")
lineerror("func a.x.y () {\nset a = a + 1\n}", 1, "index")

lineerror("set a = \na\n+\n[]", 3, "arithmetic")
lineerror("set a = \n3\n+\n(\n4\n/\nprint)", 6, "arithmetic")
lineerror("set a = \nprint\n+\n(\n4\n/\n7)", 3, "arithmetic")

lineerror("set a\n=\n-\n\nprint\n;", 3, "arithmetic")

lineerror("""a (     ;; <<
23)
""", 1, "call")

lineerror("""val a = [x = 13]
a.x (     ;; <<
23
)
""", 2, "call")

lineerror("""val a = [x = 13]
a.x (
23 + a
)
""", 3, "arithmetic")

val p = """  func g () { f() }
  func f (x) { error('a', XX) }
g()
"""

set XX = 3
lineerror((p), 3, "a")
set XX = 0
lineerror((p), false, "a")
set XX = 1
lineerror((p), 2, "a")
set XX = 2
lineerror((p), 1, "a")
set _G.XX, _G.g, _G.f = nil

lineerror("""val b = false
if !b {
  error('test')
}""", 3, "test")

lineerror("""val b = false
if !b {
  if !b {
    if !b {
      error('test')
    }
  }
}""", 5, "test")

lineerror("""set _ENV = 1
func foo () {
  val a = 10
  a
}
""", 2, "index")

;; bug in 5.4.0
lineerror("""  val a = 0
  val b = 1
  val c = b % a
""", 3, "perform")

do {
  ;; Force a negative estimate for base line. Error in instruction 2
  ;; (after VARARGPREP, GETGLOBAL), with first absolute line information
  ;; (forced by too many lines) in instruction 0.
  val s = string.format("%s __A.x", string.rep("\n", 300))
  lineerror(s, 301, "index")
}

val func stxlineerror (s, l, w) {
  val err, msg = load(s)
  val line = tonumber(string.match(msg, ":(%d+):"))
  assert(((line == l) || (!line && !l)) && string.find(msg, w, 1, true))
}

stxlineerror("""val a = 1
set a = 2
""", 2, "const variable")

stxlineerror("""val a = 1
set = 2
""", 2, "expected")

if !_soft {
  ;; several tests that exhaust the Lua stack
  collectgarbage()
  print("testing stack overflow")
  var C = 0
  ;; get line where stack overflow will happen
  val l = debug.getinfo(1, "l").currentline + 4
  var auxy
  set auxy = func () {  ;; produce a stack overflow
    set C = C + 1
    auxy()
  }
  func YY () {
    collectgarbage("stop")  ;; avoid running finalizers without stack space
    auxy()
    collectgarbage("restart")
  }

  val func checkstackmessage (m) {
    print("(expected stack overflow after " ++ (C ++ " calls)"))
    set C = 0  ;; prepare next count
    return((string.find(m, "stack overflow")))
  }
  ;; repeated stack overflows (to check stack recovery)
  assert(checkstackmessage(doit('YY()')))
  assert(checkstackmessage(doit('YY()')))
  assert(checkstackmessage(doit('YY()')))

  set _G.YY = nil

  ;; error lines in stack overflow
  var l1
  val func g (x) {
    set l1 = debug.getinfo(x, "l").currentline + 2
    collectgarbage("stop")  ;; avoid running finalizers without stack space
    auxy()
    collectgarbage("restart")
  }
  val _, stackmsg = xpcall(g, debug.traceback, 1)
  print('+')
  val stack = []
  loop line in string.gmatch(stackmsg, "[^\n]*") {
    val curr = string.match(line, ":(%d+):")
    if curr {
      table.insert(stack, tonumber(curr))
    }
  }
  var i = 1
  loop {
    while(stack@(i) != l1)
    assert(stack@(i) == l)
    set i = i + 1
  }
  assert(i > 15)

  ;; error in error handling
  val res, msg = xpcall(error, error)
  assert(!res && (msg == 'error in error handling'))
  print('+')

  var f
  set f = func (x) {
    if x == 0 {
      error('a\n')
    } else {
      val func aux () {
        return(f(x - 1))
      }
      val a, b = xpcall(aux, aux)
      return(a, b)
    }
  }
  f(3)

  var loop_
  set loop_ = func (x, y, z) {
    return(1 + loop_(x, y, z))
  }

  val res, msg = xpcall(loop_, func (m) {
    assert(string.find(m, "stack overflow"))
    checkerr("error handling", loop_)
    assert(math.sin(0) == 0)
    return(15)
  })
  assert(msg == 15)

  val func f () {
    loop i in (999900, 1000000, 1) {
      table.unpack([], 1, i)
    }
  }
  checkerr("too many results", f)
}

do {  ;; errors in error handle that not necessarily go forever
  val func err (n) {  ;; function to be used as message handler
    ;; generate an error unless n is zero, so that there is a limited
    ;; loop of errors
    ifs {  ;; some other error?
      type(n) != "number" => {
        return(n)  ;; report it
      }
      n == 0 => {
        return("END")  ;; that will be the final message
      }
      else => {  ;; does the loop
        error(n - 1)
      }
    }
  }

  val res, msg = xpcall(error, err, 170)
  assert(!res && (msg == "END"))

  ;; too many levels
  val res, msg = xpcall(error, err, 300)
  assert(!res && (msg == "C stack overflow"))
}

do {
  ;; non string messages
  val t = []
  var res, msg = pcall(func () {
    error(t)
  })
  assert(!res && (msg == t))

  set res, msg = pcall(func () {
    error(nil)
  })
  assert(!res && (msg == "<no error object>"))

  val func f () {
    error([msg='x'])
  }
  set res, msg = xpcall(f, func (r) {
    return([msg=r.msg ++ 'y'])
  })
  assert(msg.msg == 'xy')

  ;; 'assert' with extra arguments
  set res, msg = pcall(assert, false, "X", t)
  assert(!res && (msg == "X"))

  ;; 'assert' with no message
  set res, msg = pcall(func () {
    assert(false)
  })
  val line = string.match(msg, "%w+%.atm:(%d+): assertion failed!$")
  assert(tonumber(line) == (debug.getinfo(1, "l").currentline - 3))

  ;; 'assert' with non-string messages
  set res, msg = pcall(assert, false, t)
  assert(!res && (msg == t))

  set res, msg = pcall(assert, nil, nil)
  assert(!res && (type(msg) == "string"))

  ;; 'assert' without arguments
  set res, msg = pcall(assert)
  assert(!res && string.find(msg, "value expected"))
}

;; xpcall with arguments
var a, b, c = xpcall(string.find, error, "alo", "al")
assert(a && (b == 1) && (c == 2))
set a, b, c = xpcall(string.find, func (x) {
  return([])
}, true, "al")
assert(!a && (type(b) == "table") && (c == nil))

