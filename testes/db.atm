var g, g1

;; tests for tail calls
var f
set f = func (x) {
  if x {
    assert(debug.getinfo(1, "S").what == "Lua")
    assert(debug.getinfo(1, "t").istailcall == true)
    val tail = debug.getinfo(2)
    assert((tail.func == g1) && (tail.istailcall == true))
    assert(debug.getinfo(3, "S").what == "main")
    print("+")
  }
}

assert(debug.getinfo(print, 't').istailcall == false)
assert(debug.getinfo(print, 't').extraargs == 0)

func g (x) {
  return(f(x))
}

func g1 (x) {
  g(x)
}

val func h (x) {
  val f = g1
  return(f(x))
}

h(true)

var b = []
debug.sethook(func (e) {
  table.insert(b, e)
}, "cr")
h(false)
debug.sethook()
val res = ["return", "call", "tail call", "call", "tail call", "return", "return", "call"]
;; first return (from sethook)

;; last call (to sethook)

loop i in (1, #res) {
  assert(res@(i) == table.remove(b, 1))
}

set b = 0
debug.sethook(func (e) {
  if e == "tail call" {
    set b = b + 1
    assert(debug.getinfo(2, "t").istailcall == true)
  } else {
    assert(debug.getinfo(2, "t").istailcall == false)
  }
}, "c")
h(false)
debug.sethook()
