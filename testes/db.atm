;; varargs
var foo
set foo = func (a, ...) {
  val t = table.pack(...)
  loop i in (1, t.n) {
    val n, v = debug.getlocal(1, -i)
    assert((n == "(vararg)") && (v == t@(i)))
  }
  assert(!debug.getlocal(1, -(t.n + 1)))
  assert(!debug.setlocal(1, -(t.n + 1), 30))
  if t.n > 0 {
    (func (x) {
      assert(debug.setlocal(2, -1, x) == "(vararg)")
      assert(debug.setlocal(2, -t.n, x) == "(vararg)")
    })(430)
    assert(... == 430)
  }
}

foo()
foo(print)
foo(200, 3, 4)
var a = []
loop i in (1, ((_soft && 100) || 1000)) {
  set a@(i) = i
}
foo(table.unpack(a))

do {  ;; test hook presence in debug info
  assert(!debug.gethook())
  var count = 0
  val func f () {
    assert(debug.getinfo(1).namewhat == "hook")
    val sndline = string.match(debug.traceback(), "\n(.-)\n")
    assert(string.find(sndline, "hook"))
    set count = count + 1
  }
  debug.sethook(f, "l")
  var a = 0
  set _ENV.a = a
  set a = 1
  debug.sethook()
  assert(count == 4)
}
set _ENV.a = nil

;; hook table has weak keys
assert(getmetatable(debug.getregistry()._HOOKKEY).__mode == 'k')

set a = []
var L = nil
var glob = 1
var oldglob = glob
debug.sethook(func (e, l) {
  collectgarbage()  ;; force GC during a hook
  val f, m, c = debug.gethook()
  assert((m == 'crl') && (c == 0))
  ifs {
    e == "line" => {
      if glob != oldglob {
        set L = l - 1  ;; get the first line where "glob" has changed
        set oldglob = glob
      }
    }
    e == "call" => {
      val f = debug.getinfo(2, "f").func
      set a@(f) = 1
    }
    else => {
      assert(e == "return")
    }
  }
}, "crl")

func f (a, b) {
  ;; declare some globals to check that they don't interfere with 'getlocal'
  ;; (global collectgarbage)
  collectgarbage()
  var _, x = debug.getlocal(1, 1)
  ;; (global assert, g, string)
  val _, y = debug.getlocal(1, 2)
  assert((x == a) && (y == b))
  assert(debug.setlocal(2, 4, "pera") == ("AA" ++ "AA"))
  assert(debug.setlocal(2, 5, "manga") == "B")
  set x = debug.getinfo(2)
  assert((x.func == g) && (x.what == "Lua") && (x.name == 'g') && (x.nups == 2) && string.find(x.source, "^@.*db%.atm$"))
  set glob = glob + 1
  assert(debug.getinfo(1, "l").currentline == (L + 1))
  assert(debug.getinfo(1, "l").currentline == (L + 2))
}

func foo () {
  set glob = glob + 1
  assert(debug.getinfo(1, "l").currentline == (L + 1))
}; foo()  ;; set L
