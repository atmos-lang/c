}
""", [1, 2, 1, 2, 1, 3])

test_("""loop i in (1, 4) { set a = 1 }""", [1, 1, 1, 1])

set _G.a = nil

do {  ;; testing line info/trace with large gaps in source

  val a = [1, 2, 3, 10, 124, 125, 126, 127, 128, 129, 130, 255, 256, 257, 500, 1000]
  val s = """     var b = [10]
     set a = b@(1) X + Y b@(1)
     set b = 4
  """

  loop _, i in ipairs(a) {
    val subs = [X=string.rep("\n", i)]
    loop _, j in ipairs(a) {
      set subs.Y = string.rep("\n", j)
      val s = string.gsub(s, "[XY]", subs)
      test_(s, [1, 2 + i, 2 + i + j, 2 + i, 2 + i + j, 3 + i + j])
    }
  }
}
set _G.a = nil

do {  ;; testing active lines
  val func checkactivelines (f, lines) {
    val t = debug.getinfo(f, "SL")
    loop _, l in pairs(lines) {
      set l = l + t.linedefined
      assert(t.activelines@(l))
      set t.activelines@(l) = undef
    }
    assert(next(t.activelines) == nil)  ;; no extra lines
  }

  checkactivelines(func (...) {  ;; vararg function
    ;; 1st line is empty
    ;; 2nd line is empty
    ;; 3th line is empty
    val a = 20
    ;; 5th line is empty
    val b = 30
    ;; 7th line is empty
  }, [4, 6, 8])

  checkactivelines(func (a) {
    ;; 1st line is empty
    ;; 2nd line is empty
    val a = 20
    val b = 30
    ;; 5th line is empty
  }, [3, 4, 6])

  checkactivelines(func (a, b, ...) {}, [0])

  checkactivelines(func (a, b) {
  }, [1])

  loop _, n in pairs([0, 1, 2, 10, 50, 100, 1000, 10000]) {
    checkactivelines(load(string.format("%s 1", string.rep("\n", n))), [n + 1])
  }
}

