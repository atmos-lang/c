val lim = (_soft && 3000) || 30000
var foo
set foo = func (x) {
  if x == 0 {
    assert(debug.getinfo(2).what == "main")
    val info = debug.getinfo(1)
    assert((info.istailcall == true) && (info.func == foo))
  } else {
    return(foo(x - 1))
  }
}

foo(lim)

print("+")

;; testing local function information
set co = load("""  val A = func () {
    x
  }
  return()
""")

var a = 0
;; 'A' should be visible to debugger only after its complete definition
debug.sethook(func (e, l) {
  ifs {
    l == 3 => {
      set a = a + 1
      assert(debug.getlocal(2, 1) == "(temporary)")
    }
    l == 4 => {
      set a = a + 1
      assert(debug.getlocal(2, 1) == "A")
    }
  }
}, "l")
co()  ;; run local function definition
debug.sethook()  ;; turn off hook
