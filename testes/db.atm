}

;; testing interaction between multiple values x hooks
do {
  val func f (...) {
    return(3, ...)
  }
  var count = 0
  val a = []
  loop i in (1, 100) {
    set a@(i) = i
  }
  debug.sethook(func () {
    set count = count + 1
  }, "", 1)
  var t = [table.unpack(a)]
  assert(#t == 100)
  set t = [table.unpack(a, 1, 3)]
  assert(#t == 3)
  set t = [f(table.unpack(a, 1, 30))]
  assert(#t == 31)
}

;; testing access to function arguments

val func collectlocals (level) {
  val tab = []
  loop i in (1, math.huge) {
    val n, v = debug.getlocal(level + 1, i)
    if !((n && string.find(n, "^[a-zA-Z0-9_]+$")) || (n == "(vararg table)")) {

      break()  ;; consider only real variables
    }
    set tab@(n) = v
  }
  return(tab)
}

var X = nil
set a = []
func a::f (a, b, ...) {
  val arg = [...]
  val c = 13
}
debug.sethook(func (e) {
  assert(e == "call")
  dostring("set XX = 12")  ;; test dostring inside hooks
  ;; testing errors inside hooks
  assert(!pcall(load("set a = 'joao' + 1")))
  debug.sethook(func (e, l) {
    assert(debug.getinfo(2, "l").currentline == l)
    val f, m, c = debug.gethook()
    assert(e == "line")
    assert((m == 'l') && (c == 0))
    debug.sethook(nil)  ;; hook is called only once
    assert(!X)  ;; check that
    set X = collectlocals(2)
  }, "l")
}, "c")

a::f(1, 2, 3, 4, 5)
assert((X.self == a) && (X.a == 1) && (X.b == 2) && (X.c == nil))
assert(XX == 12)
assert(!debug.gethook())
set _G.XX = nil

;; testing access to local variables in return hook (bug in 5.2)
do {
  var X = false

  val func foo (a, b, ...) {
    do {
      val x, y, z
    }
    val c, d = (10, 20)
    return()
  }

  val func aux () {
    if debug.getinfo(2).name == "foo" {
      set X = true  ;; to signal that it found 'foo'
      val tab = [a=100, b=200, c=10, d=20]
      loop n, v in pairs(collectlocals(2)) {
        assert(tab@(n) == v)
        set tab@(n) = undef
      }
      assert(next(tab) == nil)  ;; 'tab' must be empty
    }
  }

  debug.sethook(aux, "r")
  foo(100, 200)
  debug.sethook()
  assert(X)
}

val func eqseq (t1, t2) {
  assert(#t1 == #t2)
  loop i in (1, #t1) {
    assert(t1@(i) == t2@(i))
  }
}

do {
  print("testing inspection of parameters/returned values")
  var on_ = false
  var inp, out

  val func hook (event) {
    if !on_ {
      return()
    }
    val ar = debug.getinfo(2, "ruS")
    val t = []
    loop i in (ar.ftransfer, (ar.ftransfer + ar.ntransfer) - 1) {
      val _, v = debug.getlocal(2, i)
      set t@(#t + 1) = v
    }
    if event == "return" {
      set out = t
    } else {
      set inp = t
    }
  }

  debug.sethook(hook, "cr")

  set on_ = true
  math.sin(3)
  set on_ = false
  eqseq(inp, [3])
  eqseq(out, [math.sin(3)])

  set on_ = true
  select(2, 10, 20, 30, 40)
  set on_ = false
  eqseq(inp, [2, 10, 20, 30, 40])
  eqseq(out, [20, 30, 40])

  val func foo (a, ...) {
    return(...)
  }
  val func foo1 () {
    set on_ = !on_
    return(foo(20, 10, 0))
  }
  foo1()
  set on_ = false
  eqseq(inp, [20])
  eqseq(out, [10, 0])

  debug.sethook()
}

;; testing upvalue access
val func getupvalues (f) {
  val t = []
  var i = 1
  loop {
    while(true)
    val name, value = debug.getupvalue(f, i)
    if !name {
      break()
    }
    assert(!t@(name))
    set t@(name) = value
    set i = i + 1
  }
  return(t)
}

var a, b, c = (1, 2, 3)
val func foo1 (a) {
  set b = a
  return(c)
}
val func foo2 (x) {
  set a = x
  return(c + b)
}
assert(!debug.getupvalue(foo1, 3))
assert(!debug.getupvalue(foo1, 0))
assert(!debug.setupvalue(foo1, 3, "xuxu"))
var t = getupvalues(foo1)
assert((t.a == nil) && (t.b == 2) && (t.c == 3))
set t = getupvalues(foo2)
assert((t.a == 1) && (t.b == 2) && (t.c == 3))
assert(debug.setupvalue(foo1, 1, "xuxu") == "b")
assert(([debug.getupvalue(foo2, 3)])@(2) == "xuxu")
;; upvalues of C functions are always named "" (the empty string)
assert(debug.getupvalue(string.gmatch("x", "x"), 1) == "")

