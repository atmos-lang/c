;; testing debug library

val debug = require("debug")

val func dostring (s) {
  return(assert(load(s))())
}

print("testing debug library and debug information")

do {
  val a = 1
}

assert(!debug.gethook())

val testline = 21  ;; line where 'test' is defined
val func test_ (s, l, p) {  ;; this must be line 21
  collectgarbage()  ;; avoid gc during trace
  val func f (event, line) {
    assert(event == 'line')
    val l = table.remove(l, 1)
    if p { print(l, line) }
    assert(l == line, "wrong trace!!")
  }
  debug.sethook(f, "l"); load(s)(); debug.sethook()
  assert(#l == 0)
}

do {
  assert(!pcall(debug.getinfo, print, "X"))  ;; invalid option
  assert(!pcall(debug.getinfo, 0, ">"))  ;; invalid option
  assert(!debug.getinfo(1000))  ;; out of range level
  assert(!debug.getinfo(-1))  ;; out of range level
  var a = debug.getinfo(print)
  assert((a.what == "C") && (a.short_src == "[C]"))
  set a = debug.getinfo(print, "L")
  assert(a.activelines == nil)
  val b = debug.getinfo(test_, "SfL")
  assert((b.name == nil) && (b.what == "Lua") && (b.linedefined == testline) && (b.lastlinedefined == (b.linedefined + 10)) && (b.func == test_) && !string.find(b.short_src, "%["))
  assert(b.activelines@(b.linedefined + 1) && b.activelines@(b.lastlinedefined))
  assert(!b.activelines@(b.linedefined) && !b.activelines@(b.lastlinedefined + 1))
}

;;  bug in 5.4.4-5.4.6: activelines in vararg functions
;;  without debug information
do {
  val func_ = load(string.dump(load("print(10)"), true))
  val actl = debug.getinfo(func_, "L").activelines
  assert(#actl == 0)  ;; no line info
}

;; test file and string names truncation
var a = "func f () {}"
val func dostring (s, x) {
  return(load(s, x)())
}
dostring(a)
assert(debug.getinfo(f).short_src == string.format('[string "%s"]', a))
dostring(a ++ string.format("; set %s\n= 1", string.rep('p', 400)))
assert(string.find(debug.getinfo(f).short_src, '^%[string [^\n]*%.%.%."%]$'))
dostring(a ++ string.format("; set %s = 1", string.rep('p', 400)))
assert(string.find(debug.getinfo(f).short_src, '^%[string [^\n]*%.%.%."%]$'))
dostring("\n" ++ a)
assert(debug.getinfo(f).short_src == '[string "..."]')
dostring(a, "")
assert(debug.getinfo(f).short_src == '[string ""]')
dostring(a, "@xuxu")
assert(debug.getinfo(f).short_src == "xuxu")
dostring(a, "@" ++ (string.rep('p', 1000) ++ 't'))
assert(string.find(debug.getinfo(f).short_src, "^%.%.%.p*t$"))
dostring(a, "=xuxu")
assert(debug.getinfo(f).short_src == "xuxu")
dostring(a, string.format("=%s", string.rep('x', 500)))
assert(string.find(debug.getinfo(f).short_src, "^x*$"))
dostring(a, "=")
assert(debug.getinfo(f).short_src == "")
set _G.a = nil
set _G.f = nil
set _G@(string.rep("p", 400)) = nil

loop {
  var g = [x=func () {
    var a = debug.getinfo(2)
    assert((a.name == 'f') && (a.namewhat == 'local'))
    set a = debug.getinfo(1)
    assert((a.name == 'x') && (a.namewhat == 'field'))
    return('xixi')
  }]
  var f
  set f = func () {
    return((1 + 1) && (!1 || g.x()))
  }
  assert(f() == 'xixi')
  set g = debug.getinfo(f)
  assert((g.what == "Lua") && (g.func == f) && (g.namewhat == "") && !g.name)

  func f (x, name) {  ;; local!
    set name = name || 'f'
    val a = debug.getinfo(1)
    assert((a.name == name) && (a.namewhat == 'local'))
    return(x)
  }

  ;; breaks in different conditions
  if 3 > 4 {
    break()
  }
  f()
  if 3 < 4 {
    set a = 1
  } else {
    break()
  }
  f()
  loop {
    while(1)
    val x = 10
    break()
  }
  f()
  val b = 1
  if 3 > 4 {
    return(math.sin(1))
  }
  f()
  set a = 3 < 4
  f()
  set a = (3 < 4) || 1
  f()
  loop {
    val x = 20
    if 4 > 3 {
      f()
    } else {
      break()
    }
    f()
    until(1)
  }
  set g = []
  set f(g).x = f(2) && (f(10) + f(9))
  assert(g.x == f(19))
  func g (x) {
    if !x {
      return(3)
    }
    return((x('a', 'x')))
  }
  assert(g(f) == 'a')
  until(1)
}

