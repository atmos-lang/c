;; testing traceback

assert(debug.traceback(print) == print)
assert(debug.traceback(print, 4) == print)
assert(string.find(debug.traceback("hi", 4), "^hi\n"))
assert(string.find(debug.traceback("hi"), "^hi\n"))
assert(!string.find(debug.traceback("hi"), "'debug.traceback'"))
assert(string.find(debug.traceback("hi", 0), "'traceback'"))
assert(string.find(debug.traceback(), "^stack traceback:\n"))

do {  ;; C-function names in traceback
  val st, msg = (func () {
    return(pcall)
  })()(debug.traceback)
  assert((st == true) && string.find(msg, "pcall"))
}

;; testing nparams, nups e isvararg
var t = debug.getinfo(print, "u")
assert((t.isvararg == true) && (t.nparams == 0) && (t.nups == 0))

set t = debug.getinfo(func (a, b, c) {}, "u")
assert((t.isvararg == false) && (t.nparams == 3) && (t.nups == 0))

set t = debug.getinfo(func (a, b, ...) {
  return(t@(a))
}, "u")
assert((t.isvararg == true) && (t.nparams == 2) && (t.nups == 1))

set t = debug.getinfo(func (a, b, ...) {
  val t = [...]  ;; (no globals: no upvalues)
  set t.n = 2
  return(t@(a))
}, "u")
assert((t.isvararg == true) && (t.nparams == 2) && (t.nups == 0))

set t = debug.getinfo(1)  ;; main
assert((t.isvararg == true) && (t.nparams == 0) && (t.nups == 1) && (debug.getupvalue(t.func, 1) == "_ENV"))

set t = debug.getinfo(math.sin)  ;; C function
assert((t.isvararg == true) && (t.nparams == 0) && (t.nups == 0))

set t = debug.getinfo(string.gmatch("abc", "a"))  ;; C closure
assert((t.isvararg == true) && (t.nparams == 0) && (t.nups > 0))

;; testing debugging of coroutines

val func checktraceback (co, p, level) {
  val tb = debug.traceback(co, nil, level)
  var i = 0
  loop l in string.gmatch(tb, "[^\n]+\n?") {
    assert((i == 0) || string.find(l, p@(i)))
    set i = i + 1
  }
  assert(p@(i) == undef)
}

var f
set f = func (n) {
  if n > 0 {
    f(n - 1)
  } else {
    coroutine.yield()
  }
}

var co = coroutine.create(f)
coroutine.resume(co, 3)
checktraceback(co, ["yield", "db.atm", "db.atm", "db.atm", "db.atm"])
checktraceback(co, ["db.atm", "db.atm", "db.atm", "db.atm"], 1)
checktraceback(co, ["db.atm", "db.atm", "db.atm"], 2)
checktraceback(co, ["db.atm"], 4)
checktraceback(co, [], 40)

set co = coroutine.create(func (x) {
  val a = 1
  coroutine.yield(debug.getinfo(1, "l"))
  coroutine.yield(debug.getinfo(1, "l").currentline)
  return(a)
})

val tr = []
val func foo (e, l) {
  if l {
    table.insert(tr, l)
  }
}
debug.sethook(co, foo, "lcr")

val _, l = coroutine.resume(co, 10)
val x = debug.getinfo(co, 1, "lfLS")
assert((x.currentline == l.currentline) && x.activelines@(x.currentline))
assert(type(x.func) == "function")
loop i in (x.linedefined + 1, x.lastlinedefined) {
  assert(x.activelines@(i))
  set x.activelines@(i) = undef
}
assert(next(x.activelines) == nil)  ;; no 'extra' elements
assert(!debug.getinfo(co, 2))
var a, b = debug.getlocal(co, 1, 1)
assert((a == "x") && (b == 10))
set a, b = debug.getlocal(co, 1, 2)
assert((a == "a") && (b == 1))
debug.setlocal(co, 1, 2, "hi")
assert(debug.gethook(co) == foo)
assert((#tr == 2) && (tr@(1) == (l.currentline - 1)) && (tr@(2) == l.currentline))

set a, b, c = pcall(coroutine.resume, co)
assert(a && b && (c == (l.currentline + 1)))
checktraceback(co, ["yield", "in function <"])

set a, b = coroutine.resume(co)
assert(a && (b == "hi"))
assert((#tr == 4) && (tr@(4) == (l.currentline + 2)))
assert(debug.gethook(co) == foo)
assert(!debug.gethook())
checktraceback(co, [])

;; check get/setlocal in coroutines
set co = coroutine.create(func (x) {
  val a, b = coroutine.yield(x)
  assert((a == 100) && (b == nil))
  return(x)
})
set a, b = coroutine.resume(co, 10)
assert(a && (b == 10))
set a, b = debug.getlocal(co, 1, 1)
assert((a == "x") && (b == 10))
assert(!debug.getlocal(co, 1, 5))
assert(debug.setlocal(co, 1, 1, 30) == "x")
assert(!debug.setlocal(co, 1, 5, 40))
set a, b = coroutine.resume(co, 100)
assert(a && (b == 30))

;; check traceback of suspended (or dead with error) coroutines

func f (i) {
  if i == 0 {
    error(i)
  } else {
    coroutine.yield()
    f(i - 1)
  }
}

set co = coroutine.create(func (x) {
  f(x)
})
set a, b = coroutine.resume(co, 3)
set t = ["'yield'", "'f'", "in function <"]
loop {
  while(coroutine.status(co) == "suspended")
  checktraceback(co, t)
  set a, b = coroutine.resume(co)
  table.insert(t, 2, "'f'")  ;; one more recursive call to 'f'
}
set t@(1) = "'error'"
checktraceback(co, t)

;; test accessing line numbers of a coroutine from a resume inside
;; a C function (this is a known bug in Lua 5.0)

val func g (x) {
  coroutine.yield(x)
}

val func f (i) {
  debug.sethook(func () {}, "l")
  loop j in (1, 1000) {
    g(i + j)
  }
}

val co = coroutine.wrap(f)
co(10)
pcall(co)
pcall(co)

assert(type(debug.getregistry()) == "table")

;; test tagmethod information
val a = []
val func f (t) {
  val info = debug.getinfo(1)
  assert(info.namewhat == "metamethod")
  set a.op = info.name
  return(info.name)
}
setmetatable(a, [__index=f, __add=f, __div=f, __mod=f, __concat=f, __pow=f, __mul=f, __idiv=f, __unm=f, __len=f, __sub=f, __eq=f, __le=f, __lt=f, __unm=f, __len=f])

val b = setmetatable([], getmetatable(a))

assert((a@(3) == "index") && ((a ** 3) == "pow") && ((a ++ a) == "concat"))
assert(((a / 3) == "div") && ((3 % a) == "mod"))
assert(((a + 3) == "add") && ((3 - a) == "sub") && ((a * 3) == "mul") && (-a == "unm") && (#a == "len"))
assert(((a + 30000) == "add") && ((a - 3.0) == "sub") && ((a * 3.0) == "mul") && (-a == "unm") && (#a == "len"))
assert((a == b) && (a.op == "eq"))
assert((a >= b) && (a.op == "le"))
assert(("x" >= a) && (a.op == "le"))
assert((a > b) && (a.op == "lt"))
assert((a > 10) && (a.op == "lt"))


do {  ;; testing for-iterator name
  val func f () {
    assert(debug.getinfo(1).name == "for iterator")
    nil  ;; (functions evaluate to their last expression: end the loop)
  }

  loop i in f {
  }
}

do {  ;; testing debug info for finalizers
  var name = nil

  ;; create a piece of garbage with a finalizer
  setmetatable([], [__gc=func () {
    val t = debug.getinfo(1)  ;; get function information
    assert(t.namewhat == "metamethod")
    set name = t.name
  }])

  ;; repeat until previous finalizer runs (setting 'name')
  loop {
    val a = []
    until(name)
  }
  assert(name == "__gc")
}

do {
  print("testing traceback sizes")

  val func countlines (s) {
    return(select(2, string.gsub(s, "\n", "")))
  }

  var deep
  set deep = func (lvl, n) {
    if lvl == 0 {
      return((debug.traceback("message", n)))
    } else {
      return((deep(lvl - 1, n)))
    }
  }

  val func checkdeep (total, start) {
    val s = deep(total, start)
    val rest = string.match(s, "^message\nstack traceback:\n(.*)$")
    val cl = countlines(rest)
    ;; at most 10 lines in first part, 11 in second, plus '...'
    assert(cl <= (10 + 11 + 1))
    val brk = string.find(rest, "%.%.%.\t%(skip")
    if brk {  ;; does message have '...'?
      val rest1 = string.sub(rest, 1, brk)
      val rest2 = string.sub(rest, brk, #rest)
      assert((countlines(rest1) == 10) && (countlines(rest2) == 11))
    } else {
      assert(cl == ((total - start) + 2))
    }
  }

  loop d in (1, 51, 10) {
    loop l in (1, d) {
      ;; use coroutines to ensure complete control of the stack
      coroutine.wrap(checkdeep)(d, l)
    }
  }
}

print("testing debug functions on chunk without debug info")
val prog = """;; program to be loaded without debug information (strip)
val debug = require('debug')
var a = 12  ;; a local variable

var n, v = debug.getlocal(1, 1)
assert((n == "(temporary)") && (v == debug))   ;; unknown name but known value
set n, v = debug.getlocal(1, 2)
assert((n == "(temporary)") && (v == 12))   ;; unknown name but known value

;; a function with an upvalue
var f = func () { val x; a }
set n, v = debug.getupvalue(f, 1)
assert((n == "(no name)") && (v == 12))
assert(debug.setupvalue(f, 1, 13) == "(no name)")
assert(a == 13)

var t = debug.getinfo(f)
assert((t.name == nil) && (t.linedefined > 0) &&
       (t.lastlinedefined == t.linedefined) &&
       (t.short_src == "?"))
assert(debug.getinfo(1).currentline == -1)

set t = debug.getinfo(f, "L").activelines
assert(next(t) == nil)    ;; active lines are empty

;; dump/load a function without debug info
set f = load(string.dump(f))

set t = debug.getinfo(f)
assert((t.name == nil) && (t.linedefined > 0) &&
       (t.lastlinedefined == t.linedefined) &&
       (t.short_src == "?"))
assert(debug.getinfo(1).currentline == -1)

a
"""

;; load 'prog' without debug info
val f = assert(load(string.dump(load(prog), true)))

assert(f() == 13)

do {  ;; bug in 5.4.0: line hooks in stripped code
  val func foo () {
    val a = 1
    val b = 2
    return(b)
  }

  val s = load(string.dump(foo, true))
  var line = true
  debug.sethook(func (e, l) {
    assert(e == "line")
    set line = l
  }, "l")
  assert(s() == 2); debug.sethook(nil)
  assert(line == nil)  ;; hook called without debug info for 1st instruction
}

do {  ;; tests for 'source' in binary dumps
  val prog = """    func (x) {
      func (y) {
        x + y
      }
    }
  """

  val name = string.rep("x", 1000)
  val p = assert(load(prog, name))
  ;; load 'p' as a binary chunk with debug information
  val c = string.dump(p)
  assert((#c > 1000) && (#c < 2000))  ;; no repetition of 'source' in dump
  val f = assert(load(c))
  val g = f()
  val h = g(3)
  assert(h(5) == 8)
  assert((debug.getinfo(f).source == name) && (debug.getinfo(g).source == name) && (debug.getinfo(h).source == name))
  ;; all functions have 'source'

  ;; again, without debug info
  val c = string.dump(p, true)
  assert(#c < 500)  ;; no 'source' in dump
  val f = assert(load(c))
  val g = f()
  val h = g(30)
  assert(h(50) == 80)
  assert((debug.getinfo(f).source == '=?') && (debug.getinfo(g).source == '=?') && (debug.getinfo(h).source == '=?'))
  ;; no function has 'source'
}

print("OK")
