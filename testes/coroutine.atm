;; $Id: testes/coroutine.lua $
;; See Copyright Notice in file lua.h

print("testing coroutines")

val debug = require('debug')

var f

val main, ismain = coroutine.running()
assert((type(main) == "thread") && ismain)
assert(!coroutine.resume(main))
assert(!coroutine.isyieldable(main) && !coroutine.isyieldable())
assert(!pcall(coroutine.yield))

;; trivial errors
assert(!pcall(coroutine.resume, 0))
assert(!pcall(coroutine.status, 0))

;; tests for multiple yield/resume arguments

val func eqtab (t1, t2) {
  assert(#t1 == #t2)
  loop i in (1, #t1) {
    val v = t1@(i)
    assert(t2@(i) == v)
  }
}

set _G.x = nil  ;; declare x
set _G.f = nil  ;; declare f
var foo
set foo = func (a, ...) {
  val x, y = coroutine.running()
  assert((x == f) && (y == false))
  ;; next call should not corrupt coroutine (but must fail,
  ;; as it attempts to resume the running coroutine)
  assert(coroutine.resume(f) == false)
  assert(coroutine.status(f) == "running")
  val arg = [...]
  assert(coroutine.isyieldable(x))
  loop i in (1, #arg) {
    set _G.x = [coroutine.yield(table.unpack(arg@(i)))]
  }
  return(table.unpack(a))
}

set f = coroutine.create(foo)
assert(coroutine.isyieldable(f))
assert((type(f) == "thread") && (coroutine.status(f) == "suspended"))
assert(string.find(tostring(f), "thread"))
var s, a, b, c, d
set s, a, b, c, d = coroutine.resume(f, [1, 2, 3], [], [1], ['a', 'b', 'c'])
assert(coroutine.isyieldable(f))
assert(s && (a == nil) && (coroutine.status(f) == "suspended"))
set s, a, b, c, d = coroutine.resume(f)
eqtab(_G.x, [])
assert(s && (a == 1) && (b == nil))
assert(coroutine.isyieldable(f))
set s, a, b, c, d = coroutine.resume(f, 1, 2, 3)
eqtab(_G.x, [1, 2, 3])
assert(s && (a == 'a') && (b == 'b') && (c == 'c') && (d == nil))
set s, a, b, c, d = coroutine.resume(f, "xuxu")
eqtab(_G.x, ["xuxu"])
assert(s && (a == 1) && (b == 2) && (c == 3) && (d == nil))
assert(coroutine.status(f) == "dead")
set s, a = coroutine.resume(f, "xuxu")
assert(!s && string.find(a, "dead") && (coroutine.status(f) == "dead"))

set _G.f = nil

;; yields in tail calls
var foo
set foo = func (i) {
  return(coroutine.yield(i))
}
var f = coroutine.wrap(func () {
  loop i in (1, 10) {
    assert(foo(i) == _G.x)
  }
  return('a')
})
loop i in (1, 10) {
  set _G.x = i
  assert(f(i) == i)
}
set _G.x = 'xuxu'
assert(f('xuxu') == 'a')

set _G.x = nil

;; recursive
var pf
set pf = func (n, i) {
  coroutine.yield(n)
  pf(n * i, i + 1)
}

set f = coroutine.wrap(pf)
var s = 1
loop i in (1, 10) {
  assert(f(1, 1) == s)
  set s = s * i
}

;; sieve
val func gen (n) {
  return(coroutine.wrap(func () {
    loop i in (2, n) {
      coroutine.yield(i)
    }
  }))
}

val func filter (p, g) {
  return(coroutine.wrap(func () {
    loop {
      while(1)
      val n = g()
      if n == nil {
        return()
      }
      if math.fmod(n, p) != 0 {
        coroutine.yield(n)
      }
    }
  }))
}

var x = gen(80)
var a = []
loop {
  while(1)
  val n = x()
  if n == nil {
    break()
  }
  table.insert(a, n)
  set x = filter(n, x)
}

assert((#a == 22) && (a@(#a) == 79))
set x, a = nil

do {  ;; "bug" in 5.4.2
  var foo
  set foo = func () {  ;; just create a stack overflow
    foo()
  }
  val co = coroutine.create(foo)
  ;; running this coroutine would overflow the unsigned short 'nci', the
  ;; counter of CallInfo structures available to the thread.
  ;; (The issue only manifests in an 'assert'.)
  val st, msg = coroutine.resume(co)
  assert(string.find(msg, "stack overflow"))
  assert(coroutine.status(co) == "dead")
}

print("to-be-closed variables in coroutines")

val func func2close (f) {
  return(setmetatable([], [__close=f]))
}

do {
  ;; ok to close a dead coroutine
  var co = coroutine.create(print)
  assert(coroutine.resume(co, "testing 'coroutine.close'"))
  assert(coroutine.status(co) == "dead")
  var st, msg = coroutine.close(co)
  assert(st && (msg == nil))
  ;; also ok to close it again
  set st, msg = coroutine.close(co)
  assert(st && (msg == nil))

  ;; cannot close 'main'
  var st, msg = pcall(coroutine.close, main)
  assert(!st && string.find(msg, "main"))

  ;; cannot close a "normal" coroutine
  (coroutine.wrap(func () {
    val st, msg = pcall(coroutine.close, main)
    assert(!st && string.find(msg, "normal"))
  }))()

  do {  ;; close a coroutine while closing it
    var co
    set co = coroutine.create(func () {

      pin x = func2close(func () {
        coroutine.close(co)  ;; close it again
      })
      coroutine.yield(20)
    })
    var st, msg = coroutine.resume(co)
    assert(st && (msg == 20))
    set st, msg = coroutine.close(co)
    assert(st && (msg == nil))
  }

  do {
    ;; again close a coroutine while closing it, but with the
    ;; coroutine in error mode.

    ;; after the error, the function created by 'wrap' will close the
    ;; coroutine. The close inside 'a' overrides the original close
    ;; and finishes the coroutine with no errors.
    val co = coroutine.wrap(func () {
      pin a = func2close(func () {
        coroutine.close()
      })
      error("y")
    })
    co()  ;; no errors
  }

  ;; to-be-closed variables in coroutines
  var X

  ;; closing a coroutine after an error
  var co = coroutine.create(error)
  var st, msg = coroutine.resume(co, 100)
  assert(!st && (msg == 100))
  set st, msg = coroutine.close(co)
  assert(!st && (msg == 100))
  ;; after closing, no more errors
  set st, msg = coroutine.close(co)
  assert(st && (msg == nil))

  set co = coroutine.create(func () {
    pin x = func2close(func (self, err) {
      assert(err == nil)
      set X = false
    })
    set X = true
    coroutine.yield()
  })
  coroutine.resume(co)
  assert(X)
  assert(coroutine.close(co))
  assert(!X && (coroutine.status(co) == "dead"))

  ;; error closing a coroutine
  var x = 0
  set co = coroutine.create(func () {
    pin y = func2close(func (self, err) {
      assert(err == 111)
      set x = 200
      error(200)
    })
    pin x = func2close(func (self, err) {
      assert(err == nil)
      error(111)
    })
    coroutine.yield()
  })
  coroutine.resume(co)
  assert(x == 0)
  var st, msg = coroutine.close(co)
  assert((st == false) && (coroutine.status(co) == "dead") && (msg == 200))
  assert(x == 200)
  ;; after closing, no more errors
  set st, msg = coroutine.close(co)
  assert(st && (msg == nil))
}

do {
  ;; <close> versus pcall in coroutines
  var X = false
  var Y = false
  val func foo () {
    pin x = func2close(func (self, err) {
      set Y = debug.getinfo(2)
      set X = err
    })
    error(43)
  }
  val co = coroutine.create(func () {
    return(pcall(foo))
  })
  val st1, st2, err = coroutine.resume(co)
  assert(st1 && !st2 && (err == 43))
  assert((X == 43) && (Y.what == "C"))

  ;; recovering from errors in __close metamethods
  val track = []

  val func h (o) {
    pin hv = o
    return(1)
  }

  val func foo () {
    pin x = func2close(func (_, msg) {
      set track@(#track + 1) = msg || false
      error(20)
    })
    pin y = func2close(func (_, msg) {
      set track@(#track + 1) = msg || false
      return(1000)
    })
    pin z = func2close(func (_, msg) {
      set track@(#track + 1) = msg || false
      error(10)
    })
    coroutine.yield(1)
    h(func2close(func (_, msg) {
      set track@(#track + 1) = msg || false
      error(2)
    }))
  }

  val co = coroutine.create(pcall)

  val st, res = coroutine.resume(co, foo)  ;; call 'foo' protected
  assert(st && (res == 1))  ;; yield 1
  val st, res1, res2 = coroutine.resume(co)  ;; continue
  assert(coroutine.status(co) == "dead")
  assert(st && !res1 && (res2 == 20))  ;; last error (20)
  assert((track@(1) == false) && (track@(2) == 2) && (track@(3) == 10) && (track@(4) == 10))
}

do {
  print("coroutines closing itself")
  ;; (global <const> coroutine, string, os)
  ;; (global <const> assert, error, pcall)

  var X = nil

  val func new () {
    return(coroutine.create(func (what) {

      pin var_ = func2close(func (t, err) {
        ifs {
          what == "yield" => {
            coroutine.yield()
          }
          what == "error" => {
            error(200)
          }
          else => {
            set X = "Ok"
            return(X)
          }
        }
      })

      ;; do an unprotected call so that coroutine becomes non-yieldable
      string.gsub("a", "a", func () {
        assert(!coroutine.isyieldable())
        ;; do protected calls while non-yieldable, to add recovery
        ;; entries (setjmp) to the stack
        assert(pcall(pcall, func () {
          ;; 'close' works even while non-yieldable
          coroutine.close()  ;; close itself
          os.exit(false)  ;; not reacheable
        }))
      })
    }))
  }

  val co = new()
  val st, msg = coroutine.resume(co, "ret")
  assert(st && (msg == nil))
  assert(X == "Ok")

  val co = new()
  val st, msg = coroutine.resume(co, "error")
  assert(!st && (msg == 200))

  val co = new()
  val st, msg = coroutine.resume(co, "yield")
  assert(!st && string.find(msg, "attempt to yield"))
}

;; yielding across C boundaries

var co = coroutine.wrap(func () {
  assert(!pcall(table.sort, [1, 2, 3], coroutine.yield))
  assert(coroutine.isyieldable())
  coroutine.yield(20)
  return(30)
})

assert(co() == 20)
assert(co() == 30)

var f
set f = func (s, i) {
  return(coroutine.yield(i))
}

val f1 = coroutine.wrap(func () {
  return(xpcall(pcall, func (...) {
    return(...)
  }, func () {

    var s = 0
    loop i in (f, nil, 1, nil) {
      pcall(func () {
        set s = s + i
      })
    }
    error([s])
  }))
})

f1()
loop i in (1, 10) {
  assert(f1(i) == i)
}
var r1, r2, v = f1(nil)
assert(r1 && !r2 && (v@(1) == (((10 + 1) * 10) / 2)))

var f
set f = func (a, b) {
  set a = coroutine.yield(a)
  error([a + b])
}
val func g (x) {
  return(x@(1) * 2)
}

set co = coroutine.wrap(func () {
  coroutine.yield(xpcall(f, g, 10, 20))
})

assert(co() == 10)
val r, msg = co(100)
assert(!r && (msg == 240))

;; unyieldable C call
do {
  val func f (c) {
    assert(!coroutine.isyieldable())
    return(c ++ c)
  }

  val co = coroutine.wrap(func (c) {
    assert(coroutine.isyieldable())
    val s = string.gsub("a", ".", f)
    return(s)
  })
  assert(co() == "aa")
}

do {  ;; testing single trace of coroutines
  val X
  val co = coroutine.create(func () {
    coroutine.yield(10)
    return(20)
  })
  val trace = []
  val func dotrace (event) {
    set trace@(#trace + 1) = event
  }
  debug.sethook(co, dotrace, "clr")
  loop {
    until(!coroutine.resume(co))
  }
  val correcttrace = ["call", "line", "call", "return", "line", "return"]
  assert(#trace == #correcttrace)
  loop k, v in pairs(trace) {
    assert(v == correcttrace@(k))
  }
}

;; errors in coroutines
func foo () {
  assert(debug.getinfo(1).currentline == (debug.getinfo(foo).linedefined + 1))
  assert(debug.getinfo(2).currentline == debug.getinfo(goo).linedefined)
  coroutine.yield(3)
  error(foo)
}

func goo () { foo() }
set x = coroutine.wrap(goo)
assert(x() == 3)
var a, b = pcall(x)
assert(!a && (b == foo))

set x = coroutine.create(goo)
set a, b = coroutine.resume(x)
assert(a && (b == 3))
set a, b = coroutine.resume(x)
assert(!a && (b == foo) && (coroutine.status(x) == "dead"))
set a, b = coroutine.resume(x)
assert(!a && string.find(b, "dead") && (coroutine.status(x) == "dead"))

set goo = nil

;; co-routines x for loop
var all
set all = func (a, n, k) {
  if k == 0 {
    coroutine.yield(a)
  } else {
    loop i in (1, n) {
      set a@(k) = i
      all(a, n, k - 1)
    }
  }
}

var a = 0
loop t in coroutine.wrap(func () {
  all([], 5, 4)
}) {
  set a = a + 1
}
assert(a == (5 ** 4))

;; access to locals of collected corroutines
var C = []
setmetatable(C, [__mode="kv"])
var x = coroutine.wrap(func () {
  var a = 10
  val func f () {
    set a = a + 10
    return(a)
  }
  loop {
    while(true)
    set a = a + 1
    coroutine.yield(f)
  }
})

set C@(1) = x

var f = x()
assert((f() == 21) && (x()() == 32) && (x() == f))
set x = nil
collectgarbage()
assert(C@(1) == undef)
assert((f() == 43) && (f() == 53))

;; old bug: attempt to resume itself

val func co_func (current_co) {
  assert(coroutine.running() == current_co)
  assert(coroutine.resume(current_co) == false)
  coroutine.yield(10, 20)
  assert(coroutine.resume(current_co) == false)
  coroutine.yield(23)
  return(10)
}

var co = coroutine.create(co_func)
var a, b, c = coroutine.resume(co, co)
assert((a == true) && (b == 10) && (c == 20))
set a, b = coroutine.resume(co, co)
assert((a == true) && (b == 23))
set a, b = coroutine.resume(co, co)
assert((a == true) && (b == 10))
assert(coroutine.resume(co, co) == false)
assert(coroutine.resume(co, co) == false)

;; other old bug when attempting to resume itself
;; (trigger C-code assertions)
do {
  var A = coroutine.running()
  val B = coroutine.create(func () {
    return(coroutine.resume(A))
  })
  var st, res = coroutine.resume(B)
  assert((st == true) && (res == false))

  var X = false
  set A = coroutine.wrap(func () {
    pin _ = func2close(func () {
      set X = true
    })
    return(pcall(A, 1))
  })
  set st, res = A()
  assert(!st && string.find(res, "non%-suspended") && (X == true))
}

;; bug in 5.4.1
do {
  ;; coroutine ran close metamethods with invalid status during a
  ;; reset.
  var co
  set co = coroutine.wrap(func () {
    pin x = func2close(func () {
      return(pcall(co))
    })
    error(111)
  })
  var st, errobj = pcall(co)
  assert(!st && (errobj == 111))
  set st, errobj = pcall(co)
  assert(!st && string.find(errobj, "dead coroutine"))
}

;; attempt to resume 'normal' coroutine
var co1, co2
set co1 = coroutine.create(func () {
  return(co2())
})
set co2 = coroutine.wrap(func () {
  assert(coroutine.status(co1) == 'normal')
  assert(!coroutine.resume(co1))
  coroutine.yield(3)
})

set a, b = coroutine.resume(co1)
assert(a && (b == 3))
assert(coroutine.status(co1) == 'dead')

;; infinite recursion of coroutines
set a = func (a) {
  coroutine.wrap(a)(a)
}
assert(!pcall(a, a))
set a = nil

do {
  ;; bug in 5.4: thread can use message handler higher in the stack
  ;; than the variable being closed
  val c = coroutine.create(func () {
    pin clo = setmetatable([], [__close=func () {
      val x = 134  ;; will overwrite message handler
      error(x)
    }])
    ;; yields coroutine but leaves a new message handler for it,
    ;; that would be used when closing the coroutine (except that it
    ;; will be overwritten)
    xpcall(coroutine.yield, func () {
      return("XXX")
    })
  })

  assert(coroutine.resume(c))  ;; start coroutine
  val st, msg = coroutine.close(c)
  assert(!st && (msg == 134))
}

;; access to locals of erroneous coroutines
var x = coroutine.create(func () {
  var a = 10
  set _G.F = func () {
    set a = a + 1
    return(a)
  }
  error('x')
})

assert(!coroutine.resume(x))
;; overwrite previous position of local `a'
assert(!coroutine.resume(x, 1, 1, 1, 1, 1, 1, 1))
assert(_G.F() == 11)
assert(_G.F() == 12)
set _G.F = nil

if !T {
  (Message || print)('\n >>> testC not active: skipping coroutine API tests <<<\n')
} else {
  print("testing yields inside hooks")

  var turn

  var fact
  set fact = func (t, x) {
    assert(turn == t)
    if x == 0 {
      return(1)
    } else {
      return(x * fact(t, x - 1))
    }
  }

  var A, B = (0, 0)

  var x = coroutine.create(func () {
    T.sethook("yield 0", "", 2)
    set A = fact("A", 6)
  })

  val y = coroutine.create(func () {
    T.sethook("yield 0", "", 3)
    set B = fact("B", 7)
  })

  loop {  ;; A ~= 0 when 'x' finishes (similar for 'B','y')
    while((A == 0) || (B == 0))
    if A == 0 {
      set turn = "A"
      assert(T.resume(x))
    }
    if B == 0 {
      set turn = "B"
      assert(T.resume(y))
    }

    ;; check that traceback works correctly after yields inside hooks
    debug.traceback(x)
    debug.traceback(y)
  }

  assert((B // A) == 7)  ;; fact(7) // fact(6)

  do {  ;; hooks vs. multiple values
    var done
    val func test_ (n) {
      set done = false
      return(coroutine.wrap(func () {
        val a = []
        loop i in (1, n) {
          set a@(i) = i
        }
        ;; 'pushint' just to perturb the stack
        T.sethook("pushint 10; yield 0", "", 1)  ;; yield at each op.
        val a1 = [table.unpack(a)]  ;; must keep top between ops.
        assert(#a1 == n)
        loop i in (1, n) {
          assert(a@(i) == i)
        }
        set done = true
      }))
    }
    ;; arguments to the coroutine are just to perturb its stack
    var co = test_(0)
    loop {
      while(!done)
      co(30)
    }
    set co = test_(1)
    loop {
      while(!done)
      co(20, 10)
    }
    set co = test_(3)
    loop {
      while(!done)
      co()
    }
    set co = test_(100)
    loop {
      while(!done)
      co()
    }
  }

  val line = debug.getinfo(1, "l").currentline + 2  ;; get line number
  val func foo () {
    var x = 10  ;;<< this line is 'line'
    set x = x + 10
    set _G.XX = x
  }

  ;; testing yields in line hook
  var co = coroutine.wrap(func () {
    T.sethook("setglobal X; yield 0", "l", 0)
    foo()
    return(10)
  })

  set _G.XX = nil
  set _G.X = nil
  co()
  assert(_G.X == line)
  set _G.X = nil
  co()
  assert(_G.X == (line + 1))
  set _G.X = nil
  co()
  assert((_G.X == (line + 2)) && (_G.XX == nil))
  set _G.X = nil
  co()
  assert((_G.X == (line + 3)) && (_G.XX == 20))
  assert(co() == 10)
  set _G.X = nil

  ;; testing yields in count hook
  set co = coroutine.wrap(func () {
    T.sethook("yield 0", "", 1)
    foo()
    return(10)
  })

  set _G.XX = nil
  var c = 0
  loop {
    set c = c + 1
    val a = co()
    until(a == 10)
  }
  assert((_G.XX == 20) && (c >= 5))

  set co = coroutine.wrap(func () {
    T.sethook("yield 0", "", 2)
    foo()
    return(10)
  })

  set _G.XX = nil
  var c = 0
  loop {
    set c = c + 1
    val a = co()
    until(a == 10)
  }
  assert((_G.XX == 20) && (c >= 5))
  set _G.X = nil
  set _G.XX = nil

  do {
    ;; testing debug library on a coroutine suspended inside a hook
    ;; (bug in 5.2/5.3)
    set c = coroutine.create(func (a, ...) {
      T.sethook("yield 0", "l")  ;; will yield on next two lines
      val b = a
      return(...)
    })

    assert(coroutine.resume(c, 1, 2, 3))  ;; start coroutine
    var n, v = debug.getlocal(c, 0, 1)  ;; check its local
    assert((n == "a") && (v == 1) && (debug.getlocal(c, 0, 2) != "b"))
    assert(debug.setlocal(c, 0, 1, 10))  ;; test 'setlocal'
    val t = debug.getinfo(c, 0)  ;; test 'getinfo'
    assert(t.currentline == (t.linedefined + 2))
    assert(!debug.getinfo(c, 1))  ;; no other level
    assert(coroutine.resume(c))  ;; run next line
    var n, v = debug.getlocal(c, 0, 2)  ;; check vararg table
    assert((n == "(vararg table)") && (v == nil))
    var n, v = debug.getlocal(c, 0, 3)  ;; check next local
    assert((n == "b") && (v == 10))
    set v = [coroutine.resume(c)]  ;; finish coroutine
    assert((v@(1) == true) && (v@(2) == 2) && (v@(3) == 3) && (v@(4) == undef))
    assert(!coroutine.resume(c))
  }

  do {
    ;; testing debug library on last function in a suspended coroutine
    ;; (bug in 5.2/5.3)
    val c = coroutine.create(func () {
      T.testC("yield 1", 10, 20)
    })
    var a, b = coroutine.resume(c)
    assert(a && (b == 20))
    assert(debug.getinfo(c, 0).linedefined == -1)
    set a, b = debug.getlocal(c, 0, 2)
    assert(b == 10)
  }

  print("testing coroutine API")

  ;; reusing a thread
  assert(T.testC("""    newthread      # create thread
    pushvalue 2    # push body
    pushstring 'a a a'  # push argument
    xmove 0 3 2   # move values to new thread
    resume -1, 1    # call it first time
    pushstatus
    xmove 3 0 0   # move results back to stack
    setglobal X    # result
    setglobal Y    # status
    pushvalue 2     # push body (to call it again)
    pushstring 'b b b'
    xmove 0 3 2
    resume -1, 1    # call it again
    pushstatus
    xmove 3 0 0
    return 1        # return result
  """, func (...) {

    return(...)
  }) == 'b b b')

  assert((X == 'a a a') && (Y == 'OK'))

  set X, Y = nil

  ;; resuming running coroutine
  set C = coroutine.create(func () {
    return(T.testC("""                 pushnum 10;
                 pushnum 20;
                 resume -3 2;
                 pushstatus
                 gettop;
                 return 3""", C))
  })
  var a, b, c, d = coroutine.resume(C)
  assert((a == true) && string.find(b, "non%-suspended") && (c == "ERRRUN") && (d == 4))

  set a, b, c, d = T.testC("""    rawgeti R !M    # get main thread
    pushnum 10;
    pushnum 20;
    resume -3 2;
    pushstatus
    gettop;
    return 4""")
  assert((a == coroutine.running()) && string.find(b, "non%-suspended") && (c == "ERRRUN") && (d == 4))

  ;; using a main thread as a coroutine  (dubious use!)
  val state = T.newstate()

  ;; check that yielddable is working correctly
  assert(T.testC(state, "newthread; isyieldable -1; remove 1; return 1"))

  ;; main thread is not yieldable
  assert(!T.testC(state, "rawgeti R !M; isyieldable -1; remove 1; return 1"))

  T.testC(state, "settop 0")

  T.loadlib(state, 3, 4)  ;; load _G and 'package', preload 'coroutine'

  assert(T.doremote(state, """    set coroutine = require('coroutine');
    set X = func (x) { coroutine.yield(x, 'BB'); 'CC' };
    'ok'"""))

  val t = table.pack(T.testC(state, """    rawgeti R !M     # get main thread
    pushstring 'XX'
    getglobal X    # get function for body
    pushstring AA      # arg
    resume 1 1      # 'resume' shadows previous stack!
    gettop
    setglobal T    # top
    setglobal B    # second yielded value
    setglobal A    # fist yielded value
    rawgeti R !M     # get main thread
    pushnum 5       # arg (noise)
    resume 1 1      # after coroutine ends, previous stack is back
    pushstatus
    return *
  """))
  assert((t.n == 4) && (t@(2) == 'XX') && (t@(3) == 'CC') && (t@(4) == 'OK'))
  assert(T.doremote(state, "T") == '2')
  assert(T.doremote(state, "A") == 'AA')
  assert(T.doremote(state, "B") == 'BB')

  T.closestate(state)

  print('+')
}

;; leaving a pending coroutine open
set _G.TO_SURVIVE = coroutine.wrap(func () {
  var a = 10
  val func x () {
    set a = a + 1
  }
  coroutine.yield()
})

_G.TO_SURVIVE()

if !_soft {
  ;; bug (stack overflow)
  val lim = 1000000  ;; stack limit; assume 32-bit machine
  val t = [lim - 10, lim - 5, lim - 1, lim, lim + 1, lim + 5]
  loop i in (1, #t) {
    val j = t@(i)
    val co = coroutine.create(func () {
      return(table.unpack([], 1, j))
    })
    val r, msg = coroutine.resume(co)
    ;; must fail for unpacking larger than stack limit
    assert((j < lim) || !r)
  }
}

assert(coroutine.running() == main)

print("+")

print("testing yields inside metamethods")

val func val_ (x) {
  if type(x) == "table" {
    return(x.x)
  } else {
    return(x)
  }
}

val mt = [__eq=func (a, b) {
  coroutine.yield(nil, "eq")
  return(val_(a) == val_(b))
}, __lt=func (a, b) {
  coroutine.yield(nil, "lt")
  return(val_(a) < val_(b))
}, __le=func (a, b) {
  coroutine.yield(nil, "le")
  return((a - b) <= 0)
}, __add=func (a, b) {
  coroutine.yield(nil, "add")
  return(val_(a) + val_(b))
}, __sub=func (a, b) {
  coroutine.yield(nil, "sub")
  return(val_(a) - val_(b))
}, __mul=func (a, b) {
  coroutine.yield(nil, "mul")
  return(val_(a) * val_(b))
}, __div=func (a, b) {
  coroutine.yield(nil, "div")
  return(val_(a) / val_(b))
}, __idiv=func (a, b) {
  coroutine.yield(nil, "idiv")
  return(val_(a) // val_(b))
}, __pow=func (a, b) {
  coroutine.yield(nil, "pow")
  return(val_(a) ** val_(b))
}, __mod=func (a, b) {
  coroutine.yield(nil, "mod")
  return(val_(a) % val_(b))
}, __unm=func (a, b) {
  coroutine.yield(nil, "unm")
  return(-val_(a))
}, __concat=func (a, b) {

  coroutine.yield(nil, "concat")
  return(val_(a) ++ val_(b))
}, __index=func (t, k) {
  coroutine.yield(nil, "idx")
  return(t.k@(k))
}, __newindex=func (t, k, v) {
  coroutine.yield(nil, "nidx")
  set t.k@(k) = v
}]

val func new (x) {
  return(setmetatable([x=x, k=[]], mt))
}

var a = new(10)
var b = new(12)
var c = new("hello")

val func run (f, t) {
  var i = 1
  val c = coroutine.wrap(f)
  loop {
    while(true)
    val res, stat = c()
    if res {
      assert(t@(i) == undef)
      return(res, t)
    }
    assert(stat == t@(i))
    set i = i + 1
  }
}

assert(run(func () {
  if (a >= b) {
    return('>=')
  } else {
    return('<')
  }
}, ["le", "sub"]) == "<")
assert(run(func () {
  if (a <= b) {
    return('<=')
  } else {
    return('>')
  }
}, ["le", "sub"]) == "<=")
assert(run(func () {
  if (a == b) {
    return('==')
  } else {
    return('~=')
  }
}, ["eq"]) == "~=")


assert(run(func () {
  return(1 + a)
}, ["add"]) == 11)
assert(run(func () {
  return(a - 25)
}, ["sub"]) == -15)
assert(run(func () {
  return(2 * a)
}, ["mul"]) == 20)
assert(run(func () {
  return(a ** 2)
}, ["pow"]) == 100)
assert(run(func () {
  return(a / 2)
}, ["div"]) == 5)
assert(run(func () {
  return(a % 6)
}, ["mod"]) == 4)
assert(run(func () {
  return(a // 3)
}, ["idiv"]) == 3)

assert(run(func () {
  return(a + b)
}, ["add"]) == 22)
assert(run(func () {
  return(a - b)
}, ["sub"]) == -2)
assert(run(func () {
  return(a * b)
}, ["mul"]) == 120)
assert(run(func () {
  return(a ** b)
}, ["pow"]) == (10 ** 12))
assert(run(func () {
  return(a / b)
}, ["div"]) == (10 / 12))
assert(run(func () {
  return(a % b)
}, ["mod"]) == 10)
assert(run(func () {
  return(a // b)
}, ["idiv"]) == 0)

;; repeat tests with larger constants (to use 'K' opcodes)
val a1000 = new(1000)

assert(run(func () {
  return(a1000 + 1000)
}, ["add"]) == 2000)
assert(run(func () {
  return(a1000 - 25000)
}, ["sub"]) == -24000)
assert(run(func () {
  return(2000 * a)
}, ["mul"]) == 20000)
assert(run(func () {
  return(a1000 / 1000)
}, ["div"]) == 1)
assert(run(func () {
  return(a1000 % 600)
}, ["mod"]) == 400)
assert(run(func () {
  return(a1000 // 500)
}, ["idiv"]) == 2)

assert(run(func () {
  return(a % b)
}, ["mod"]) == 10)


assert(run(func () {
  return(a ++ b)
}, ["concat"]) == "1012")

assert(run(func () {
  return(a ++ (b ++ (c ++ a)))
}, ["concat", "concat", "concat"]) == "1012hello10")

assert(run(func () {
  return("a" ++ ("b" ++ (a ++ ("c" ++ (c ++ (b ++ "x"))))))
}, ["concat", "concat", "concat"]) == "ab10chello12x")

do {  ;; a few more tests for comparison operators
  val mt1 = [__le=func (a, b) {

    coroutine.yield(10)
    return((val_(a) <= val_(b)))
  }, __lt=func (a, b) {

    coroutine.yield(10)
    return(val_(a) < val_(b))
  }]
  val mt2 = [__lt=mt1.__lt, __le=mt1.__le]

  val func run (f) {
    val co = coroutine.wrap(f)
    var res
    loop {
      set res = co()
      until(res != 10)
    }
    return(res)
  }

  val func test_ () {
    val a1 = setmetatable([x=1], mt1)
    val a2 = setmetatable([x=2], mt2)
    assert(a1 < a2)
    assert(a1 <= a2)
    assert(1 < a2)
    assert(1 <= a2)
    assert(2 > a1)
    assert(2 >= a2)
    return(true)
  }

  run(test_)
}

