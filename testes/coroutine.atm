;; tests for coroutine API
if T == nil {
  (Message || print)('\n >>> testC not active: skipping coroutine API tests <<<\n')
  print("OK")
  return()
}

print('testing coroutine API')

val func apico (...) {
  val x = [...]
  return(coroutine.wrap(func () {
    return(T.testC(table.unpack(x)))
  }))
}

var a = [apico("""  pushstring errorcode
  pcallk 1 0 2;
  invalid command (should not arrive here)
""", """return *""", "stackmark", error)()]
assert((#a == 4) && (a@(3) == "stackmark") && (a@(4) == "errorcode") && (_G.status == "ERRRUN") && (_G.ctx == 2))  ;; 'ctx' to pcallk

var co = apico("pushvalue 2; pushnum 10; pcallk 1 2 3; invalid command;", coroutine.yield, "getglobal status; getglobal ctx; pushvalue 2; pushstring a; pcallk 1 0 4; invalid command", "getglobal status; getglobal ctx; return *")

assert(co() == 10)
assert(co(20, 30) == 'a')
set a = [co()]
assert((#a == 10) && (a@(2) == coroutine.yield) && (a@(5) == 20) && (a@(6) == 30) && (a@(7) == "YIELD") && (a@(8) == 3) && (a@(9) == "YIELD") && (a@(10) == 4))
assert(!pcall(co))  ;; coroutine is dead now

set f = T.makeCfunc("pushnum 3; pushnum 5; yield 1;")
set co = coroutine.wrap(func () {
  assert(f() == 23)
  assert(f() == 23)
  return(10)
})
assert(co(23, 16) == 5)
assert(co(23, 16) == 5)
assert(co(23, 16) == 10)

;; testing coroutines with C bodies
set f = T.makeCfunc("""        pushnum 102
	yieldk	1 U2
	cannot be here!
""", """      # continuation
	pushvalue U3   # accessing upvalues inside a continuation
        pushvalue U4
	return *
""", 23, "huu")

do {  ;; testing bug introduced in commit f407b3c4a
  var X = false  ;; flag "to be closed"
  val coro = coroutine.wrap(T.testC)
  ;; runs it until 'pcallk' (that yields)
  ;; 4th argument (at index 4): object to be closed
  val res1, res2 = coro("""      toclose 3   # this could break the next 'pcallk'
      pushvalue 2   # push function 'yield' to call it
      pushint 22; pushint 33    # arguments to yield
      # calls 'yield' (2 args; 2 results; continuation function at index 4)
      pcallk 2 2 4
      invalid command (should not arrive here)
    """, coroutine.yield, func2close(func () {

    ;; 1st argument (at index 1): code;
    ;; (at index 2): function to be called
    set X = true  ;; (index 3): TBC slot
  }), "pushint 43; return 3")
  ;; (index 4): code for continuation function

  assert((res1 == 22) && (res2 == 33) && !X)
  val res1, res2, res3 = coro(34, "hi")  ;; runs continuation function
  assert((res1 == 34) && (res2 == "hi") && (res3 == 43) && X)
}

set x = coroutine.wrap(f)
assert(x() == 102)
eqtab([x()], [23, "huu"])

set f = T.makeCfunc("""pushstring 'a'; pushnum 102; yield 2; """)

set a, b, c, d = T.testC("""newthread; pushvalue 2; xmove 0 3 1; resume 3 0;
                       pushstatus; xmove 3 0 0;  resume 3 0; pushstatus;
                       return 4; """, f)

assert((a == 'YIELD') && (b == 'a') && (c == 102) && (d == 'OK'))

;; testing chain of suspendable C calls

var count = 3  ;; number of levels

set f = T.makeCfunc("""  remove 1;             # remove argument
  pushvalue U3;         # get selection function
  call 0 1;             # call it  (result is 'f' or 'yield')
  pushstring hello      # single argument for selected function
  pushupvalueindex 2;   # index of continuation program
  callk 1 -1 .;		# call selected function
  errorerror		# should never arrive here
""", """  # continuation program
  pushnum 34	# return value
  return *     # return all results
""", func () {

  ;; selection function
  set count = count - 1
  if count == 0 {
    return(coroutine.yield)
  } else {
    return(f)
  }
})

set co = coroutine.wrap(func () {
  return(f(nil))
})
assert(co() == "hello")  ;; argument to 'yield'
set a = [co()]
;; three '34's (one from each pending C call)
assert((#a == 3) && (a@(1) == a@(2)) && (a@(2) == a@(3)) && (a@(3) == 34))

;; testing yields with continuations

var y

set co = coroutine.wrap(func (...) {
  return(T.testC(""" # initial function
          yieldk 1 2
          cannot be here!
       """, """  # 1st continuation
         yieldk 0 3
         cannot be here!
       """, """  # 2nd continuation
         yieldk 0 4
         cannot be here!
       """, """  # 3th continuation
          pushvalue 6   # function which is last arg. to 'testC' here
          pushnum 10; pushnum 20;
          pcall 2 0 0   # call should throw an error and return to next line
          pop 1		# remove error message
          pushvalue 6
          getglobal status; getglobal ctx
          pcallk 2 2 5  # call should throw an error and jump to continuation
          cannot be here!
       """, """  # 4th (and last) continuation
         return *
       """, func (a, b) {

    ;; function called by 3th continuation
    set x = a
    set y = b
    error("errmsg")
  }, ...))
})

var a = [co(3, 4, 6)]
assert((a@(1) == 6) && (a@(2) == undef))
set a = [co()]
assert((a@(1) == undef) && (_G.status == "YIELD") && (_G.ctx == 2))
set a = [co()]
assert((a@(1) == undef) && (_G.status == "YIELD") && (_G.ctx == 3))
set a = [co(7, 8)]
;; original arguments
assert((type(a@(1)) == 'string') && (type(a@(2)) == 'string') && (type(a@(3)) == 'string') && (type(a@(4)) == 'string') && (type(a@(5)) == 'string') && (type(a@(6)) == 'function'))
;; arguments left from fist resume
assert((a@(7) == 3) && (a@(8) == 4))
;; arguments to last resume
assert((a@(9) == 7) && (a@(10) == 8))
;; error message and nothing more
assert(a@(11)::find("errmsg") && (#a == 11))
;; check arguments to pcallk
assert((x == "YIELD") && (y == 4))

assert(!pcall(co))  ;; coroutine should be dead

set _G.ctx = nil
set _G.status = nil

;; bug in nCcalls
val co = coroutine.wrap(func () {
  val a = [pcall(pcall, pcall, pcall, pcall, pcall, pcall, pcall, error, "hi")]
  return(pcall(assert, table.unpack(a)))
})

val a = [co()]
assert(a@(10) == "hi")

print('OK')
