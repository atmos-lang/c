do {  ;; test warning for locals
  RUN('echo "  		val x" | lua -i > %s 2>&1', out)
  assert(string.find(getoutput(), "warning: "))

  RUN('echo "set local1 = 10\nlocal1 + 3" | lua -i > %s 2>&1', out)
  val t = getoutput()
