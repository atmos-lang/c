;; test LUA_INIT for files
prepfile("set x = x || 10; print(x); set x = x + 1")
RUN('env LUA_INIT="@%s" lua %s > %s', prog, prog, out)
checkout("10\n11\n")

;; test errors in LUA_INIT
NoRun('LUA_INIT:1: msg', 'env LUA_INIT="error(\'msg\')" lua')

print("testing option '-E'")

var defaultpath, defaultCpath

do {
  prepfile("print(package.path, package.cpath)")
  RUN('env LUA_INIT="error(10)" LUA_PATH=xxx LUA_CPATH=xxx lua -E %s > %s', prog, out)
  val output = getoutput()
  set defaultpath = string.match(output, "^(.-)\t")
  set defaultCpath = string.match(output, "\t(.-)$")

  ;; running with an empty environment
  RUN('env -i lua %s > %s', prog, out)
  val out = getoutput()
  assert(defaultpath == string.match(output, "^(.-)\t"))
  assert(defaultCpath == string.match(output, "\t(.-)$"))
}

;; paths did not change
assert(!string.find(defaultpath, "xxx") && string.find(defaultpath, "lua") && !string.find(defaultCpath, "xxx") && string.find(defaultCpath, "lua"))

;; (LUA_READLINELIB was introduced in 5.5.1)
if release >= "5.5.1" {
  ;; OBS: this test is not valid when Lua is compiled with LUA_USE_READLINE
  print("testing readline library name")
  ;; should generate a warning when trying to load inexistent library "xuxu"
  val env = '''LUA_READLINELIB=xuxu LUA_INIT="warn('@allow')"'''
  val code = 'echo " " | env %s lua %s -W -i >%s 2>&1'
  RUN(code, env, "", out)  ;; run code with no extra options
  if (!string.find(getoutput(), "warning: unable to load readline library 'xuxu'")) {

    error("Is Lua compiled with option LUA_USE_READLINE?")
  }
  RUN(code, env, "-E", out)  ;; run again with option -E
  ;; no warning when LUA_READLINELIB is to be ignored
  assert(!string.find(getoutput(), "warning"))
}

;; test replacement of ';;' to default path
val func convert (p) {
  prepfile("print(package.path)")
  RUN('env LUA_PATH="%s" lua %s > %s', p, prog, out)
  var expected = getoutput()
  set expected = string.sub(expected, 1, -2)  ;; cut final end of line
  if string.find(p, ";;") {
    set p = string.gsub(p, ";;", ";" ++ (defaultpath ++ ";"))
    set p = string.gsub(p, "^;", "")  ;; remove ';' at the beginning
    set p = string.gsub(p, ";$", "")  ;; remove ';' at the end
  }
  assert(p == expected)
}

convert(";")
convert(";;")
convert("a;;b")
convert(";;b")
convert("a;;")
convert("a;b;;c")

