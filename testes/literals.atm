print('+')
set _G.x = nil
dostring(prog)
assert(x)
set _G.x = nil

do {  ;; reuse of long strings

  ;; get the address of a string
  val func getadd (s) {
    return(string.format("%p", s))
  }

  val s1 = "01234567890123456789012345678901234567890123456789"
  val s2 = "01234567890123456789012345678901234567890123456789"
  val s3 = "01234567890123456789012345678901234567890123456789"
  val func foo () {
    return(s1)
  }
  val func foo1 () {
    return(s3)
  }
  val func foo2 () {
    return("01234567890123456789012345678901234567890123456789")
  }
  val a1 = getadd(s1)
  assert(a1 == getadd(s2))
  assert(a1 == getadd(foo()))
  assert(a1 == getadd(foo1()))
  assert(a1 == getadd(foo2()))

  val sd = "0123456789" ++ "0123456789012345678901234567890123456789"
  assert((sd == s1) && (getadd(sd) != a1))
}

;; testing line ends
set prog = '''val a = 1        ;; a comment
val b = 2


set x = """
hi
"""
set y = "\
hello\r\n\
"
require("debug").getinfo(1).currentline
'''

loop _, n in pairs(["\n", "\r", "\n\r", "\r\n"]) {
  val prog, nn = string.gsub(prog, "\n", n)
  assert(dostring(prog) == nn)
  assert((_G.x == "hi\n") && (_G.y == "\nhello\r\n\n"))
}
set _G.x, _G.y = nil

;; testing comments and strings with quotes
var a = """]="""
assert(a == "]=")

set a = """[===[[=[]]=][====[]]===]==="""
assert(a == "[===[[=[]]=][====[]]===]===")

set a = '''"[===[[=[]]=][====[]]===]===" ""'''
assert(a == '"[===[[=[]]=][====[]]===]===" ""')

set a = """]]]]]]]]"""
assert(a == "]]]]]]]]")

set a = '''""'''
assert(a == '""')

;;;
x y z [==[ blu foo
]==
]
]=]==]
error error]=;;;

;; generate all strings of four of these chars
val x = [string.char(61), string.char(91), string.char(93), "\n", string.char(39), string.char(34), " "]  ;; = [ ] \n ' " space
val len = 4
var gen
set gen = func (c, n) {
  if n == 0 {
    coroutine.yield(c)
  } else {
    loop _, a in pairs(x) {
      gen(c ++ a, n - 1)
    }
  }
}

loop s in coroutine.wrap(func () {
  gen("", len)
}) {
  if !string.find(s, q3, 1, true) && !string.find(s, "'$") {
    assert(s == load(q3 ++ ("\n" ++ (s ++ q3)), "")())
  }
  if !string.find(s, d3, 1, true) && !string.find(s, '"$') {
    assert(s == load(d3 ++ ("\n" ++ (s ++ d3)), "")())
  }
}

;; testing decimal point locale
if os.setlocale("pt_BR") || os.setlocale("ptb") {
  assert((tonumber("3,4") == 3.4) && (tonumber("3.4") == 3.4))
  assert(tonumber("  -.4  ") == -0.4)
  assert(tonumber("  +0x.41  ") == 0X0.41)
  assert(!load("set a = 3,4"))
  assert(assert(load("3.4"))() == 3.4)
  assert(assert(load("(0.4, 3)"))() == 0.4)
  assert(assert(load("4."))() == 4.)
  assert(assert(load("4. + 0.5"))() == 4.5)

  assert((" 0x.1 " + " 0x,1" + "-0X.1\t") == 0x0.1)

  assert(!tonumber("inf") && !tonumber("NAN"))

  assert(assert(load(string.format("%q", 4.51)))() == 4.51)

  val a, b = load("4.5.")
  assert(string.find(b, "'4%.5%.'"))

  assert(os.setlocale("C"))
} else {
  (Message || print)('\n >>> pt_BR locale not available: skipping decimal point tests <<<\n')
}

;; testing %q x line ends
val s = "a string with \r and \n and \r\n and \n\r"
val c = string.format("%q", s)
assert(assert(load(c))() == s)

;; testing errors
assert(!load("set a = 'non-ending string"))
assert(!load("set a = 'non-ending string\n'"))
assert(!load("set a = '\\345'"))
assert(!load("set a = " ++ (q3 ++ "x''")))

val func malformednum (n, exp) {
  val s, msg = load("(" ++ n)
  assert(!s && string.find(msg, exp))
}

malformednum("0xe-", "near <eof>")
malformednum("0xep-p", "malformed number")
malformednum("1print()", "malformed number")

print('OK')
