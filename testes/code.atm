do {  ;; tests for table access in upvalues
  val t
  check(func () {
    set t@(kx) = t.y
  }, 'GETTABUP', 'SETTABUP')
  check(func (a) {
    set t@(a()) = t@(a())
  }, 'MOVE', 'CALL', 'GETUPVAL', 'MOVE', 'CALL', 'GETUPVAL', 'GETTABLE', 'SETTABLE')
}

;; de morgan
checkequal(func () {
  var a, b
  if !(a || b) {
    set b = a
  }
}, func () {
  var a, b
  if (!a && !b) {
    set b = a
  }
})

checkequal(func (l) {
  val a
  return((0 <= a) && (a <= l))
}, func (l) {
  val a
  return(!(!(a >= 0) || !(a <= l)))
})

check(func (a, b) {
  loop {
    while(a)
    if b {
      break()
    } else {
      set a = a + 1
    }
  }
}, 'TEST', 'JMP', 'TEST', 'JMP', 'JMP', 'CLOSE', 'JMP', 'ADDI', 'MMBINI', 'JMP', 'RETURN0')

;; (Lua: 'goto exit' before/after a to-be-closed variable:
;;  'JMP', 'CLOSE', 'LOADNIL', 'TBC', 'CLOSE', 'JMP', 'CLOSE', 'RETURN')

checkequal(func () {
  return(6 || true || nil)
}, func () {
  return(k6 || kTrue || kNil)
})

checkequal(func () {
  return((6 && true) || nil)
}, func () {
  return((k6 && kTrue) || kNil)
})

do {  ;; string constants
  val k0 = "00000000000000000000000000000000000000000000000000"
  val func f1 () {
    val k = k0
    return(func () {
      return(func () {
        return(k)
      })
    })
  }

  val f2 = f1()
  val f3 = f2()
  assert(f3() == k0)
  checkK(f3, k0)
  ;; string is not needed by other functions
  assert(T.listk(f1)@(1) == nil)
  assert(T.listk(f2)@(1) == nil)
}

do {  ;; check number of available registers
  ;; 1 register for local + 1 for function + 252 arguments
  var source = "val a; a(" ++ (string.rep("a, ", 252) ++ "a)")
  val prog = T.listcode(assert(load(source)))
  ;; maximum valid register is 254
  loop i in (1, 254) {
    assert(string.find(prog@(2 + i), "MOVE%s*" ++ i))
  }
  ;; one more argument would need register #255 (but that is reserved)
  set source = "val a; a(" ++ (string.rep("a, ", 253) ++ "a)")
  val _, msg = load(source)
  assert(string.find(msg, "too many registers"))
}

do {  ;; basic check for SETLIST
  ;; create a list constructor with 50 elements
  val source = "val a; [" ++ (string.rep("a, ", 50) ++ "]")
  val func_ = assert(load(source))
  val code = table.concat(T.listcode(func_), "\n")
  val _, count = string.gsub(code, "SETLIST", "")
  ;; code uses only 1 SETLIST for the constructor
  assert(count == 1)
}

do {
  print("testing code for integer limits")
  val func checkints (n) {
    val source = string.format("val a = [@(true) = 0X%x]; a@(true)", n)
    var f = assert(load(source))
    checkKlist(f, [n])
    assert(f() == n)
    set f = load(string.dump(f))
    assert(f() == n)
  }

  checkints(math.maxinteger)
  checkints(math.mininteger)
  checkints(-1)
}

print('OK')
