;; (global *)

if T == nil {
  (Message || print)('\n >>> testC not active: skipping opcode tests <<<\n')
  return()
}
print("testing code generation and optimizations")

;; to test constant propagation
val k0aux = 0
val k0 = k0aux
val k1 = 1
val k3 = 3
val k6 = k3 + k3
val kFF0 = 0xFF0
val k3_78 = 3.78
val x, k3_78_4 = (10, k3_78 / 4)
assert(x == 10)

val kx = "x"

val kTrue = true
val kFalse = false

val kNil = nil

;; this code gave an error for the code checker
do {
  val func f (a) {
    loop k, v, w in a {
    }
  }
}

;; testing reuse in constant table
val func checkKlist (func_, list) {
  val k = T.listk(func_)
  assert(#k == #list)
  loop i in (1, #k) {
    assert((k@(i) == list@(i)) && (math.type(k@(i)) == math.type(list@(i))))
  }
}

var foo
set foo = func () {
  var a
  set a = k3
  set a = 0
  set a = 0.0
  set a = -7 + 7
  set a = k3_78 / 4
  set a = k3_78_4
  set a = -k3_78 / 4
  set a = k3_78 / 4
  set a = -3.78 / 4
  set a = -3.79 / 4
  set a = 0.0
  set a = -0
  set a = k3
  set a = 3.0
  set a = 3
  set a = 3.0
}

checkKlist(foo, [3.78 / 4, -3.78 / 4, -3.79 / 4])

set foo = func (f, a) {
  f(100 * 1000)
  f(100.0 * 1000)
  f(-100 * 1000)
  f(-100 * 1000.0)
  f(100000)
  f(100000.0)
  f(-100000)
  f(-100000.0)
}

checkKlist(foo, [100000, 100000.0, -100000, -100000.0])

;; floats x integers
set foo = func (t, a) {
  set t@(a) = 1
  set t@(a) = 1.0
  set t@(a) = 1
  set t@(a) = 1.0
  set t@(a) = 2
  set t@(a) = 2.0
  set t@(a) = 0
  set t@(a) = 0.0
  set t@(a) = 1
  set t@(a) = 1.0
  set t@(a) = 2
  set t@(a) = 2.0
  set t@(a) = 0
  set t@(a) = 0.0
}

checkKlist(foo, [1, 1.0, 2, 2.0, 0, 0.0])

;; testing opcodes

;; check that 'f' opcodes match '...'
val func check (f, ...) {
  val arg = [...]
  val c = T.listcode(f)
  loop i in (1, #arg) {
    val opcode = string.match(c@(i), "%u%w+")
    ;; print(arg[i], opcode)
    assert(arg@(i) == opcode)
  }
  assert(c@(#arg + 2) == undef)
}

;; check that 'f' opcodes match '...' and that 'f(p) == r'.
val func checkR (f, p, r, ...) {
  val r1 = f(p)
  assert((r == r1) && (math.type(r) == math.type(r1)))
  check(f, ...)
}

;; check that 'a' and 'b' has the same opcodes
val func checkequal (a, b) {
  set a = T.listcode(a)
  set b = T.listcode(b)
  assert(#a == #b)
  loop i in (1, #a) {
    set a@(i) = string.gsub(a@(i), '%b()', '')  ;; remove line number
    set b@(i) = string.gsub(b@(i), '%b()', '')  ;; remove line number
    assert(a@(i) == b@(i))
  }
}

;; some basic instructions
check(func () {
  ;; function does not create upvalues
  (func () {})([f()])
}, 'CLOSURE', 'NEWTABLE', 'EXTRAARG', 'GETTABUP', 'CALL', 'SETLIST', 'CALL', 'RETURN0')

check(func (x) {
  ;; function creates upvalues
  (func () {
    return(x)
  })([f()])
}, 'CLOSURE', 'NEWTABLE', 'EXTRAARG', 'GETTABUP', 'CALL', 'SETLIST', 'CALL', 'RETURN')

;; sequence of LOADNILs
check(func () {
  val kNil = nil
  var a, b, c
  var d
  val e
  val f, g, h
  set d = nil
  set d = nil
  set b = nil
  set a = kNil
  set c = nil
}, 'LOADNIL', 'RETURN0')

check(func () {
  var a, b, c, d = (1, 1, 1, 1)
  set d = nil
  set c = nil
  set b = nil
  set a = nil
}, 'LOADI', 'LOADI', 'LOADI', 'LOADI', 'LOADNIL', 'RETURN0')

do {
  var a, b, c, d = (1, 1, 1, 1)
  set d = nil
  set c = nil
  set b = nil
  set a = nil
  assert((a == nil) && (b == nil) && (c == nil) && (d == nil))
}

;; single return
check(func (a, b, c) {
  return(a)
}, 'RETURN1')

;; infinite loops
check(func () {
  loop {
    while(kTrue)
    val a = -1
  }
}, 'LOADI', 'JMP', 'RETURN0')

check(func () {
  loop {
    while(1)
    val a = -1
  }
}, 'LOADI', 'JMP', 'RETURN0')

check(func () {
  loop {
    val x = 1
    until(true)
  }
}, 'LOADI', 'RETURN0')

;; concat optimization
check(func (a, b, c, d) {
  return(a ++ (b ++ (c ++ d)))
}, 'MOVE', 'MOVE', 'MOVE', 'MOVE', 'CONCAT', 'RETURN1')

;; not
check(func () {
  return(!!nil)
}, 'LOADFALSE', 'RETURN1')
check(func () {
  return(!!kFalse)
}, 'LOADFALSE', 'RETURN1')
check(func () {
  return(!!true)
}, 'LOADTRUE', 'RETURN1')
check(func () {
  return(!!k3)
}, 'LOADTRUE', 'RETURN1')

;; direct access to locals
check(func () {
  var a, b, c, d
  set a = b * a
  set c.x, a@(b) = (-(((a + (d / b)) - a@(b)) ** a.x), b)
}, 'LOADNIL', 'MUL', 'MMBIN', 'DIV', 'MMBIN', 'ADD', 'MMBIN', 'GETTABLE', 'SUB', 'MMBIN', 'GETFIELD', 'POW', 'MMBIN', 'UNM', 'SETTABLE', 'SETFIELD', 'RETURN0')

;; direct access to constants
check(func () {
  val a, b
  val c = kNil
  set a@(kx) = 3.2
  set a.x = b
  set a@(b) = 'x'
}, 'LOADNIL', 'SETFIELD', 'SETFIELD', 'SETTABLE', 'RETURN0')

;; "get/set table" with numeric indices
check(func (a) {
  val k255 = 255
  set a@(1) = a@(100)
  set a@(k255) = a@(256)
  set a@(256) = 5
}, 'GETI', 'SETI', 'LOADI', 'GETTABLE', 'SETI', 'LOADI', 'SETTABLE', 'RETURN0')

check(func () {
  var a, b
  set a = a - a
  set b = a / a
  set b = 5 - 4
}, 'LOADNIL', 'SUB', 'MMBIN', 'DIV', 'MMBIN', 'LOADI', 'RETURN0')

check(func () {
  val a, b
  set a@(kTrue) = false
}, 'LOADNIL', 'LOADTRUE', 'SETTABLE', 'RETURN0')

;; equalities
checkR(func (a) {
  if a == 1 {
    return(2)
  }
}, 1, 2, 'EQI', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if -4.0 == a {
    return(2)
  }
}, -4, 2, 'EQI', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if a == "hi" {
    return(2)
  }
}, 10, nil, 'EQK', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if a == 10000 {
    return(2)
  }
}, 1, nil, 'EQK', 'JMP', 'LOADI', 'RETURN1')  ;; number too large

checkR(func (a) {
  if -10000 == a {
    return(2)
  }
}, -10000, 2, 'EQK', 'JMP', 'LOADI', 'RETURN1')  ;; number too large

;; comparisons

checkR(func (a) {
  if -10 <= a {
    return(2)
  }
}, -10, 2, 'GEI', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if 128.0 > a {
    return(2)
  }
}, 129, nil, 'LTI', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if -127.0 < a {
    return(2)
  }
}, -127, nil, 'GTI', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if 10 < a {
    return(2)
  }
}, 11, 2, 'GTI', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if 129 < a {
    return(2)
  }
}, 130, 2, 'LOADI', 'LT', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if a >= 23.0 {
    return(2)
  }
}, 25, 2, 'GEI', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if a >= 23.1 {
    return(2)
  }
}, 0, nil, 'LOADK', 'LE', 'JMP', 'LOADI', 'RETURN1')

checkR(func (a) {
  if a > 2300.0 {
    return(2)
  }
}, 0, nil, 'LOADF', 'LT', 'JMP', 'LOADI', 'RETURN1')

;; constant folding
val func checkK (func_, val_) {
  check(func_, 'LOADK', 'RETURN1')
  checkKlist(func_, [val_])
  assert(func_() == val_)
}

val func checkI (func_, val_) {
  check(func_, 'LOADI', 'RETURN1')
  checkKlist(func_, [])
  assert(func_() == val_)
}

val func checkF (func_, val_) {
  check(func_, 'LOADF', 'RETURN1')
  checkKlist(func_, [])
  assert(func_() == val_)
}

checkF(func () {
  return(0.0)
}, 0.0)
checkI(func () {
  return(k0)
}, 0)
checkI(func () {
  return(-k0 // 1)
}, 0)
checkK(func () {
  return(3 ** -1)
}, 1 / 3)
checkK(func () {
  return((1 + 1) ** (50 + 50))
}, 2 ** 100)
checkK(func () {
  return((-2) ** (31 - 2))
}, -0x20000000 + 0.0)
checkF(func () {
  return((-(k3 ** 0) + 5) // 3.0)
}, 1.0)
checkI(func () {
  return(-k3 % 5)
}, 2)
checkF(func () {
  return(((-(((2.0 ** 8) + -(-1)) % 8) / 2) * 4) - 3)
}, -5.0)
checkF(func () {
  return(((-(((2 ** 8) + -(-1)) % 8) // 2) * 4) - 3)
}, -7.0)

;; borders around MAXARG_sBx ((((1 << 17) - 1) >> 1) == 65535)
var a = 17  ;; avoid folding
val sbx = (math.tointeger(2 ** a) // 2) - 1
val border = 65535
checkI(func () {
  return(border)
}, sbx)
checkI(func () {
  return(-border)
}, -sbx)
checkI(func () {
  return(border + 1)
}, sbx + 1)
checkK(func () {
  return(border + 2)
}, sbx + 2)
checkK(func () {
  return(-(border + 1))
}, -(sbx + 1))

val border = 65535.0
checkF(func () {
  return(border)
}, sbx + 0.0)
checkF(func () {
  return(-border)
}, -sbx + 0.0)
checkF(func () {
  return(border + 1)
}, (sbx + 1.0))
checkK(func () {
  return(border + 2)
}, (sbx + 2.0))
checkK(func () {
  return(-(border + 1))
}, -(sbx + 1.0))

;; immediate operands
checkR(func (x) {
  return(x + k1)
}, 10, 11, 'ADDI', 'MMBINI', 'RETURN1')
checkR(func (x) {
  return(x - 127)
}, 10, -117, 'ADDI', 'MMBINI', 'RETURN1')
checkR(func (x) {
  return(128 + x)
}, 0.0, 128.0, 'ADDI', 'MMBINI', 'RETURN1')
checkR(func (x) {
  return(x * -127)
}, -1.0, 127.0, 'MULK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(20 * x)
}, 2, 40, 'MULK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(x ** -2)
}, 2, 0.25, 'POWK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(x / 40)
}, 40, 1.0, 'DIVK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(x // 1)
}, 10.0, 10.0, 'IDIVK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(x % (100 - 10))
}, 91, 1, 'MODK', 'MMBINK', 'RETURN1')

;; K operands in arithmetic operations
checkR(func (x) {
  return(x + 0.0)
}, 1, 1.0, 'ADDK', 'MMBINK', 'RETURN1')
;;  check(function (x) return 128 + x end, 'ADDK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(x * -10000)
}, 2, -20000, 'MULK', 'MMBINK', 'RETURN1')
;;  check(function (x) return 20 * x end, 'MULK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(x ** 0.5)
}, 4, 2.0, 'POWK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(x / 2.0)
}, 4, 2.0, 'DIVK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(x // 10000)
}, 10000, 1, 'IDIVK', 'MMBINK', 'RETURN1')
checkR(func (x) {
  return(x % (100.0 - 10))
}, 91, 1.0, 'MODK', 'MMBINK', 'RETURN1')

;; no foldings (and immediate operands)
check(func () {
  return(-0.0)
}, 'LOADF', 'UNM', 'RETURN1')
check(func () {
  return(k3 / 0)
}, 'LOADI', 'DIVK', 'MMBINK', 'RETURN1')
check(func () {
  return(0 % 0)
}, 'LOADI', 'MODK', 'MMBINK', 'RETURN1')
check(func () {
  return(-4 // 0)
}, 'LOADI', 'IDIVK', 'MMBINK', 'RETURN1')

;; basic 'for' loops
check(func () {
  loop i in (-10, 10.5) {
  }
}, 'LOADI', 'LOADK', 'LOADI', 'FORPREP', 'FORLOOP', 'RETURN0')
check(func () {
  loop i in (0xfffffff, 10.0, 1) {
  }
}, 'LOADK', 'LOADF', 'LOADI', 'FORPREP', 'FORLOOP', 'RETURN0')

;; bug in constant folding for 5.1
check(func () {
  return(-nil)
}, 'LOADNIL', 'UNM', 'RETURN1')

check(func () {
  var a, b, c
  set b@(c), a = (c, b)
  set b@(a), a = (c, b)
  set a, b = (c, a)
  set a = a
}, 'LOADNIL', 'MOVE', 'MOVE', 'SETTABLE', 'MOVE', 'MOVE', 'MOVE', 'SETTABLE', 'MOVE', 'MOVE', 'MOVE', 'RETURN0')
