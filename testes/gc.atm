;; create many threads with self-references and open upvalues
print("self-referenced threads")
var thread_id = 0
val threads = []

val func fn (thread_) {
  val x = []
  set threads@(thread_id) = func () {
    set thread_ = x
  }
  coroutine.yield()
}

loop {
  while(thread_id < 1000)
  val thread_ = coroutine.create(fn)
  coroutine.resume(thread_, thread_)
  set thread_id = thread_id + 1
}

;; Create a closure (function inside 'f') with an upvalue ('param') that
;; points (through a table) to the closure itself and to the thread
;; ('co' and the initial value of 'param') where closure is running.
;; Then, assert that table (and therefore everything else) will be
;; collected.
do {
  var collected = false  ;; to detect collection
  collectgarbage()
  collectgarbage("stop")
  do {
    var f
    set f = func (param) {
      (func () {
        assert((type(f) == 'function') && (type(param) == 'thread'))
        set param = [param, f]
        setmetatable(param, [__gc=func () {
          set collected = true
        }])
        coroutine.yield(100)
      })()
    }
    val co = coroutine.create(f)
    assert(coroutine.resume(co, co))
  }
  ;; Now, thread and closure are not reachable any more.
  collectgarbage()
  assert(collected)
  collectgarbage("restart")
}

do {
  collectgarbage()
  collectgarbage("stop")
  collectgarbage("step")  ;; steps should not unblock the collector
  val x = gcinfo()
  loop {
    loop i in (1, 1000) {  ;; no collection during the loop
      set _ENV.a = []
    }
    until(gcinfo() > (2 * x))
  }
  collectgarbage("restart")
  set _ENV.a = nil
}

if T {  ;; tests for weird cases collecting upvalues

  val func foo () {
    var a = [x=20]
    coroutine.yield(func () {
      return(a.x)  ;; will run collector
    })
    assert(a.x == 20)  ;; 'a' is 'ok'
    set a = [x=30]  ;; create a new object
    assert(T.gccolor(a) == "white")  ;; of course it is new...
    coroutine.yield(100)  ;; 'a' is still local to this thread
  }

  val t = setmetatable([], [__mode="kv"])
  collectgarbage()
  collectgarbage('stop')
  ;; create coroutine in a weak table, so it will never be marked
  set t.co = coroutine.wrap(foo)
  val f = t.co()  ;; create function to access local 'a'
  T.gcstate("enteratomic")  ;; ensure all objects are traversed
  assert(T.gcstate() == "enteratomic")
  assert(t.co() == 100)  ;; resume coroutine, creating new table for 'a'
  assert(T.gccolor(t.co) == "white")  ;; thread was not traversed
  T.gcstate("pause")  ;; collect thread, but should mark 'a' before that
  assert((t.co == nil) && (f() == 30))  ;; ensure correct access to 'a'

  collectgarbage("restart")

  ;; test barrier in sweep phase (backing userdata to gray)
  val u = T.newuserdata(0, 1)  ;; create a userdata
  collectgarbage()
  collectgarbage("stop")
  val a = []  ;; avoid 'u' as first element in 'allgc'
  T.gcstate("enteratomic")
  T.gcstate("sweepallgc")
  val x = []
  assert(T.gccolor(u) == "black")  ;; userdata is "old" (black)
  assert(T.gccolor(x) == "white")  ;; table is "new" (white)
  debug.setuservalue(u, x)  ;; trigger barrier
  assert(T.gccolor(u) == "gray")  ;; userdata changed back to gray
  collectgarbage("restart")

  print("+")
}

if T {
  val debug = require("debug")
  collectgarbage("stop")
  val x = T.newuserdata(0)
  val y = T.newuserdata(0)
  debug.setmetatable(y, [__gc=nop])  ;; bless the new udata before...
  debug.setmetatable(x, [__gc=nop])  ;; ...the old one
  assert(T.gccolor(y) == "white")
  T.checkmemory()
  collectgarbage("restart")
}

if T {
  collectgarbage("stop")
  T.gcstate("pause")
  val sup = [x=0]
  val a = setmetatable([], [__newindex=sup])
  T.gcstate("enteratomic")
  assert(T.gccolor(sup) == "black")
  set a.x = []  ;; should not break the invariant
  assert(!((T.gccolor(sup) == "black") && (T.gccolor(sup.x) == "white")))
  T.gcstate("pause")  ;; complete the GC cycle
  set sup.x.y = 10
  collectgarbage("restart")
}

if T {
  print("emergency collections")
  collectgarbage()
  collectgarbage()
  T.totalmem(T.totalmem() + 200)
  loop i in (1, 200) {
    val a = []
  }
  T.totalmem(0)
  collectgarbage()
  var t = T.totalmem("table")
  var a = [[], [], []]  ;; create 4 new tables
  assert(T.totalmem("table") == (t + 4))
  set t = T.totalmem("function")
  set a = func () {}  ;; create 1 new closure
  assert(T.totalmem("function") == (t + 1))
  set t = T.totalmem("thread")
  set a = coroutine.create(func () {})  ;; create 1 new coroutine
  assert(T.totalmem("thread") == (t + 1))
}

;; create an object to be collected when state is closed
do {
  val setmetatable, assert, type, print, getmetatable = (setmetatable, assert, type, print, getmetatable)
  val tt = []
  set tt.__gc = func (o) {
    assert(getmetatable(o) == tt)
    ;; create new objects during GC
    val a = ('xuxu' ++ ((10 + 3) ++ 'joao'), [])
    set ___Glob = o  ;; resurrect object!
    setmetatable([], tt)  ;; creates a new one with same metatable
    print(">>> closing state " ++ "<<<\n")
  }
  val u = setmetatable([], tt)
  set ___Glob = [u]  ;; avoid object being collected before program end
}

;; create several objects to raise errors when collected while closing state
if T {
  val error, assert, find, warn = (error, assert, string.find, warn)
  var n = 0
  var lastmsg
  val mt = [__gc=func (o) {
    set n = n + 1
    assert(n == o@(1))
    ifs {
      n == 1 => {
        set _WARN = false
      }
      n == 2 => {
        assert(find(_WARN, "@expected warning"))
        set lastmsg = _WARN  ;; get message from previous error (first 'o')
      }
      else => {
        assert(lastmsg == _WARN)  ;; subsequent error messages are equal
      }
    }
    warn("@store")
    set _WARN = false
    error("@expected warning")
  }]
  loop i in (10, 1, -1) {
    ;; create object and preserve it until the end
    table.insert(___Glob, setmetatable([i], mt))
  }
}

;; just to make sure
assert(collectgarbage('isrunning'))

do {  ;; check that the collector is not reentrant in incremental mode
  var res = true
  setmetatable([], [__gc=func () {
    set res = collectgarbage()
  }])
  collectgarbage()
  assert(!res)
}

collectgarbage(oldmode)

if T {
  print("testing stack issues when calling finalizers")

  var X
  var obj

  val func initobj () {
    set X = false
    set obj = setmetatable([], [__gc=func () {
      set X = true
    }])
  }

  var loop_
  set loop_ = func (n) {
    if n > 0 {
      loop_(n - 1)
    }
  }

  ;; should not try to call finalizer without a CallInfo available
  initobj()
  loop_(20)  ;; ensure stack space
  T.resetCI()  ;; remove extra CallInfos
  T.alloccount(0)  ;; cannot allocate more CallInfos
  set obj = nil
  collectgarbage()  ;; will not call finalizer
  T.alloccount()
  assert(X == false)
  collectgarbage()  ;; now will call finalizer (it was still pending)
  assert(X == true)

  ;; should not try to call finalizer without stack space available
  initobj()
  loop_(5)  ;; ensure enough CallInfos
  T.reallocstack(0)  ;; remove extra stack slots
  T.alloccount(0)  ;; cannot reallocate stack
  set obj = nil
  collectgarbage()  ;; will not call finalizer
  T.alloccount()
  assert(X == false)
  collectgarbage()  ;; now will call finalizer (it was still pending)
  assert(X == true)
}

print('OK')
