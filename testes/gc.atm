if !_port {
  ;; test the pace of the collector
  collectgarbage()
  collectgarbage()
  val x = gcinfo()
  collectgarbage("stop")
  loop {
    val a = []
    until(gcinfo() > (3 * x))
  }
  collectgarbage("restart")
