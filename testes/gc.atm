print("clearing tables")
val lim = 15
var a = []
;; fill a with `collectable' indices
loop i in (1, lim) {
  set a@([]) = i
}
set b = []
loop k, v in pairs(a) {
  set b@(k) = v
}
;; remove all indices and collect them
loop n in pairs(b) {
  set a@(n) = undef
  assert((type(n) == 'table') && (next(n) == nil))
  collectgarbage()
}
set b = nil
collectgarbage()
loop n in pairs(a) {
  error('cannot be here')
}
loop i in (1, lim) {
  set a@(i) = i
}
loop i in (1, lim) {
  assert(a@(i) == i)
}

print('weak tables')
set a = []
setmetatable(a, [__mode='k'])
;; fill a with some `collectable' indices
loop i in (1, lim) {
  set a@([]) = i
}
;; and some non-collectable ones
loop i in (1, lim) {
  set a@(i) = i
}
loop i in (1, lim) {
  val s = string.rep('@', i)
  set a@(s) = s ++ '#'
}
collectgarbage()
var i = 0
loop k, v in pairs(a) {
  assert((k == v) || ((k ++ '#') == v))
  set i = i + 1
}
assert(i == (2 * lim))

set a = []
setmetatable(a, [__mode='v'])
set a@(1) = string.rep('b', 21)
collectgarbage()
assert(a@(1))  ;; strings are *values*
set a@(1) = undef
;; fill a with some `collectable' values (in both parts of the table)
loop i in (1, lim) {
  set a@(i) = []
}
loop i in (1, lim) {
  set a@(i ++ 'x') = []
}
;; and some non-collectable ones
loop i in (1, lim) {
  val t = []
  set a@(t) = t
}
loop i in (1, lim) {
  set a@(i + lim) = i ++ 'x'
}
collectgarbage()
var i = 0
loop k, v in pairs(a) {
  assert((k == v) || (((k - lim) ++ 'x') == v))
  set i = i + 1
}
assert(i == (2 * lim))

set a = []
setmetatable(a, [__mode='kv'])
var x, y, z = ([], [], [])
;; keep only some items
set a@(1), a@(2), a@(3) = (x, y, z)
set a@(string.rep('$', 11)) = string.rep('$', 11)
;; fill a with some `collectable' values
loop i in (4, lim) {
  set a@(i) = []
}
loop i in (1, lim) {
  set a@([]) = i
}
loop i in (1, lim) {
  val t = []
  set a@(t) = t
}
collectgarbage()
assert(next(a) != nil)
var i = 0
loop k, v in pairs(a) {
  assert(((k == 1) && (v == x)) || ((k == 2) && (v == y)) || ((k == 3) && (v == z)) || (k == v))
  set i = i + 1
}
assert(i == 4)
set x, y, z = nil
collectgarbage()
assert(next(a) == string.rep('$', 11))

do {  ;; invalid mode
  val a = setmetatable([], [__mode=34])
  collectgarbage()
}

if T {  ;; bug since 5.3: all-weak tables are not being revisited
  T.gcstate("propagate")
  val t = setmetatable([], [__mode="kv"])
  T.gcstate("enteratomic")  ;; 't' was visited
  setmetatable(t, [__mode="kv"])
  T.gcstate("pause")  ;; its new metatable is not being visited
  assert(getmetatable(t).__mode == "kv")
}

;; 'bug' in 5.1
set a = []
var t = [x=10]
var C = setmetatable([key=t], [__mode='v'])
var C1 = setmetatable([@(t)=1], [__mode='k'])
set a.x = t  ;; this should not prevent 't' from being removed from
;; weak table 'C' by the time 'a' is finalized

setmetatable(a, [__gc=func (u) {
  assert(C.key == nil)
  assert(type(next(C1)) == 'table')
}])

set a, t = nil
collectgarbage()
collectgarbage()
assert((next(C) == nil) && (next(C1) == nil))
set C, C1 = nil

;; ephemerons
val mt = [__mode='k']
set a = [[10], [20], [30], [40]]
setmetatable(a, mt)
set x = nil
loop i in (1, 100) {
  val n = []
  set a@(n) = [k=[x]]
  set x = n
}
GC()
var n = x
var i = 0
loop {
  while(n)
  set n = a@(n).k@(1)
  set i = i + 1
}
assert(i == 100)
set x = nil
GC()
loop i in (1, 4) {
  assert(a@(i)@(1) == (i * 10))
  set a@(i) = undef
}
assert(next(a) == nil)

var K = []
set a@(K) = []
loop i in (1, 10) {
  set a@(K)@(i) = []
  set a@(a@(K)@(i)) = setmetatable([], mt)
}
set x = nil
var k = 1
loop j in (1, 100) {
  val n = []
  val nk = (k % 10) + 1
  set a@(a@(K)@(nk))@(n) = [x, k=k]
  set x = n
  set k = nk
}
GC()
var n = x
var i = 0
loop {
  while(n)
  val t = a@(a@(K)@(k))@(n)
  set n = t@(1)
  set k = t.k
  set i = i + 1
}
assert(i == 100)
set K = nil
GC()
;; assert(next(a) == nil)

;; testing errors during GC
if T {
  collectgarbage("stop")  ;; stop collection
  val u = []
  val s = []
  setmetatable(s, [__mode='k'])
  setmetatable(u, [__gc=func (o) {
    val i = s@(o)
    set s@(i) = true
    assert(!s@(i - 1))  ;; check proper finalization order
    if i == 8 {  ;; error during GC
      error("@expected@")
    }
  }])

  loop i in (6, 10) {
    val n = setmetatable([], getmetatable(u))
    set s@(n) = i
  }

  warn("@on")
  warn("@store")
  collectgarbage()
  assert(string.find(_WARN, "error in __gc"))
  assert(string.match(_WARN, "@(.-)@") == "expected")
  set _WARN = false
  loop i in (8, 10) {
    assert(s@(i))
  }

  loop i in (1, 5) {
    val n = setmetatable([], getmetatable(u))
    set s@(n) = i
  }

  collectgarbage()
  loop i in (1, 10) {
    assert(s@(i))
  }

  set getmetatable(u).__gc = nil
  warn("@normal")
}
print('+')

;; testing userdata
if T == nil {
  (Message || print)('\n >>> testC not active: skipping userdata GC tests <<<\n')
} else {

  val func newproxy (u) {
    return(debug.setmetatable(T.newuserdata(0), debug.getmetatable(u)))
  }

  collectgarbage("stop")  ;; stop collection
  var u = newproxy(nil)
  debug.setmetatable(u, [__gc=true])
  var s = 0
  val a = [@(u)=0]
  setmetatable(a, [__mode='vk'])
  loop i in (1, 10) {
    set a@(newproxy(u)) = i
  }
  loop k in pairs(a) {
    assert(getmetatable(k) == getmetatable(u))
  }
  var a1 = []
  loop k, v in pairs(a) {
    set a1@(k) = v
  }
  loop k, v in pairs(a1) {
    set a@(v) = k
  }
  loop i in (1, 10) {
    assert(a@(i))
  }
  set getmetatable(u).a = a1
  set getmetatable(u).u = u
  do {
    val u = u
    set getmetatable(u).__gc = func (o) {
      assert(a@(o) == (10 - s))
      assert(a@(10 - s) == undef)  ;; udata already removed from weak table
      assert(getmetatable(o) == getmetatable(u))
      assert(getmetatable(o).a@(o) == (10 - s))
      set s = s + 1
    }
  }
  set a1, u = nil
  assert(next(a) != nil)
  collectgarbage()
  assert(s == 11)
  collectgarbage()
  assert(next(a) == nil)  ;; finalized keys are removed in two cycles
}

;; __gc x weak tables
var u = setmetatable([], [__gc=true])
;; __gc metamethod should be collected before running
setmetatable(getmetatable(u), [__mode="v"])
set getmetatable(u).__gc = func (o) {
  os.exit(1)  ;; cannot happen
}
set u = nil
collectgarbage()

var u = setmetatable([], [__gc=true])
var m = getmetatable(u)
set m.x = [@([0])=1, @(0)=[1]]
setmetatable(m.x, [__mode="kv"])
set m.__gc = func (o) {
  assert(next(getmetatable(o).x) == nil)
  set m = 10
}
set u, m = nil
collectgarbage()
assert(m == 10)

do {  ;; tests for string keys in weak tables
  collectgarbage()
  collectgarbage()
  val m = collectgarbage("count")  ;; current memory
  val a = setmetatable([], [__mode="kv"])
  set a@(string.rep("a", 2 ** 22)) = 25  ;; long string key -> number value
  set a@(string.rep("b", 2 ** 22)) = []  ;; long string key -> collectable value
  set a@([]) = 14  ;; collectable key
  collectgarbage()
  var k, v = next(a)  ;; string key with number value preserved
  assert((k == string.rep("a", 2 ** 22)) && (v == 25))
  assert(next(a, k) == nil)  ;; everything else cleared
  assert(a@(string.rep("b", 2 ** 22)) == undef)
  set a@(k) = undef  ;; erase this last entry
  set k = nil
  collectgarbage()
  assert(next(a) == nil)
  ;; make sure will not try to compare with dead key
  assert(a@(string.rep("b", 100)) == undef)
  assert(collectgarbage("count") <= (m + 1))  ;; everything collected
}

