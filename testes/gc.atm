print('testing incremental garbage collection')

val debug = require("debug")

assert(collectgarbage("isrunning"))

collectgarbage()

val oldmode = collectgarbage("incremental")

;; changing modes should return previous mode
assert(collectgarbage("generational") == "incremental")
assert(collectgarbage("generational") == "generational")
assert(collectgarbage("incremental") == "generational")
assert(collectgarbage("incremental") == "incremental")

val func nop () {
}

val func gcinfo () {
  return(collectgarbage("count") * 1024)
}

;; test weird parameters to 'collectgarbage'
do {
  collectgarbage("incremental")
  val opause = collectgarbage("param", "pause", 100)
  val ostepmul = collectgarbage("param", "stepmul", 100)
  assert(collectgarbage("param", "pause") == 100)
  assert(collectgarbage("param", "stepmul") == 100)
  val t = [0, 2, 10, 90, 500, 5000, 30000, 0x7ffffffe]
  loop i in (1, #t) {
    collectgarbage("param", "pause", t@(i))
    loop j in (1, #t) {
      collectgarbage("param", "stepmul", t@(j))
      collectgarbage("step", t@(j))
    }
  }
  ;; restore original parameters
  collectgarbage("param", "pause", opause)
  collectgarbage("param", "stepmul", ostepmul)
  collectgarbage()
}

;;
;; test the "size" of basic GC steps (whatever they mean...)
;;
do {
  print("steps")

  val func dosteps (siz) {
    collectgarbage()
    val a = []
    loop i in (1, 100) {
      set a@(i) = [[]]
      val b = []
    }
    val x = gcinfo()
    var i = 0
    loop {  ;; do steps until it completes a collection cycle
      set i = i + 1
      until(collectgarbage("step", siz))
    }
    assert(gcinfo() < x)
    return(i)  ;; number of steps
  }

  if !_port {
    collectgarbage("stop")
    assert(dosteps(10) < dosteps(2))
    collectgarbage("restart")
  }
}

set _G.while = 234

;;
;; tests for GC activation when creating different kinds of objects
;;
val func GC1 () {
  var u
  var b  ;; (above 'u' it in the stack)
  var finish = false
  set u = setmetatable([], [__gc=func () {
    set finish = true
  }])
  set b = [34]
  loop {
    set u = []
    until(finish)
  }
  assert(b@(1) == 34)  ;; 'u' was collected, but 'b' was not

  set finish = false
  var i = 1
  set u = setmetatable([], [__gc=func () {
    set finish = true
  }])
  loop {
    set i = i + 1
    set u = tostring(i) ++ tostring(i)
    until(finish)
  }
  assert(b@(1) == 34)  ;; 'u' was collected, but 'b' was not

  set finish = false
  set u = setmetatable([], [__gc=func () {
    set finish = true
  }])
  loop {
    val i
    set u = func () {
      return(i)
    }
    until(finish)
  }
  assert(b@(1) == 34)  ;; 'u' was collected, but 'b' was not
}

val func GC2 () {
  var u
  var finish = false
  set u = [setmetatable([], [__gc=func () {
    set finish = true
  }])]
  val b = [34]
  loop {
    set u = [[]]
    until(finish)
  }
  assert(b@(1) == 34)  ;; 'u' was collected, but 'b' was not

  set finish = false
  var i = 1
  set u = [setmetatable([], [__gc=func () {
    set finish = true
  }])]
  loop {
    set i = i + 1
    set u = [tostring(i) ++ tostring(i)]
    until(finish)
  }
  assert(b@(1) == 34)  ;; 'u' was collected, but 'b' was not

  set finish = false
  set u = [setmetatable([], [__gc=func () {
    set finish = true
  }])]
  loop {
    val i
    set u = [func () {
      return(i)
    }]
    until(finish)
  }
  assert(b@(1) == 34)  ;; 'u' was collected, but 'b' was not
}

val func GC () {
  GC1()
  GC2()
}

do {
  print("creating many objects")

  val limit = 5000

  loop i in (1, limit) {
    var a = []
    set a = nil
  }

  var a = "a"

  loop i in (1, limit) {
    set a = i ++ "b"
    set a = string.gsub(a, '(%d%d*)', "%1 %1")
    set a = "a"
  }

  set a = []

  func a::test () {
    loop i in (1, limit) {
      load(string.format("set temp = func (a) { 'a%d' }", i), "")()
      assert(temp() == string.format('a%d', i))
    }
  }

  a::test()
  set _G.temp = nil
}

