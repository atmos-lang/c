;; UTF-8 file

print('testing pattern matching')

;; (global *)

val func checkerror (msg, f, ...) {
  val s, err = pcall(f, ...)
  assert(!s && string.find(err, msg))
}

var f
set f = func (s, p) {
  val i, e = string.find(s, p)
  if i {
    return(string.sub(s, i, e))
  }
}

var a, b = string.find('', '')  ;; empty patterns are tricky
assert((a == 1) && (b == 0))
set a, b = string.find('alo', '')
assert((a == 1) && (b == 0))
set a, b = string.find('a\0o a\0o a\0o', 'a', 1)  ;; first position
assert((a == 1) && (b == 1))
set a, b = string.find('a\0o a\0o a\0o', 'a\0o', 2)  ;; starts in the middle
assert((a == 5) && (b == 7))
set a, b = string.find('a\0o a\0o a\0o', 'a\0o', 9)  ;; starts in the middle
assert((a == 9) && (b == 11))
set a, b = string.find('a\0a\0a\0a\0\0ab', '\0ab', 2)  ;; finds at the end
assert((a == 9) && (b == 11))
set a, b = string.find('a\0a\0a\0a\0\0ab', 'b')  ;; last position
assert((a == 11) && (b == 11))
assert(!string.find('a\0a\0a\0a\0\0ab', 'b\0'))  ;; check ending
assert(!string.find('', '\0'))
assert(string.find('alo123alo', '12') == 4)
assert(!string.find('alo123alo', '^12'))

assert(string.match("aaab", ".*b") == "aaab")
assert(string.match("aaa", ".*a") == "aaa")
assert(string.match("b", ".*b") == "b")

assert(string.match("aaab", ".+b") == "aaab")
assert(string.match("aaa", ".+a") == "aaa")
assert(!string.match("b", ".+b"))

assert(string.match("aaab", ".?b") == "ab")
assert(string.match("aaa", ".?a") == "aa")
assert(string.match("b", ".?b") == "b")

assert(f('aloALO', '%l*') == 'alo')
assert(f('aLo_ALO', '%a*') == 'aLo')

assert(f("  \n\r*&\n\r   xuxu  \n\n", "%g%g%g+") == "xuxu")

;; Adapt a pattern to UTF-8
val func PU (p) {
  ;; distribute '?' into each individual byte of a character.
  ;; (For instance, "á?" becomes "\195?\161?".)
  set p = string.gsub(p, "(" ++ (utf8.charpattern ++ ")%?"), func (c) {
    return(string.gsub(c, ".", "%0?"))
  })
  ;; change '.' to utf-8 character patterns
  set p = string.gsub(p, "%.", utf8.charpattern)
  return(p)
}

assert(f('aaab', 'a*') == 'aaa')
assert(f('aaa', '^.*$') == 'aaa')
assert(f('aaa', 'b*') == '')
assert(f('aaa', 'ab*a') == 'aa')
assert(f('aba', 'ab*a') == 'aba')
assert(f('aaab', 'a+') == 'aaa')
assert(f('aaa', '^.+$') == 'aaa')
assert(!f('aaa', 'b+'))
assert(!f('aaa', 'ab+a'))
assert(f('aba', 'ab+a') == 'aba')
assert(f('a$a', '.$') == 'a')
assert(f('a$a', '.%$') == 'a$')
assert(f('a$a', '.$.') == 'a$a')
assert(!f('a$a', '$$'))
assert(!f('a$b', 'a$'))
assert(f('a$a', '$') == '')
assert(f('', 'b*') == '')
assert(!f('aaa', 'bb*'))
assert(f('aaab', 'a-') == '')
assert(f('aaa', '^.-$') == 'aaa')
assert(f('aabaaabaaabaaaba', 'b.*b') == 'baaabaaabaaab')
assert(f('aabaaabaaabaaaba', 'b.-b') == 'baaab')
assert(f('alo xo', '.o$') == 'xo')
assert(f(' \n isto é assim', '%S%S*') == 'isto')
assert(f(' \n isto é assim', '%S*$') == 'assim')
assert(f(' \n isto é assim', '[a-z]*$') == 'assim')
assert(f('um caracter ? extra', '[^%sa-z]') == '?')
assert(f('', 'a?') == '')
assert(f('á', PU('á?')) == 'á')
assert(f('ábl', PU('á?b?l?')) == 'ábl')
assert(f('  ábl', PU('á?b?l?')) == '')
assert(f('aa', '^aa?a?a') == 'aa')
assert(f(']]]áb', '[^]]+') == 'áb')
assert(f("0alo alo", "%x*") == "0a")
assert(f("alo alo", "%C+") == "alo alo")
print('+')

val func f1 (s, p) {
  set p = string.gsub(p, "%%([0-9])", func (s) {
    return("%" ++ (tonumber(s) + 1))
  })
  set p = string.gsub(p, "^(^?)", "%1()", 1)
  set p = string.gsub(p, "($?)$", "()%1", 1)
  val t = [string.match(s, p)]
  return(string.sub(s, t@(1), t@(#t) - 1))
}

assert(f1('alo alx 123 b\0o b\0o', '(..*) %1') == "b\0o b\0o")
assert(f1('axz123= 4= 4 34', '(.+)=(.*)=%2 %1') == '3= 4= 4 3')
assert(f1('=======', '^(=*)=%1$') == '=======')
assert(!string.match('==========', '^([=]*)=%1$'))

var range
set range = func (i, j) {
  if i <= j {
    return(i, range(i + 1, j))
  }
}

val abc = string.char(range(0, 127)) ++ string.char(range(128, 255))

assert(string.len(abc) == 256)

val func strset (p) {
  val res = [s='']
  string.gsub(abc, p, func (c) {
    set res.s = res.s ++ c
  })
  return(res.s)
}

assert(string.len(strset('[\200-\210]')) == 11)

assert(strset('[a-z]') == "abcdefghijklmnopqrstuvwxyz")
assert(strset('[a-z%d]') == strset('[%da-uu-z]'))
assert(strset('[a-]') == "-a")
assert(strset('[^%W]') == strset('[%w]'))
assert(strset('[]%%]') == '%]')
assert(strset('[a%-z]') == '-az')
assert(strset('[%^%[%-a%]%-b]') == '-[]^ab')
assert(strset('%Z') == strset('[\1-\255]'))
assert(strset('.') == strset('[\1-\255%z]'))
print('+')

assert(string.match("alo xyzK", "(%w+)K") == "xyz")
assert(string.match("254 K", "(%d*)K") == "")
assert(string.match("alo ", "(%w*)$") == "")
assert(!string.match("alo ", "(%w+)$"))
assert(string.find("(álo)", "%(á") == 1)
var a, b, c, d, e = string.match("âlo alo", PU("^(((.).). (%w*))$"))
assert((a == 'âlo alo') && (b == 'âl') && (c == 'â') && (d == 'alo') && (e == nil))
set a, b, c, d = string.match('0123456789', '(.+(.?)())')
assert((a == '0123456789') && (b == '') && (c == 11) && (d == nil))
print('+')

assert(string.gsub('ülo ülo', 'ü', 'x') == 'xlo xlo')
assert(string.gsub('alo úlo  ', ' +$', '') == 'alo úlo')  ;; trim
assert(string.gsub('  alo alo  ', '^%s*(.-)%s*$', '%1') == 'alo alo')  ;; double trim
assert(string.gsub('alo  alo  \n 123\n ', '%s+', ' ') == 'alo alo 123 ')
var t = "abç d"
set a, b = string.gsub(t, PU('(.)'), '%1@')
assert((a == "a@b@ç@ @d@") && (b == 5))
set a, b = string.gsub('abçd', PU('(.)'), '%0@', 2)
assert((a == 'a@b@çd') && (b == 2))
assert(string.gsub('alo alo', '()[al]', '%1') == '12o 56o')
assert(string.gsub("abc=xyz", "(%w*)(%p)(%w+)", "%3%2%1-%0") == "xyz=abc-abc=xyz")
assert(string.gsub("abc", "%w", "%1%0") == "aabbcc")
assert(string.gsub("abc", "%w+", "%0%1") == "abcabc")
assert(string.gsub('áéí', '$', '\0óú') == 'áéí\0óú')
assert(string.gsub('', '^', 'r') == 'r')
assert(string.gsub('', '$', 'r') == 'r')
print('+')

do {  ;; new (5.3.3) semantics for empty matches
  assert(string.gsub("a b cd", " *", "-") == "-a-b-c-d-")

  var res = ""
  val sub = "a  \nbc\t\td"
  var i = 1
  loop p, e in string.gmatch(sub, "()%s*()") {
    set res = res ++ (string.sub(sub, i, p - 1) ++ "-")
    set i = e
  }
  assert(res == "-a-b-c-d-")
}

assert(string.gsub("um (dois) tres (quatro)", "(%(%w+%))", string.upper) == "um (DOIS) tres (QUATRO)")

do {
  val func setglobal (n, v) {
    rawset(_G, n, v)
    nil  ;; (functions evaluate to their last expression)
  }
  string.gsub("a=roberto,roberto=a", "(%w+)=(%w%w*)", setglobal)
  assert((_G.a == "roberto") && (_G.roberto == "a"))
  set _G.a = nil
  set _G.roberto = nil
}

func f (a, b) {
  return(string.gsub(a, '.', b))
}
assert(string.gsub("trocar tudo em |teste|b| é |beleza|al|", "|([^|]*)|([^|]*)|", f) == "trocar tudo em bbbbb é alalalalalal")

val func dostring (s) {
  return(load(s, "")() || "")
}
assert(string.gsub("alo $set a = 'x'$ novamente $a$", "$([^$]*)%$", dostring) == "alo  novamente x")

val x = string.gsub("$set x = string.gsub('alo', '.', string.upper)$ assim vai para $x$", "$([^$]*)%$", dostring)
assert(x == ' assim vai para ALO')
set _G.a, _G.x = nil

var t = []
var s = 'a alo jose  joao'
var r = string.gsub(s, '()(%w+)()', func (a, w, b) {
  assert(string.len(w) == (b - a))
  set t@(a) = b - a
})
assert((s == r) && (t@(1) == 1) && (t@(3) == 3) && (t@(7) == 4) && (t@(13) == 4))

val func isbalanced (s) {
  return(!string.find(string.gsub(s, "%b()", ""), "[()]"))
}

assert(isbalanced("(9 ((8))(\0) 7) \0\0 a b ()(c)() a"))
assert(!isbalanced("(9 ((8) 7) a b (\0 c) a"))
assert(string.gsub("alo 'oi' alo", "%b''", '"') == 'alo " alo')

var t = ["apple", "orange", "lime", n=0]
assert(string.gsub("x and x and x", "x", func () {
  set t.n = t.n + 1
  return(t@(t.n))
}) == "apple and orange and lime")

set t = [n=0]
string.gsub("first second word", "%w%w*", func (w) {
  set t.n = t.n + 1
  set t@(t.n) = w
})
assert((t@(1) == "first") && (t@(2) == "second") && (t@(3) == "word") && (t.n == 3))

set t = [n=0]
assert(string.gsub("first second word", "%w+", func (w) {
  set t.n = t.n + 1
  set t@(t.n) = w
}, 2) == "first second word")
assert((t@(1) == "first") && (t@(2) == "second") && (t@(3) == undef))

checkerror("invalid replacement value %(a table%)", string.gsub, "alo", ".", [a=[]])
checkerror("invalid capture index %%2", string.gsub, "alo", ".", "%2")
checkerror("invalid capture index %%0", string.gsub, "alo", "(%0)", "a")
checkerror("invalid capture index %%1", string.gsub, "alo", "(%1)", "a")
checkerror("invalid use of '%%'", string.gsub, "alo", ".", "%x")

if !_soft {
  print("big strings")
  var a = string.rep('a', 300000)
  assert(string.find(a, '^a*.?$'))
  assert(!string.find(a, '^a*.?b$'))
  assert(string.find(a, '^a-.?$'))

  ;; bug in 5.1.2
  set a = string.rep('a', 10000) ++ string.rep('b', 10000)
  assert(!pcall(string.gsub, a, 'b'))
}

;; recursive nest of gsubs
var rev
set rev = func (s) {
  return(string.gsub(s, "(.)(.+)", func (c, s1) {
    return(rev(s1) ++ c)
  }))
}

val x = "abcdef"
assert(rev(rev(x)) == x)

;; gsub with tables
assert(string.gsub("alo alo", ".", []) == "alo alo")
assert(string.gsub("alo alo", "(.)", [a="AA", l=""]) == "AAo AAo")
assert(string.gsub("alo alo", "(.).", [a="AA", l="K"]) == "AAo AAo")
assert(string.gsub("alo alo", "((.)(.?))", [al="AA", o=false]) == "AAo AAo")

assert(string.gsub("alo alo", "().", ['x', 'yy', 'zzz']) == "xyyzzz alo")

set t = []
setmetatable(t, [__index=func (t, s) {
  return(string.upper(s))
}])
assert(string.gsub("a alo b hi", "%w%w+", t) == "a ALO b HI")

;; tests for gmatch
var a = 0
loop i in string.gmatch('abcde', '()') {
  assert(i == (a + 1))
  set a = i
}
assert(a == 6)

set t = [n=0]
loop w in string.gmatch("first second word", "%w+") {
  set t.n = t.n + 1
  set t@(t.n) = w
}
assert((t@(1) == "first") && (t@(2) == "second") && (t@(3) == "word"))

set t = [3, 6, 9]
loop i in string.gmatch("xuxx uu ppar r", "()(.)%2") {
  assert(i == table.remove(t, 1))
}
assert(#t == 0)

set t = []
loop i, j in string.gmatch("13 14 10 = 11, 15= 16, 22=23", "(%d+)%s*=%s*(%d+)") {
  set t@(tonumber(i)) = tonumber(j)
}
set a = 0
loop k, v in pairs(t) {
  assert((k + 1) == (v + 0))
  set a = a + 1
}
assert(a == 3)

do {  ;; init parameter in gmatch
  var s = 0
  loop k in string.gmatch("10 20 30", "%d+", 3) {
    set s = s + tonumber(k)
  }
  assert(s == 50)

  set s = 0
  loop k in string.gmatch("11 21 31", "%d+", -4) {
    set s = s + tonumber(k)
  }
  assert(s == 32)

  ;; there is an empty string at the end of the subject
  set s = 0
  loop k in string.gmatch("11 21 31", "%w*", 9) {
    set s = s + 1
  }
  assert(s == 1)

  ;; there are no empty strings after the end of the subject
  set s = 0
  loop k in string.gmatch("11 21 31", "%w*", 10) {
    set s = s + 1
  }
  assert(s == 0)
}

do {  ;; bug since 5.3
  val N = 20000
  val iter = string.gmatch(string.rep("a", N), string.rep("a?", N))
  pcall(iter)  ;; error for pattern too complex
  ;; calling function again found recursion count ('matchdepth') equal
  ;; to -1, so it did not detect next C-stack overflow
  pcall(iter)
}

;; tests for `%f' (`frontiers')

assert(string.gsub("aaa aa a aaa a", "%f[%w]a", "x") == "xaa xa x xaa x")
assert(string.gsub("[[]] [][] [[[[", "%f[[].", "x") == "x[]] x]x] x[[[")
assert(string.gsub("01abc45de3", "%f[%d]", ".") == ".01abc.45de.3")
assert(string.gsub("01abc45 de3x", "%f[%D]%w", ".") == "01.bc45 de3.")
assert(string.gsub("function", "%f[\1-\255]%w", ".") == ".unction")
assert(string.gsub("function", "%f[^\1-\255]", ".") == "function.")

assert(string.find("a", "%f[a]") == 1)
assert(string.find("a", "%f[^%z]") == 1)
assert(string.find("a", "%f[^%l]") == 2)
assert(string.find("aba", "%f[a%z]") == 3)
assert(string.find("aba", "%f[%z]") == 4)
assert(!string.find("aba", "%f[%l%z]"))
assert(!string.find("aba", "%f[^%l%z]"))

val i, e = string.find(" alo aalo allo", "%f[%S].-%f[%s].-%f[%S]")
assert((i == 2) && (e == 5))
val k = string.match(" alo aalo allo", "%f[%S](.-%f[%s].-%f[%S])")
assert(k == 'alo ')

val a = [1, 5, 9, 14, 17]
loop k in string.gmatch("alo alo th02 is 1hat", "()%f[%w%d]") {
  assert(table.remove(a, 1) == k)
}
assert(#a == 0)

;; malformed patterns
val func malform (p, m) {
  set m = m || "malformed"
  val r, msg = pcall(string.find, "a", p)
  assert(!r && string.find(msg, m))
}

malform("(.", "unfinished capture")
malform(".)", "invalid pattern capture")
malform("[a")
malform("[]")
malform("[^]")
malform("[a%]")
malform("[a%")
malform("%b")
malform("%ba")
malform("%")
malform("%f", "missing")

;; \0 in patterns
assert(string.match("ab\0\1\2c", "[\0-\2]+") == "\0\1\2")
assert(string.match("ab\0\1\2c", "[\0-\0]+") == "\0")
assert(string.find("b$a", "$\0?") == 2)
assert(string.find("abc\0efg", "%\0") == 4)
assert(string.match("abc\0efg\0\1e\1g", "%b\0\1") == "\0efg\0\1e\1")
assert(string.match("abc\0\0\0", "%\0+") == "\0\0\0")
assert(string.match("abc\0\0\0", "%\0%\0?") == "\0\0")

;; magic char after \0
assert(string.find("abc\0\0", "\0.") == 4)
assert(string.find("abcx\0\0abc\0abc", "x\0\0abc\0a.") == 4)

do {  ;; test reuse of original string in gsub
  val s = string.rep("a", 100)
  var r = string.gsub(s, "b", "c")  ;; no match
  assert(string.format("%p", s) == string.format("%p", r))

  set r = string.gsub(s, ".", [x="y"])  ;; no substitutions
  assert(string.format("%p", s) == string.format("%p", r))

  var count = 0
  set r = string.gsub(s, ".", func (x) {
    assert(x == "a")
    set count = count + 1
    return(nil)  ;; no substitution
  })
  set r = string.gsub(r, ".", [b='x'])  ;; "a" is not a key; no subst.
  assert(count == 100)
  assert(string.format("%p", s) == string.format("%p", r))

  set count = 0
  set r = string.gsub(s, ".", func (x) {
    assert(x == "a")
    set count = count + 1
    return(x)  ;; substitution...
  })
  assert(count == 100)
  ;; no reuse in this case
  assert((r == s) && (string.format("%p", s) != string.format("%p", r)))
}

print('OK')
