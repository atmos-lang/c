;; coroutine.error: raise an error at the pending yield of a suspended
;; coroutine. See .claude/plans/coroutine.md, item a.

print("testing coroutine.error")

val func count (...) { select("#", ...) }

;; ---- coroutine.error: uncaught

do {
  val co = coroutine.create(\{
    coroutine.yield(1)
    print("unreachable")
  })
  val st, v = coroutine.resume(co)
  assert(st && (v == 1))
  val st, a, b = coroutine.error(co, :X, 2)
  assert(!st && (a == :X) && (b == 2))
  assert(coroutine.status(co) == "dead")
  ;; values: none, nil, many
  val co = coroutine.create(\{ coroutine.yield() })
  coroutine.resume(co)
  val st, e = coroutine.error(co)
  assert(!st && (e == "<no error object>"))
  val co = coroutine.create(\{ coroutine.yield() })
  coroutine.resume(co)
  val st, e, x = coroutine.error(co, nil, 3)
  assert(!st && (e == "<no error object>") && (x == 3))
  val co = coroutine.create(\{ coroutine.yield() })
  coroutine.resume(co)
  val t = table.pack(coroutine.error(co, 1, 2, 3, 4, 5))
  assert((t.n == 6) && (t@1 == false) && (t@6 == 5))
  ;; the yield value does not leak: the yield raises instead of returning
  var got = "none"
  val co = coroutine.create(\{ set got = coroutine.yield() })
  coroutine.resume(co)
  coroutine.error(co, "e")
  assert(got == "none")
}

;; ---- coroutine.error: caught inside the coroutine

do {
  val co = coroutine.create(\{
    val ok, e, v = catch :X { coroutine.yield(1) }
    (ok, e, v)
  })
  assert(coroutine.resume(co))
  val st, ok, e, v = coroutine.error(co, :X, 2)
  assert(st && (ok == false) && (e == :X) && (v == 2))
  assert(coroutine.status(co) == "dead")
  ;; not matching: propagates out
  val co = coroutine.create(\{
    catch :X { coroutine.yield(1) }
    print("unreachable")
  })
  coroutine.resume(co)
  val st, e = coroutine.error(co, :Y)
  assert(!st && (e == :Y))
  ;; pcall and xpcall at the yield point
  val co = coroutine.create(\{
    val st, e, v = pcall(coroutine.yield, 1)
    coroutine.yield(st, e, v)
    val st, m = xpcall(coroutine.yield, \(e, x){ e ++ "!" ++ x }, 2)
    (st, m)
  })
  assert(coroutine.resume(co))
  val _, st, e, v = coroutine.error(co, "a", "b")
  assert((st == false) && (e == "a") && (v == "b"))
  val _, st, m = coroutine.error(co, "c", "d")
  assert((st == false) && (m == "c!d"))
  ;; the coroutine can keep yielding after catching
  val co = coroutine.create(\{
    var n = 0
    loop {
      val ok = catch true { coroutine.yield(n) }
      if !ok { set n = n + 1 }
      until(n == 3)
    }
    :done
  })
  assert(select(2, coroutine.resume(co)) == 0)
  assert(select(2, coroutine.error(co, 1)) == 1)
  assert(select(2, coroutine.error(co, 1)) == 2)
  val st, v = coroutine.error(co, 1)
  assert(st && (v == :done))
}

;; ---- coroutine.error: defer, pin and nested calls

do {
  val log = []
  val co = coroutine.create(\{
    defer { table.insert(log, "d1") }
    pin p = setmetatable([], [__close = \(_, e){ table.insert(log, e) }])
    do {
      defer { table.insert(log, "d2") }
      coroutine.yield()
    }
    table.insert(log, "unreachable")
  })
  coroutine.resume(co)
  val st, e = coroutine.error(co, "err")
  assert(!st && (e == "err"))
  assert(table.concat(log, ",") == "d2,err,d1")
  ;; yield inside nested functions: the error is raised there
  val func inner () {
    val ok, e = catch :X { coroutine.yield("in") }
    if ok { "returned" } else { "caught " ++ e }
  }
  val co = coroutine.create(\{ inner() })
  assert(select(2, coroutine.resume(co)) == "in")
  val st, v = coroutine.error(co, :X)
  assert(st && (v == "caught X"))
  ;; yield inside a yieldable pcall of a __close
  val co = coroutine.create(\{
    val ok, e = pcall(\{
      pin x = setmetatable([], [__close = \{ coroutine.yield("closing") }])
      error("first", 0)
    })
    (ok, e)
  })
  assert(select(2, coroutine.resume(co)) == "closing")
  val st, ok, e = coroutine.error(co, "second")
  assert(st && !ok && (e == "second"))
}

;; ---- coroutine.error: errors of use

do {
  val func err (f, ...) {
    val ok, m = pcall(f, ...)
    assert(!ok, "expected error")
    m
  }
  ;; not started: dies without running
  val co = coroutine.create(\{ print("unreachable") })
  val st, e = coroutine.error(co, 1)
  assert(!st && (e == 1) && (coroutine.status(co) == "dead"))
  assert(string.find(err(coroutine.error, co, 1), "dead coroutine"))
  assert(string.find(err(coroutine.error, coroutine.running(), 1), "running coroutine"))
  val co = coroutine.create(\{
    val m = select(2, pcall(coroutine.error, coroutine.running(), 1))
    coroutine.yield(m)
  })
  assert(string.find(select(2, coroutine.resume(co)), "running coroutine"))
  var outer = nil
  set outer = coroutine.create(\{
    val inner = coroutine.create(\{
      coroutine.yield(select(2, pcall(coroutine.error, outer, 1)))
    })
    select(2, coroutine.resume(inner))
  })
  assert(string.find(select(2, coroutine.resume(outer)), "normal coroutine"))
  assert(string.find(err(coroutine.error, 1), "coroutine expected"))
}

print("OK")
