;; $Id: testes/gengc.lua $
;; See Copyright Notice in file lua.h

print('testing generational garbage collection')

val debug = require("debug")

assert(collectgarbage("isrunning"))

collectgarbage()

val oldmode = collectgarbage("generational")

;; ensure that table barrier evolves correctly
do {
  val U = []
  ;; full collection makes 'U' old
  collectgarbage()
  assert(!T || (T.gcage(U) == "old"))

  ;; U refers to a new table, so it becomes 'touched1'
  set U@(1) = [x=[234]]
  assert(!T || ((T.gcage(U) == "touched1") && (T.gcage(U@(1)) == "new")))

  ;; both U and the table survive one more collection
  collectgarbage("step")
  assert(!T || ((T.gcage(U) == "touched2") && (T.gcage(U@(1)) == "survival")))

  ;; both U and the table survive yet another collection
  ;; now everything is old
  collectgarbage("step")
  assert(!T || ((T.gcage(U) == "old") && (T.gcage(U@(1)) == "old1")))

  ;; data was not corrupted
  assert(U@(1).x@(1) == 234)
}

do {
  ;; ensure that 'firstold1' is corrected when object is removed from
  ;; the 'allgc' list
  val func foo () {
  }
  val old = [10]
  collectgarbage()  ;; make 'old' old
  assert(!T || (T.gcage(old) == "old"))
  setmetatable(old, [])  ;; new table becomes OLD0 (barrier)
  assert(!T || (T.gcage(getmetatable(old)) == "old0"))
  collectgarbage("step")  ;; new table becomes OLD1 and firstold1
  assert(!T || (T.gcage(getmetatable(old)) == "old1"))
  setmetatable(getmetatable(old), [__gc=foo])  ;; get it out of allgc list
  collectgarbage("step")  ;; should not seg. fault
}

do {  ;; bug in 5.4.0
  ;; When an object aged OLD1 is finalized, it is moved from the list
  ;; 'finobj' to the *beginning* of the list 'allgc', but that part of the
  ;; list was not being visited by 'markold'.
  val A = []
  set A@(1) = false  ;; old anchor for object

  ;; obj finalizer
  val func gcf (obj) {
    set A@(1) = obj  ;; anchor object
    assert(!T || (T.gcage(obj) == "old1"))
    set obj = nil  ;; remove it from the stack
    collectgarbage("step")  ;; do a young collection
    print(getmetatable(A@(1)).x)  ;; metatable was collected
  }

  collectgarbage()  ;; make A old
  var obj = []  ;; create a new object
  collectgarbage("step")  ;; make it a survival
  assert(!T || (T.gcage(obj) == "survival"))
  setmetatable(obj, [__gc=gcf, x="+"])  ;; create its metatable
  assert(!T || (T.gcage(getmetatable(obj)) == "new"))
  set obj = nil  ;; clear object
  collectgarbage("step")  ;; will call obj's finalizer
}

do {  ;; another bug in 5.4.0
  val old = [10]
  collectgarbage()  ;; make 'old' old
  var co = coroutine.create(func () {

    var x = nil
    val func f () {
      return(x@(1))
    }
    set x = coroutine.yield(f)
    coroutine.yield()
  })
  val _, f = coroutine.resume(co)  ;; create closure over 'x' in coroutine
  collectgarbage("step")  ;; make upvalue a survival
  set old@(1) = ["hello"]  ;; 'old' go to grayagain as 'touched1'
  coroutine.resume(co, [123])  ;; its value will be new
  set co = nil
  collectgarbage("step")  ;; hit the barrier
  assert((f() == 123) && (old@(1)@(1) == "hello"))
  collectgarbage("step")  ;; run the collector once more
  ;; make sure old[1] was not collected
  assert((f() == 123) && (old@(1)@(1) == "hello"))
}

do {  ;; bug introduced in commit 9cf3299fa
  val t = setmetatable([], [__mode="kv"])  ;; all-weak table
  collectgarbage()  ;; full collection
  assert(!T || (T.gcage(t) == "old"))
  set t@(1) = [10]
  assert(!T || ((T.gcage(t) == "touched1") && (T.gccolor(t) == "gray")))
  collectgarbage("step")  ;; minor collection
  assert(!T || ((T.gcage(t) == "touched2") && (T.gccolor(t) == "black")))
  collectgarbage("step")  ;; minor collection
  assert(!T || (T.gcage(t) == "old"))  ;; t should be black, but it was gray
  set t@(1) = [10]  ;; no barrier here, so t was still old
  collectgarbage("step")  ;; minor collection
  ;; t, being old, is ignored by the collection, so it is not cleared
  assert(t@(1) == nil)  ;; fails with the bug
}

if T == nil {
  (Message || print)('\n >>> testC not active: \z
                             skipping some generational tests <<<\n')
  print('OK')
  return()
}

;; ensure that userdata barrier evolves correctly
do {
  val U = T.newuserdata(0, 1)
  ;; full collection makes 'U' old
  collectgarbage()
  assert(T.gcage(U) == "old")

  ;; U refers to a new table, so it becomes 'touched1'
  debug.setuservalue(U, [x=[234]])
  assert((T.gcage(U) == "touched1") && (T.gcage(debug.getuservalue(U)) == "new"))

  ;; both U and the table survive one more collection
  collectgarbage("step")
  assert((T.gcage(U) == "touched2") && (T.gcage(debug.getuservalue(U)) == "survival"))

  ;; both U and the table survive yet another collection
  ;; now everything is old
  collectgarbage("step")
  assert((T.gcage(U) == "old") && (T.gcage(debug.getuservalue(U)) == "old1"))

  ;; data was not corrupted
  assert(debug.getuservalue(U).x@(1) == 234)
}

;; just to make sure
assert(collectgarbage('isrunning'))

do {
  ;; bug in 5.0: when computing whether it should return from gen-major
  ;; to gen-minor, the difference between the total memory and the
  ;; previous total memory can be negative, which results in that
  ;; negative value being left-shifted (UB)

  val lim = 1e6

  ;; make major collections non-incremental
  val oldsm = collectgarbage("param", "stepmul", 0)

  ;; make "majorminor" large enough to force a left-shift
  ;; when applying the parameter (internal details)
  val oldmm = collectgarbage("param", "majorminor", 2000)

  collectgarbage()
  collectgarbage()
  assert(!T || (T.gcquery() == "genminor"))

  val M = collectgarbage("count") * 1024

  ;; create a large table
  val t = []
  loop i in (1, lim) {
    set t@(i) = true
  }
  assert((collectgarbage("count") * 1024) > (M + (lim * string.packsize("j"))))

  ;; force collector to "generational major" mode, doing several
  ;; minor collections that recover no memory
  collectgarbage("step")
  collectgarbage("step")
  collectgarbage("step")
  assert(!T || (T.gcquery() == "genmajor"))

  ;; shrink the table
  loop i in (1, lim) {
    set t@(i) = nil
  }
  set t@(2 * lim) = true
  assert(collectgarbage("count") < ((M * 5) / 4))

  ;; bug was here, an assert violation when checking whether to
  ;; return to 'genminor'
  collectgarbage("step")

  ;; restore previous parameters
  collectgarbage("param", "stepmul", oldsm)
  collectgarbage("param", "majorminor", oldmm)
}

do {
  print("testing stop-the-world collection")
  val step = collectgarbage("param", "stepsize", 0)
  collectgarbage("incremental")
  assert(collectgarbage("param", "stepsize") == 0)

  ;; each step does a complete cycle
  assert(collectgarbage("step"))
  assert(collectgarbage("step"))

  ;; back to default value
  collectgarbage("param", "stepsize", step)
  assert(collectgarbage("param", "stepsize") == step)
}

if T {  ;; test GC parameter codification
  loop _, percentage in ipairs([5, 10, 12, 20, 50, 100, 200, 500]) {
    val param = T.codeparam(percentage)  ;; codify percentage
    loop _, value in ipairs([1, 2, 10, 100, 257, 1023, 6500, 100000]) {
      val exact = (value * percentage) // 100
      val aprox = T.applyparam(param, value)  ;; apply percentage
      ;; difference is at most 10% (+1 compensates difference due to
      ;; rounding to integers)
      assert(math.abs(aprox - exact) <= ((exact / 10) + 1))
    }
  }
}

collectgarbage(oldmode)

print('OK')
