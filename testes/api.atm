assert((x == 15) && (k == 35))
set k = T.testC("getfield 2 y, return 1", b)
assert(k == 12)
set getmetatable(b).__index = func (t, i) {
  return(a@(i))
}
set getmetatable(b).__newindex = func (t, i, v) {
