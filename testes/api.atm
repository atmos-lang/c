set tt = nil  ;; frees tt for GC
set A = nil
set b = nil
T.unref(d, reftable)
var n5 = T.newuserdata(0)
debug.setmetatable(n5, [__gc=F])
set n5 = T.udataval(n5)
collectgarbage()
assert(#cl == 4)
;; check order of collection
assert((cl@(2) == n5) && (cl@(3) == nb) && (cl@(4) == na))

;; reuse a reference in 'reftable'
T.unref(T.ref(23, reftable), reftable)

do {  ;; check reftable
  var count = 0
  var i = 1
  loop {
    while(reftable@(i) != 0)
    set i = reftable@(i)  ;; traverse linked list of free references
    set count = count + 1
  }
  ;; maximum number of simultaneously locked objects was 3
  assert((count == 3) && (#reftable == (3 + 1)))  ;; +1 for reserved [1]
}

