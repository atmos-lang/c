;; $Id: testes/api.lua $
;; See Copyright Notice in file lua.h

if T == nil {
  (Message || print)('\n >>> testC not active: skipping API tests <<<\n')
  return()
}

val debug = require("debug")

val pack = table.pack

val func tcheck (t1, t2) {
  assert(t1.n == ((t2.n || #t2) + 1))
  loop i in (2, t1.n) {
    assert(t1@(i) == t2@(i - 1))
  }
}

val func checkerr (msg, f, ...) {
  val stat, err = pcall(f, ...)
  assert(!stat && string.find(err, msg))
}

print('testing C API')

var a = T.testC("pushvalue R; return 1")
assert(a == debug.getregistry())

;; absindex
assert(T.testC("settop 10; absindex -1; return 1") == 10)
assert(T.testC("settop 5; absindex -5; return 1") == 1)
assert(T.testC("settop 10; absindex 1; return 1") == 1)
assert(T.testC("settop 10; absindex R; return 1") < -10)

;; testing alignment
set a = T.d2s(12458954321123.0)
assert(a == string.pack("d", 12458954321123.0))
assert(T.s2d(a) == 12458954321123.0)

var a, b, c = T.testC("pushnum 1; pushnum 2; pushnum 3; return 2")
assert((a == 2) && (b == 3) && !c)

val f = T.makeCfunc("pushnum 1; pushnum 2; pushnum 3; return 2")
set a, b, c = f()
assert((a == 2) && (b == 3) && !c)

;; test that all trues are equal
set a, b, c = T.testC("pushbool 1; pushbool 2; pushbool 0; return 3")
assert((a == b) && (a == true) && (c == false))
set a, b, c = T.testC("pushbool 0; pushbool 10; pushnil;\
                      tobool -3; tobool -3; tobool -3; return 3")

assert((a == false) && (b == true) && (c == false))

set a, b, c = T.testC("gettop; return 2", 10, 20, 30, 40)
assert((a == 40) && (b == 5) && !c)

var t = pack(T.testC("settop 5; return *", 2, 3))
tcheck(t, [n=4, 2, 3])

set t = pack(T.testC("settop 0; settop 15; return 10", 3, 1, 23))
assert((t.n == 10) && (t@(1) == nil) && (t@(10) == nil))

set t = pack(T.testC("remove -2; return *", 2, 3, 4))
tcheck(t, [n=2, 2, 4])

set t = pack(T.testC("insert -1; return *", 2, 3))
tcheck(t, [n=2, 2, 3])

set t = pack(T.testC("insert 3; return *", 2, 3, 4, 5))
tcheck(t, [n=4, 2, 5, 3, 4])

set t = pack(T.testC("replace 2; return *", 2, 3, 4, 5))
tcheck(t, [n=3, 5, 3, 4])

set t = pack(T.testC("replace -2; return *", 2, 3, 4, 5))
tcheck(t, [n=3, 2, 3, 5])

set t = pack(T.testC("remove 3; return *", 2, 3, 4, 5))
tcheck(t, [n=3, 2, 4, 5])

set t = pack(T.testC("copy 3 4; return *", 2, 3, 4, 5))
tcheck(t, [n=4, 2, 3, 3, 5])

set t = pack(T.testC("copy -3 -1; return *", 2, 3, 4, 5))
tcheck(t, [n=4, 2, 3, 4, 3])

do {  ;; testing 'rotate'
  var t = [10, 20, 30, 40, 50, 60]
  loop i in (-6, 6) {
    val s = string.format("rotate 2 %d; return 7", i)
    val t1 = pack(T.testC(s, 10, 20, 30, 40, 50, 60))
    tcheck(t1, t)
    table.insert(t, 1, table.remove(t))
  }

  set t = pack(T.testC("rotate -2 1; return *", 10, 20, 30, 40))
  tcheck(t, [10, 20, 40, 30])
  set t = pack(T.testC("rotate -2 -1; return *", 10, 20, 30, 40))
  tcheck(t, [10, 20, 40, 30])

  ;; some corner cases
  set t = pack(T.testC("rotate -1 0; return *", 10, 20, 30, 40))
  tcheck(t, [10, 20, 30, 40])
  set t = pack(T.testC("rotate -1 1; return *", 10, 20, 30, 40))
  tcheck(t, [10, 20, 30, 40])
  set t = pack(T.testC("rotate 5 -1; return *", 10, 20, 30, 40))
  tcheck(t, [10, 20, 30, 40])
}

;; testing warnings
T.testC("""  warningC "#This should be a"
  warningC " single "
  warning "warning"
  warningC "#This should be "
  warning "another one"
""")

;; testing message handlers
do {
  val f = T.makeCfunc("""    getglobal error
    pushstring bola
    pcall 1 1 1   # call 'error' with given handler
    pushstatus
    return 2     # return error message and status
  """)

  val msg, st = f(string.upper)  ;; function handler
  assert((st == "ERRRUN") && (msg == "BOLA"))
  val msg, st = f(string.len)  ;; function handler
  assert((st == "ERRRUN") && (msg == 4))
}

set t = pack(T.testC("insert 3; pushvalue 3; remove 3; pushvalue 2; remove 2; \
                  insert 2; pushvalue 1; remove 1; insert 1; \
      insert -2; pushvalue -2; remove -3; return *", 2, 3, 4, 5, 10, 40, 90))
tcheck(t, [n=7, 2, 3, 4, 5, 10, 40, 90])

set t = pack(T.testC("concat 5; return *", "alo", 2, 3, "joao", 12))
tcheck(t, [n=1, "alo23joao12"])

;; testing MULTRET
set t = pack(T.testC("call 2,-1; return *", func (a, b) {
  return(1, 2, 3, 4, a, b)
}, "alo", "joao"))
tcheck(t, [n=6, 1, 2, 3, 4, "alo", "joao"])

do {  ;; test returning more results than fit in the caller stack
  val a = []
  loop i in (1, 1000) {
    set a@(i) = true
  }
  set a@(999) = 10
  val b = T.testC("""pcall 1 -1 0; pop 1; tostring -1; return 1""", table.unpack, a)
  assert(b == "10")
}

do {  ;; testing multiple returns
  var foo
  set foo = func (n) {
    if n > 0 {
      return(n, foo(n - 1))
    }
  }

  val t = [T.testC("call 1 10; return 10", foo, 20)]
  assert((t@(1) == 20) && (t@(10) == 11) && (t@(11) == nil))

  val t = table.pack(T.testC("call 1 10; return 10", foo, 2))
  assert((t@(1) == 2) && (t@(2) == 1) && (t@(3) == nil) && (t.n == 10))

  val t = [T.testC("""    checkstack 300 "error"; call 1 250; return 250""", foo, 250)]
  assert((t@(1) == 250) && (t@(250) == 1) && (t@(251) == nil))
}

;; testing globals
set _G.AA = 14
set _G.BB = "a31"
var a = [T.testC("""  getglobal AA;
  getglobal BB;
  getglobal BB;
  setglobal AA;
  return *
""")]
assert((a@(2) == 14) && (a@(3) == "a31") && (a@(4) == nil) && (_G.AA == "a31"))

set _G.AA, _G.BB = nil

;; testing arith
assert(T.testC("pushnum 10; pushnum 20; arith /; return 1") == 0.5)
assert(T.testC("pushnum 10; pushnum 20; arith -; return 1") == -10)
assert(T.testC("pushnum 10; pushnum -20; arith *; return 1") == -200)
assert(T.testC("pushnum 10; pushnum 3; arith ^; return 1") == 1000)
assert(T.testC("pushnum 10; pushstring 20; arith /; return 1") == 0.5)
assert(T.testC("pushstring 10; pushnum 20; arith -; return 1") == -10)
assert(T.testC("pushstring 10; pushstring -20; arith *; return 1") == -200)
assert(T.testC("pushstring 10; pushstring 3; arith ^; return 1") == 1000)
assert(T.testC("arith /; return 1", 2, 0) == (10.0 / 0))
set a = T.testC("pushnum 10; pushint 3; arith \\; return 1")
assert((a == 3.0) && (math.type(a) == "float"))
set a = T.testC("pushint 10; pushint 3; arith \\; return 1")
assert((a == 3) && (math.type(a) == "integer"))
set a = assert(T.testC("pushint 10; pushint 3; arith +; return 1"))
assert((a == 13) && (math.type(a) == "integer"))
set a = assert(T.testC("pushnum 10; pushint 3; arith +; return 1"))
assert((a == 13) && (math.type(a) == "float"))
set a, b, c = T.testC("""pushnum 1;
                  pushstring 10; arith _;
                  pushstring 5; return 3""")
assert((a == 1) && (b == -10) && (c == "5"))
val mt = [__add=func (a, b) {
  return(setmetatable([a@(1) + b@(1)], mt))
}, __mod=func (a, b) {
  return(setmetatable([a@(1) % b@(1)], mt))
}, __unm=func (a) {
  return(setmetatable([a@(1) * 2], mt))
}]
set a, b, c = (setmetatable([4], mt), setmetatable([8], mt), setmetatable([-3], mt))
var x, y, z = T.testC("arith +; return 2", 10, a, b)
assert((x == 10) && (y@(1) == 12) && (z == nil))
assert(T.testC("arith %; return 1", a, c)@(1) == (4 % -3))
assert(T.testC("arith _; arith +; arith %; return 1", b, a, c)@(1) == (8 % (4 + ((-3) * 2))))

;; errors in arithmetic
checkerr("divide by zero", T.testC, "arith \\", 10, 0)
checkerr("%%0", T.testC, "arith %", 10, 0)

;; testing lessthan and lessequal
assert(T.testC("compare LT 2 5, return 1", 3, 2, 2, 4, 2, 2))
assert(T.testC("compare LE 2 5, return 1", 3, 2, 2, 4, 2, 2))
assert(!T.testC("compare LT 3 4, return 1", 3, 2, 2, 4, 2, 2))
assert(T.testC("compare LE 3 4, return 1", 3, 2, 2, 4, 2, 2))
assert(T.testC("compare LT 5 2, return 1", 4, 2, 2, 3, 2, 2))
assert(!T.testC("compare LT 2 -3, return 1", "4", "2", "2", "3", "2", "2"))
assert(!T.testC("compare LT -3 2, return 1", "3", "2", "2", "4", "2", "2"))

;; non-valid indices produce false
assert(!T.testC("compare LT 1 4, return 1"))
assert(!T.testC("compare LE 9 1, return 1"))
assert(!T.testC("compare EQ 9 9, return 1"))

var b = [__lt=func (a, b) {
  return(a@(1) < b@(1))
}, __le=func (a, b) {
  return(a@(1) <= b@(1))
}]
val a1, a3, a4 = (setmetatable([1], b), setmetatable([3], b), setmetatable([4], b))
assert(T.testC("compare LT 2 5, return 1", a3, 2, 2, a4, 2, 2))
assert(T.testC("compare LE 2 5, return 1", a3, 2, 2, a4, 2, 2))
assert(T.testC("compare LT 5 -6, return 1", a4, 2, 2, a3, 2, 2))
set a, b = T.testC("compare LT 5 -6, return 2", a1, 2, 2, a3, 2, 20)
assert((a == 20) && (b == false))
set a, b = T.testC("compare LE 5 -6, return 2", a1, 2, 2, a3, 2, 20)
assert((a == 20) && (b == false))
set a, b = T.testC("compare LE 5 -6, return 2", a1, 2, 2, a1, 2, 20)
assert((a == 20) && (b == true))

do {  ;; testing lessthan and lessequal with metamethods
  val mt = [__lt=func (a, b) {
    return(a@(1) < b@(1))
  }, __le=func (a, b) {
    return(a@(1) <= b@(1))
  }, __eq=func (a, b) {
    return(a@(1) == b@(1))
  }]
  val func O (x) {
    return(setmetatable([x], mt))
  }

  val a, b = T.testC("compare LT 2 3; pushint 10; return 2", O(1), O(2))
  assert((a == true) && (b == 10))
  val a, b = T.testC("compare LE 2 3; pushint 10; return 2", O(3), O(2))
  assert((a == false) && (b == 10))
  val a, b = T.testC("compare EQ 2 3; pushint 10; return 2", O(3), O(3))
  assert((a == true) && (b == 10))
}

;; testing length
var t = setmetatable([x=20], [__len=func (t) {
  return(t.x)
}])
set a, b, c = T.testC("""   len 2;
   Llen 2;
   objsize 2;
   return 3
""", t)
assert((a == 20) && (b == 20) && (c == 0))

set t.x = "234"
set t@(1) = 20
set a, b, c = T.testC("""   len 2;
   Llen 2;
   objsize 2;
   return 3
""", t)
assert((a == "234") && (b == 234) && (c == 1))

set t.x = print
set t@(1) = 20
set a, c = T.testC("""   len 2;
   objsize 2;
   return 2
""", t)
assert((a == print) && (c == 1))

;; testing __concat

set a = setmetatable([x="u"], [__concat=func (a, b) {
  return(a.x ++ ('.' ++ b.x))
}])
set x, y = T.testC("""  pushnum 5
  pushvalue 2;
  pushvalue 2;
  concat 2;
  pushvalue -2;
  return 2;
""", a, a)
assert((x == (a ++ a)) && (y == 5))

;; concat with 0 elements
assert(T.testC("concat 0; return 1") == "")

;; concat with 1 element
assert(T.testC("concat 1; return 1", "xuxu") == "xuxu")

;; testing lua_is

var B
set B = func (x) {
  return((x && 1) || 0)
}

var count
set count = func (x, n) {
  set n = n || 2
  var prog = """    isnumber %d;
    isstring %d;
    isfunction %d;
    iscfunction %d;
    istable %d;
    isuserdata %d;
    isnil %d;
    isnull %d;
    return 8
  """

  set prog = string.format(prog, n, n, n, n, n, n, n, n)
  val a, b, c, d, e, f, g, h = T.testC(prog, x)
  return(B(a) + B(b) + B(c) + B(d) + B(e) + B(f) + B(g) + (100 * B(h)))
}

assert(count(3) == 2)
assert(count('alo') == 1)
assert(count('32') == 2)
assert(count([]) == 1)
assert(count(print) == 2)
assert(count(func () {}) == 1)
assert(count(nil) == 1)
assert(count(io.stdin) == 1)
assert(count(nil, 15) == 100)

;; testing lua_to...

val func to (s, x, n) {
  set n = n || 2
  return(T.testC(string.format("%s %d; return 1", s, n), x))
}

val null = T.pushuserdata(0)
val hfunc = string.gmatch("", "")  ;; a "heavy C function" (with upvalues)
assert(debug.getupvalue(hfunc, 1))
assert(to("tostring", []) == nil)
assert(to("tostring", "alo") == "alo")
assert(to("tostring", 12) == "12")
assert(to("tostring", 12, 3) == nil)
assert(to("objsize", []) == 0)
assert(to("objsize", [1, 2, 3]) == 3)
assert(to("objsize", "alo\0\0a") == 6)
assert(to("objsize", T.newuserdata(0)) == 0)
assert(to("objsize", T.newuserdata(101)) == 101)
assert(to("objsize", 124) == 0)
assert(to("objsize", true) == 0)
assert(to("tonumber", []) == 0)
assert(to("tonumber", "12") == 12)
assert(to("tonumber", "s2") == 0)
assert(to("tonumber", 1, 20) == 0)
assert(to("topointer", 10) == null)
assert(to("topointer", true) == null)
assert(to("topointer", nil) == null)
assert(to("topointer", "abc") != null)
assert(to("topointer", string.rep("x", 10)) == to("topointer", string.rep("x", 10)))  ;; short strings
do {  ;; long strings
  val s1 = string.rep("x", 300)
  val s2 = string.rep("x", 300)
  assert(to("topointer", s1) != to("topointer", s2))
}
assert(to("topointer", T.pushuserdata(20)) != null)
assert(to("topointer", io.read) != null)  ;; light C function
assert(to("topointer", hfunc) != null)  ;; "heavy" C function
assert(to("topointer", func () {}) != null)  ;; Lua function
assert(to("topointer", io.stdin) != null)  ;; full userdata
assert(to("func2num", 20) == 0)
assert(to("func2num", T.pushuserdata(10)) == 0)
assert(to("func2num", io.read) != 0)  ;; light C function
assert(to("func2num", hfunc) != 0)  ;; "heavy" C function (with upvalue)
set a = to("tocfunction", math.deg)
assert((a(3) == math.deg(3)) && (a == math.deg))

print("testing panic function")
do {
  ;; trivial error
  assert(T.checkpanic("pushstring hi; error") == "hi")

  ;; thread status inside panic (bug in 5.4.4)
  assert(T.checkpanic("pushstring hi; error", "threadstatus; return 2") == "ERRRUN")

  ;; using the stack inside panic
  assert(T.checkpanic("pushstring hi; error;", """checkstack 5 XX
      pushstring ' alo'
      pushstring ' mundo'
      concat 3""") == "hi alo mundo")

  ;; "argerror" without frames
  assert(T.checkpanic("loadstring 4 name bt") == "bad argument #4 (string expected, got no value)")

  ;; memory error + thread status
  val x = T.checkpanic(""" alloccount 0    # force a memory error in next line
       newtable
    """, """       alloccount -1   # allow free allocations again
       pushstring XX
       threadstatus
       concat 2     # to make sure message came from here
       return 1
    """)
  T.alloccount()
  assert(x == ("XX" ++ "not enough memory"))

  ;; stack error
  if !_soft {
    val msg = T.checkpanic("""      pushstring "function f() f() end"
      loadstring -1 name t; call 0 0
      getglobal f; call 0 0
    """)

    assert(string.find(msg, "stack overflow"))
  }

  ;; exit in panic still close to-be-closed variables
  assert(T.checkpanic("""    pushstring "return {__close = function () Y = 'ho'; end}"
    newtable
    loadstring -2 name t
    call 0 1
    setmetatable -2
    toclose -1
    pushstring "hi"
    error
  """, """    getglobal Y
    concat 2         # concat original error with global Y
  """) == "hiho")
}

;; testing deep C stack
if !_soft {
  print("testing stack overflow")
  collectgarbage("stop")
  checkerr("XXXX", T.testC, "checkstack 1000023 XXXX")  ;; too deep
  ;; too deep (with no message)
  checkerr("^stack overflow$", T.testC, "checkstack 1000023 ''")
  val s = string.rep("pushnil;checkstack 1 XX;", 1000000)
  checkerr("overflow", T.testC, s)
  collectgarbage("restart")
  print('+')
}

val lim = (_soft && 500) || 12000
var prog = ["checkstack " ++ (((lim * 2) + 100) ++ "msg"), "newtable"]
loop i in (1, lim) {
  set prog@(#prog + 1) = "pushnum " ++ i
  set prog@(#prog + 1) = "pushnum " ++ (i * 10)
}

set prog@(#prog + 1) = "rawgeti R !G"  ;; get global table in registry
set prog@(#prog + 1) = "insert " ++ -((2 * lim) + 2)

loop i in (1, lim) {
  set prog@(#prog + 1) = "settable " ++ -((2 * ((lim - i) + 1)) + 1)
}

set prog@(#prog + 1) = "return 2"

set prog = table.concat(prog, ";")
var g, t = T.testC(prog)
assert(g == _G)
loop i in (1, lim) {
  assert(t@(i) == (i * 10))
  set t@(i) = undef
}
assert(next(t) == nil)
set prog, g, t = nil

do {  ;; shrink stack
  var m1, m2 = (0, collectgarbage("count") * 1024)
  loop {  ;; repeat until stable
    while(m1 != m2)
    collectgarbage()
    set m1 = m2
    set m2 = collectgarbage("count") * 1024
  }
}

;; testing errors

set a = T.testC("""  loadstring 2 name t; pcall 0 1 0;
  pushvalue 3; insert -2; pcall 1 1 0;
  pcall 0 0 0;
  return 1
""", "XX=150", func (a) {

  assert(a == nil)
  return(3)
})

assert((type(a) == 'string') && (XX == 150))
set _G.XX = nil

val func check3 (p, ...) {
  val arg = [...]
  assert(#arg == 3)
  assert(string.find(arg@(3), p))
}
check3(":1:", T.testC("loadstring 2 name t; return *", "x="))
check3("%.", T.testC("loadfile 2; return *", "."))
check3("xxxx", T.testC("loadfile 2; return *", "xxxx"))

;; test errors in non protected threads
val func checkerrnopro (code, msg) {
  val th = coroutine.create(func () {})  ;; create new thread
  val stt, err = pcall(T.testC, th, code)  ;; run code there
  assert(!stt && string.find(err, msg))
}

do {
  print("testing load of binaries in fixed buffers")
  var source = []
  val N = 1000
  ;; create a somewhat "large" source
  loop i in (1, N) {
    set source@(i) = "set X = X + 1; "
  }
  ;; add a long string to the source
  set source@(#source + 1) = string.format("set Y = '%s'", string.rep("a", N))
  set source = table.concat(source)
  ;; give chunk an explicit name to avoid using source as name
  set source = load(source, "name1")
  ;; dump without debug information
  set source = string.dump(source, true)
  ;; each "X=X+1" generates 4 opcodes with 4 bytes each, plus the string
  assert(#source > ((N * 4 * 4) + N))
  collectgarbage()
  collectgarbage()
  val m1 = collectgarbage("count") * 1024
  ;; load dump using fixed buffer
  val code = T.testC("""    loadstring 2 name B;
    return 1
  """, source)
  collectgarbage()
  val m2 = collectgarbage("count") * 1024
  ;; load used fewer than 400 bytes. Code alone has more than 3*N bytes,
  ;; and string literal has N bytes. Both were not loaded.
  assert((m2 > m1) && ((m2 - m1) < 400))
  set X = 0
  code()
  assert((X == N) && (Y == string.rep("a", N)))
  set X = nil
  set Y = nil

  ;; testing debug info in fixed buffers
  set source = ["set X = 0"]
  loop i in (2, 300) {
    set source@(i) = "set X = X + 1"
  }
  set source@(#source + 1) = "set X = X + []"  ;; error in last line
  set source = table.concat(source, "\n")
  set source = load(source, "name1")
  set source = string.dump(source)
  ;; load dump using fixed buffer
  val code = T.testC("""    loadstring 2 name B;
    return 1
  """, source)
  checkerr(":301:", code)  ;; correct line information
}

if !_soft {
  collectgarbage("stop")  ;; avoid __gc with full stack
  checkerrnopro("pushnum 3; call 0 0", "attempt to call")
  print("testing stack overflow in unprotected thread")
  func F () {
    F()
  }
  checkerrnopro("getglobal 'F'; call 0 0;", "stack overflow")
  set F = nil
  collectgarbage("restart")
}
print("+")

;; testing table access

do {  ;; getp/setp
  val a = []
  val a1 = T.testC("rawsetp 2 1; return 1", a, 20)
  assert(a == a1)
  assert(a@(T.pushuserdata(1)) == 20)
  val a1, res = T.testC("rawgetp -1 1; return 2", a)
  assert((a == a1) && (res == 20))
}

do {  ;; using the table itself as index
  val a = []
  set a@(a) = 10
  val prog = "gettable -1; return *"
  val res = [T.testC(prog, a)]
  assert((#res == 2) && (res@(1) == prog) && (res@(2) == 10))

  val prog = "settable -2; return *"
  val res = [T.testC(prog, a, 20)]
  assert(a@(a) == 20)
  assert((#res == 1) && (res@(1) == prog))

  ;; raw
  set a@(a) = 10
  val prog = "rawget -1; return *"
  val res = [T.testC(prog, a)]
  assert((#res == 2) && (res@(1) == prog) && (res@(2) == 10))

  val prog = "rawset -2; return *"
  val res = [T.testC(prog, a, 20)]
  assert(a@(a) == 20)
  assert((#res == 1) && (res@(1) == prog))

  ;; using the table as the value to set
  val prog = "rawset -1; return *"
  val res = [T.testC(prog, 30, a)]
  assert(a@(30) == a)
  assert((#res == 1) && (res@(1) == prog))

  val prog = "settable -1; return *"
  val res = [T.testC(prog, 40, a)]
  assert(a@(40) == a)
  assert((#res == 1) && (res@(1) == prog))

  val prog = "rawseti -1 100; return *"
  val res = [T.testC(prog, a)]
  assert(a@(100) == a)
  assert((#res == 1) && (res@(1) == prog))

  val prog = "seti -1 200; return *"
  val res = [T.testC(prog, a)]
  assert(a@(200) == a)
  assert((#res == 1) && (res@(1) == prog))
}

set a = [x=0, y=12]
