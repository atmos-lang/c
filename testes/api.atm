;; testing multiple states
T.closestate(T.newstate())
set L1 = T.newstate()
assert(L1)

assert(T.doremote(L1, "X='a'; return 'a'") == 'a')

assert(#pack(T.doremote(L1, "function f () return 'alo', 3 end; f()")) == 0)

set a, b = T.doremote(L1, "return f()")
assert((a == 'alo') && (b == '3'))

T.doremote(L1, "_ERRORMESSAGE = nil")
;; error: `sin' is not defined
set a, b, c = T.doremote(L1, "return sin(1)")
assert((a == nil) && (c == 2))  ;; 2 == run-time error

;; error: syntax error
set a, b, c = T.doremote(L1, "a +")
assert((a == nil) && (c == 3) && (type(b) == "string"))  ;; 3 == syntax error

T.loadlib(L1, 2, -3)  ;; load only 'package', preload all others
set a, b, c = T.doremote(L1, """  set string = require('string')
  val initialG = _G   ;; not loaded yet
  var a = require('_G'); assert((a == _G) && (require("_G") == a))
  assert((initialG == nil) && (io == nil))   ;; now we have 'assert'
  set io = require('io'); assert(type(io.read) == "function")
  assert(require("io") == io)
  set a = require('table'); assert(type(a.insert) == "function")
  set a = require('debug'); assert(type(a.getlocal) == "function")
  set a = require('math'); assert(type(a.sin) == "function")
  string.sub('okinama', 1, 2)
""")
assert(a == "ok")

T.closestate(L1)

set L1 = T.newstate()
T.loadlib(L1, 0, 0)
T.doremote(L1, "set a = []")
T.testC(L1, """getglobal "a"; pushstring "x"; pushint 1;
             settable -3""")
assert(T.doremote(L1, "a.x") == "1")

T.closestate(L1)

set L1 = nil

