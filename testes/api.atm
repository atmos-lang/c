;; colect in cl the `val' of all collected userdata
var tt = []
var cl = [n=0]
set A = nil
set B = nil
var F
set F = func (x) {
  val udval = T.udataval(x)
  table.insert(cl, udval)
  var d = T.newuserdata(100)  ;; create garbage
  set d = nil
  assert(debug.getmetatable(x).__gc == F)
  assert(load("table.insert([], [])"))()  ;; create more garbage
  assert(!collectgarbage())  ;; GC during GC (no op)
  val dummy = []  ;; create more garbage during GC
  if A != nil {
    assert(type(A) == "userdata")
    assert(T.udataval(A) == B)
    debug.getmetatable(A)  ;; just access it
  }
  set A = x  ;; resurrect userdata
  set B = udval
  return(1, 2, 3)
}
set tt.__gc = F

;; test whether udate collection frees memory in the right time
do {
  collectgarbage()
  collectgarbage()
  var x = collectgarbage("count")
  var a = T.newuserdata(5001)
  assert(T.testC("objsize 2; return 1", a) == 5001)
  assert(collectgarbage("count") >= (x + 4))
  set a = nil
  collectgarbage()
  assert(collectgarbage("count") <= (x + 1))
  ;; udata without finalizer
  set x = collectgarbage("count")
  collectgarbage("stop")
  loop i in (1, 1000) {
    T.newuserdata(0)
  }
  assert(collectgarbage("count") > (x + 10))
  collectgarbage()
  assert(collectgarbage("count") <= (x + 1))
  ;; udata with finalizer
  collectgarbage()
  set x = collectgarbage("count")
  collectgarbage("stop")
  set a = [__gc=func () {}]
  loop i in (1, 1000) {
    debug.setmetatable(T.newuserdata(0), a)
  }
  assert(collectgarbage("count") >= (x + 10))
  collectgarbage()  ;; this collection only calls TM, without freeing memory
  assert(collectgarbage("count") >= (x + 10))
  collectgarbage()  ;; now frees memory
  assert(collectgarbage("count") <= (x + 1))
  collectgarbage("restart")
}

collectgarbage("stop")

