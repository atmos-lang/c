;;-----------------------------------------------------------------------
;; testing to-be-closed variables
;;-----------------------------------------------------------------------
print("testing to-be-closed variables")

do {
  val openresource = []

  val func newresource () {
    val x = setmetatable([10], [__close=func (y) {
      assert(openresource@(#openresource) == y)
      set openresource@(#openresource) = nil
      set y@(1) = y@(1) + 1
    }])
    set openresource@(#openresource + 1) = x
    return(x)
  }

  val a, b = T.testC("""    call 0 1   # create resource
    pushnil
    toclose -2  # mark call result to be closed
    toclose -1  # mark nil to be closed (will be ignored)
    return 2
  """, newresource)
  assert((a@(1) == 11) && (b == nil))
  assert(#openresource == 0)  ;; was closed

  ;; repeat the test, but calling function in a 'multret' context
  val a = [T.testC("""    call 0 1   # create resource
    toclose 2 # mark it to be closed
    return 2
  """, newresource)]
  assert((type(a@(1)) == "string") && (a@(2)@(1) == 11))
  assert(#openresource == 0)  ;; was closed

  ;; closing by error
  val a, b = pcall(T.makeCfunc("""    call 0 1   # create resource
    toclose -1 # mark it to be closed
    pushvalue -1  # replicate it as error object
    error       # resource right after error object
  """), newresource)
  assert((a == false) && (b@(1) == 11))
  assert(#openresource == 0)  ;; was closed

  ;; non-closable value
  val a, b = pcall(T.makeCfunc("""    newtable   # create non-closable object
    toclose -1 # mark it to be closed (should raise an error)
    abort  # will not be executed
  """))
  assert((a == false) && string.find(b, "non%-closable value"))

  val func check (n) {
    assert(#openresource == n)
  }

  ;; closing resources with 'closeslot'
  set _ENV.xxx = true
  val a = T.testC("""    pushvalue 2  # stack: S, NR, CH, NR
    call 0 1   # create resource; stack: S, NR, CH, R
    toclose -1 # mark it to be closed
    pushvalue 2  #  stack: S, NR, CH, R, NR
    call 0 1   # create another resource; stack: S, NR, CH, R, R
    toclose -1 # mark it to be closed
    pushvalue 3  # stack: S, NR, CH, R, R, CH
    pushint 2   # there should be two open resources
    call 1 0  #  stack: S, NR, CH, R, R
    closeslot -1   # close second resource
    pushvalue 3  # stack: S, NR, CH, R, R, CH
    pushint 1   # there should be one open resource
    call 1 0  # stack: S, NR, CH, R, R
    closeslot 4
    setglobal "xxx"  # previous op. erased the slot
    pop 1       # pop other resource from the stack
    pushint *
    return 1    # return stack size
  """, newresource, check)
  assert((a == 3) && (_ENV.xxx == nil))  ;; no extra items left in the stack

  ;; closing resources with 'pop'
  val a = T.testC("""    pushvalue 2  # stack: S, NR, CH, NR
    call 0 1   # create resource; stack: S, NR, CH, R
    toclose -1 # mark it to be closed
    pushvalue 2  #  stack: S, NR, CH, R, NR
    call 0 1   # create another resource; stack: S, NR, CH, R, R
    toclose -1 # mark it to be closed
    pushvalue 3  # stack: S, NR, CH, R, R, CH
    pushint 2   # there should be two open resources
    call 1 0  #  stack: S, NR, CH, R, R
    pop 1   # pop second resource
    pushvalue 3  # stack: S, NR, CH, R, CH
    pushint 1   # there should be one open resource
    call 1 0  # stack: S, NR, CH, R
    pop 1       # pop other resource from the stack
    pushvalue 3  # stack: S, NR, CH, CH
    pushint 0   # there should be no open resources
    call 1 0  # stack: S, NR, CH
    pushint *
    return 1    # return stack size
  """, newresource, check)
  assert(a == 3)  ;; no extra items left in the stack

  ;; non-closable value
  val a, b = pcall(T.makeCfunc("""    pushint 32
    toclose -1
  """))
  assert(!a && string.find(b, "(C temporary)"))
}

do {  ;; testing failing in 'lua_checkstack'
  var res = T.testC("""rawcheckstack 500000; return 1""")
  assert(res == false)
  val L = T.newstate()
  T.alloccount(0)  ;; will be unable to reallocate the stack
  set res = T.testC(L, """rawcheckstack 5000; return 1""")
  T.alloccount()
  T.closestate(L)
  assert(res == false)
}

do {  ;; closing state with no extra memory
  val L = T.newstate()
  T.alloccount(0)
  T.closestate(L)
  T.alloccount()
}

do {  ;; garbage collection with no extra memory
  val L = T.newstate()
  T.loadlib(L, 3, 0)  ;; load _G and 'package'
  val res = (T.doremote(L, """    set _ENV = _G
    assert(string == nil)
    var a = []
    loop i in (1, 1000) { set a@(i) = 'i' ++ i }    ;; grow string table
    val stsize, stuse = T.querystr()
    assert(stuse > 1000)
    var foo
    set foo = func (n) {
      if n > 0 { foo(n - 1) }
    }
    foo(180)    ;; grow stack
    val _, stksize = T.stacklevel()
    assert(stksize > 180)
    set a = nil
    T.alloccount(0)
    collectgarbage()
    T.alloccount()
    ;; stack and string table could not be reallocated,
    ;; so they kept their sizes (without errors)
    assert(select(2, T.stacklevel()) == stksize)
    assert(T.querystr() == stsize)
    'ok'
  """))
  assert(res == 'ok')
  T.closestate(L)
}

print('+')

;; testing some auxlib functions
val func gsub (a, b, c) {
  set a, b = T.testC("gsub 2 3 4; gettop; return 2", a, b, c)
  assert(b == 5)
  return(a)
}

assert(gsub("alo.alo.uhuh.", ".", "//") == "alo//alo//uhuh//")
assert(gsub("alo.alo.uhuh.", "alo", "//") == "//.//.uhuh.")
assert(gsub("", "alo", "//") == "")
assert(gsub("...", ".", "/.") == "/././.")
assert(gsub("...", "...", "") == "")

;; testing luaL_newmetatable
var mt_xuxu, res, top = T.testC("newmetatable xuxu; gettop; return 3")
assert((type(mt_xuxu) == "table") && res && (top == 3))
var d, res, top = T.testC("newmetatable xuxu; gettop; return 3")
assert((mt_xuxu == d) && !res && (top == 3))
set d, res, top = T.testC("newmetatable xuxu1; gettop; return 3")
assert((mt_xuxu != d) && res && (top == 3))

set x = T.newuserdata(0)
set y = T.newuserdata(0)
T.testC("pushstring xuxu; gettable R; setmetatable 2", x)
assert(getmetatable(x) == mt_xuxu)

;; testing luaL_testudata
;; correct metatable
var res1, res2, top = T.testC("""testudata -1 xuxu
   	 			  testudata 2 xuxu
				  gettop
				  return 3""", x)
assert(res1 && res2 && (top == 4))

;; wrong metatable
set res1, res2, top = T.testC("""testudata -1 xuxu1
			    testudata 2 xuxu1
			    gettop
			    return 3""", x)
assert(!res1 && !res2 && (top == 4))

;; non-existent type
set res1, res2, top = T.testC("""testudata -1 xuxu2
			    testudata 2 xuxu2
			    gettop
			    return 3""", x)
assert(!res1 && !res2 && (top == 4))

;; userdata has no metatable
set res1, res2, top = T.testC("""testudata -1 xuxu
			    testudata 2 xuxu
			    gettop
			    return 3""", y)
assert(!res1 && !res2 && (top == 4))

;; erase metatables
do {
  val r = debug.getregistry()
  assert((r.xuxu == mt_xuxu) && (r.xuxu1 == d))
  set r.xuxu = nil
  set r.xuxu1 = nil
}

print('OK')
