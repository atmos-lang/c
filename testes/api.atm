;; testing upvalues

do {
  val A = T.testC(""" pushnum 10; pushnum 20; pushcclosure 2; return 1""")
  set t, b, c = A("""pushvalue U0; pushvalue U1; pushvalue U2; return 3""")
  assert((b == 10) && (c == 20) && (type(t) == 'table'))
  set a, b = A("""tostring U3; tonumber U4; return 2""")
  assert((a == nil) && (b == 0))
  A("""pushnum 100; pushnum 200; replace U2; replace U1""")
  set b, c = A("""pushvalue U1; pushvalue U2; return 2""")
  assert((b == 100) && (c == 200))
  A("""replace U2; replace U1""", [x=1], [x=2])
  set b, c = A("""pushvalue U1; pushvalue U2; return 2""")
  assert((b.x == 1) && (c.x == 2))
  T.checkmemory()
}

