;; Test references in an arbitrary table
val reftable = []
var d = T.ref(a, reftable)
val e = T.ref(b, reftable)
val f = T.ref(c, reftable)
set t = [T.getref(d, reftable), T.getref(e, reftable), T.getref(f, reftable)]
assert((t@(1) == a) && (t@(2) == b) && (t@(3) == c))

set t = nil
set a = nil
set c = nil
T.unref(e, reftable)
T.unref(f, reftable)

collectgarbage()

;; check that unref objects have been collected
