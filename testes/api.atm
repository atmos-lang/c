;; testing lua_equal with fallbacks
do {
  val map = []
  val t = [__eq=func (a, b) {
    return(map@(a) == map@(b))
  }]
  val func f (x) {
    val u = T.newuserdata(0)
    debug.setmetatable(u, t)
    set map@(u) = x
    return(u)
  }
  assert(f(10) == f(10))
  assert(f(10) != f(11))
  assert(T.testC("compare EQ 2 3; return 1", f(10), f(10)))
  assert(!T.testC("compare EQ 2 3; return 1", f(10), f(20)))
  set t.__eq = nil
  assert(f(10) != f(10))
}

